PINS = [  # header, gpio, net, job
    ("D0", 1, "BCLK", "amp BCLK"), ("D1", 2, "LRC", "amp LRC"), ("D2", 3, "DIN", "amp DIN"),
    ("D3", 4, "AMP_SD", "amp SD, R1 4.7 kΩ to GND"),
    ("D4", 5, "SDA", "OLED SDA and AHT20 SDA"), ("D5", 6, "SCL", "OLED SCL and AHT20 SCL"),
    ("D6", 43, "", "spare (UART0 TX, leave free)"), ("D7", 44, "BTN", "action button to GND, internal pull-up"),
    ("D8 / D9 / D10", "7 / 8 / 9", "", "spare; the SD slot's SPI, leave free"),
    ("3V3", "", "3V3", "OLED VCC, AHT20 VIN"), ("BAT+ pad", "", "BAT+", "from the switch; also the amp VIN and the 220 µF"),
    ("BAT- pad", "", "GND", "the holder's - lead, the star point"),
]

CUTS = [  # piece, stock, length, how
    ("Equator ring", "1.5 mm rod", "220 mm", "Bend around a 66 mm can, lap-join the ends 8 mm, file flush. Mark left, right, front and back."),
    ("Side ring", "1.5 mm rod", "220 mm", "Same size. It crosses the equator at left and right and runs over the top and under the bottom, so the front stays open."),
    ("Base ring", "1.5 mm rod", "138 mm", "22 mm radius, around a 42 mm jar. It sits at y = -27 touching the side ring at its two low points; the sphere stands on it and the cell holder rests in it."),
    ("Front posts x2", "1.0 mm rod", "50 mm each", "From the base ring up to y = 28 at x = +-13.5, 18 mm in front of the centre, with a 14 mm tie to the equator. The OLED's and the XIAO's header pins solder to them."),
    ("AHT20 hangers x2", "1.0 mm rod", "5 mm each", "From the top of the side ring down to the sensor's two outer pads."),
]

TESTS = [  # (step, what, pass)
    ("1 · XIAO alone", "USB-C to the laptop. Flash Seeed's CameraWebServer example (XIAO ESP32S3 Sense board, PSRAM on). Join its Wi-Fi page.",
     "Live video in the browser. Camera, Wi-Fi, PSRAM and the USB port proven."),
    ("2 · Microphone", "Flash Seeed's PDM record example; speak at the board.", "A waveform that follows your voice in the serial plotter."),
    ("3 · OLED", "Breadboard: OLED VCC-3V3, GND-GND, SDA-D4, SCL-D5. I2C scan, then a text sketch.",
     "Scan shows 0x3C; text on the glass."),
    ("4 · AHT20 on the same bus", "Add the AHT20's VIN/GND/SDA/SCL pads to the same four lines. Scan, then read.",
     "Scan shows 0x38 and 0x3C; room temperature; humidity jumps when you breathe on it."),
    ("5 · Amp + speaker", "Amp VIN-3V3 (bench only), GND, BCLK-D0, LRC-D1, DIN-D2, SD-D3 with R1 to GND; speaker on OUT+/OUT-. Play a 440 Hz tone at volume 65.",
     "A clean tone; silence while SD is low. Nothing else wired to the speaker."),
    ("6 · Button", "D7 to GND through the button; internal pull-up in the sketch.", "A press prints once, no bounce after a 30 ms debounce."),
    ("7 · Cell", "Meter the holder: + lead to the button top, 3.6-4.2 V. Switch in the + lead, then to the XIAO BAT+ pad; - lead to BAT-. Unplug USB.",
     "Boots from the cell. Meter in series: 110-250 mA awake, under 5 mA in deep sleep. Then plug USB in with the switch OFF: it still boots, nothing warm."),
    ("8 · All together on the breadboard", "Everything from 1-7 at once for an hour, camera streaming.", "No brownout, no reboot, XIAO warm not hot. Only now bend brass."),
]

BUILD = [
    "Bench-test every part first (the eight steps). Nothing goes into brass untested.",
    "Bend the three 1.5 mm rings and lap-join each. Check the two big ones on a 70 mm circle drawn with a compass.",
    "Solder the side ring into the equator at left and right (the two crossings), then the base ring to the bottom of the side ring. Harris acid flux, then baking soda, then IPA, as on the first frame. Five joints in all.",
    "Set it on the table: it must stand still. Put the cell holder in the base ring and check it self-rights.",
    "Solder the two front posts, base ring to equator. Try the OLED and the XIAO against them with Kapton on their backs; nothing is wired yet.",
    "Tape and tie: holder into the base ring (two zip ties), speaker taped under it, amp taped to its back, switch and button hot-glued to the equator at the back and right, AHT20 on its two hangers.",
    "Wire from the back forward: cell holder leads to the switch and the star; BAT+ to the amp and the XIAO pad; then the bare-rod I2C and I2S runs; then the button. Meter frame-to-every-net before the cell goes in.",
    "First power-up on USB with the switch OFF, then on the cell. Run the test-8 sketch again inside the sphere.",
]

MASS = [("Cell + holder", 23), ("XIAO ESP32-S3 Sense", 8), ("OLED", 5), ("Speaker", 3.5), ("Amp + 220 µF", 3),
        ("AHT20", 1.5), ("Switch + button", 4), ("1.5 mm rod, 3 rings, 580 mm", 8.7), ("1.0 mm rod, posts and hangers", 0.8)]

# ------------------------------------------------------------------ writers
def tbl(headers, rows, cls=""):
    h = "".join(f"<th>{c}</th>" for c in headers)
    b = "".join("<tr>" + "".join(f"<td>{c}</td>" for c in r) + "</tr>" for r in rows)
    return f'<div class="tw"><table class="{cls}"><tr>{h}</tr>{b}</table></div>'

def write_html(views):
    link = lambda text, url: f'<a href="{html.escape(url)}">{html.escape(text)}</a>'
    parts_rows = []
    for qty, part, where, url, status, why in PARTS:
        badge = {"TO BUY": '<span class="badge buy">to buy</span>', "owned": '<span class="badge own">owned</span>',
                 "optional": '<span class="badge opt">optional</span>'}[status]
        parts_rows.append((qty, f"{html.escape(part)}<br>{badge}", link(where, url), html.escape(why)))
    total = sum(m for _, m in MASS)
    css = open(os.path.join(HERE, "style.css")).read()
    page = f'''<title>Pocket AI Sphere</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap">
<style>{css}</style>
<div class="wrap">
<div class="masthead">
  <div class="eyebrow">Pocket AI &middot; third build &middot; concept 2026-10-29</div>
  <h1>A Pocket AI in a brass sphere</h1>
  <div class="sub">Same assistant as the first Pocket AI, plus a camera and a weather sensor, in three brass rings. Paper only: nothing bought, bent, soldered or flashed. Source: <code>pocket_ai_sphere/docs/DESIGN.md</code>, drawn by <code>docs/pages/gen/sphere.py</code>.</div>
</div>

<p>Three rings and two posts. An equator and a side ring of 1.5&nbsp;mm brass rod cross at left and right, so the front and back are open; a smaller base ring under them is what it stands on and what the cell holder rests in. Two thin posts at the front carry the screen and the XIAO. That is the whole frame: five solder joints. Inside, the heavy cell lies low as ballast so it self-rights, the lens looks out over the eyes through the open front, the sensor hangs from the top of the side ring in moving air, and the speaker is taped under the holder firing down through the base ring. Everything else is tape, ties and the parts' own pins.</p>

<figure>{views["hero"]}
<figcaption>Brass is the frame, boxes are parts. The face sits in the open front between the two posts, the cell is the floor. Rods at the back are drawn paler.</figcaption></figure>

<div class="grid3">
<figure>{views["front"]}</figure>
<figure>{views["side"]}</figure>
<figure>{views["top"]}</figure>
</div>

<div class="kpis">
<div><b>70 mm</b><span>diameter; a tennis ball is 67</span></div>
<div><b>{total:.0f} g</b><span>estimated, cell in</span></div>
<div><b>3 rings</b><span>plus two posts; five solder joints</span></div>
<div><b>0 to buy</b><span>every part is owned</span></div>
</div>

<h2>Why these numbers</h2>
<ul>
<li><strong>70 mm</strong> is the smallest sphere that takes a 27 mm screen and a 21 mm XIAO stacked on one flat plate 18 mm forward of the centre, with the 43 mm cell holder lying across the bottom. At 60 mm the holder's corners hit the rings.</li>
<li><strong>One 300 mm rod per ring.</strong> A 70 mm circle is 220 mm around, so each big ring is one rod with an 80 mm offcut and no splice in view; the base ring is a third rod.</li>
<li><strong>The side ring, not a front one,</strong> is the trick. A ring that runs left-over-top-right-under-bottom never crosses the face or the camera, and the equator passes behind the screen's top edge. So the front is clear glass with nothing in front of it.</li>
<li><strong>Two posts do all the mounting.</strong> The OLED's four header pins and the XIAO's outer header pins solder to the posts, which is how the camera tower mounts its head too. No plate, no cradles.</li>
<li><strong>Cell at y = −20</strong> puts a third of the mass 20 mm below the centre, sitting in the 44 mm base ring; that is what brings it back upright when you press the button.</li>
<li><strong>Sensor at the top, screen heat at the front.</strong> The AHT20 reads air, not the XIAO, because it sits 20 mm behind and above the stack with open rods around it. Expect it to read 1–2 °C high after an hour of streaming; the firmware subtracts a measured offset.</li>
</ul>

<h2>Parts</h2>
<p>Everything but the controller is already in the drawers. Owned quantities come from the two inventories; the XIAO link is the listing bought twice before.</p>
{tbl(["Qty", "Part", "Where", "Why, and what to check"], parts_rows, "parts")}

<h2>Pin map</h2>
<p>The camera tower's map with the motor pins freed and the AHT20 added to the I2C bus. The firmware plan is shared with that build.</p>
{tbl(["Header", "GPIO", "Net", "Job"], [(h, str(g), f"<code>{n}</code>" if n else "", j) for h, g, n, j in PINS])}
<div class="note warn"><span class="lbl">Carried over, unchanged</span>
<ul>
<li>The cell is the only source. Nothing into the XIAO's <code>5V</code> pin; only the holder on the BAT pads.</li>
<li>Amp off until firmware raises SD; volume cap 65; GAIN open.</li>
<li>Neither speaker lead is ground. No GND wire, no scope ground.</li>
<li>The brass is not a conductor: meter frame-to-every-net before the cell goes in, and after every solder session.</li>
<li>Never solder to the cell; never charge it below 0 °C; watch the first charge.</li>
</ul></div>

<h2>Frame cut list</h2>
{tbl(["Piece", "Stock", "Length", "How"], CUTS)}
<div class="note tip"><span class="lbl">Bending a true ring</span>
<p>Wrap the 1.5 mm rod one full turn around a 66 mm can (a 12 oz drink can); it springs back to about 70 mm. Overlap the ends 8 mm side by side, solder the lap, file it round, and put the joint where the base ring will cover it. Check against a 70 mm circle drawn with a compass. The base ring wraps around a 42 mm jar.</p></div>

<h2>Test every part before any brass</h2>
<p>Eight breadboard steps, each with a pass line. They use Seeed's own examples, so no firmware has to exist yet. Do them in order; each adds one part to the last.</p>
{tbl(["Step", "Do", "Pass when"], TESTS, "tests")}

<h2>Build order</h2>
<ol>{"".join(f"<li>{html.escape(s)}</li>" for s in BUILD)}</ol>

<h2>Mass and run time</h2>
{tbl(["Part", "g"], [(p, f"{m:g}") for p, m in MASS] + [("<strong>Total</strong>", f"<strong>{total:.0f}</strong>")])}
<p>About 250 mA from the cell with the camera streaming and the assistant talking, so roughly 3.5 h on the 950 mAh NL169; about 7 h idle on Wi-Fi; days asleep. Same budget as the camera tower, minus the motor.</p>

<h2>What could go wrong</h2>
<ul>
<li><strong>Two rings meeting at a right angle</strong> is the only fiddly joint: hold the side ring upright in the equator with two clothes pegs on a cardboard disc, tack one crossing, check square, tack the other.</li>
<li><strong>Wi-Fi.</strong> Three rods with 35 mm gaps are no cage at 2.4 GHz; just point the XIAO's antenna end at the open front, not at the equator.</li>
<li><strong>The posts carry everything in front.</strong> Solder the OLED pins to them at two points each and the XIAO at two; one point each and the face will twist.</li>
<li><strong>It rolls.</strong> Knocked off its base ring, a sphere rolls; the low cell brings it back upright. Test the self-righting with the cell in before wiring.</li>
</ul>
<hr>
</div>
'''
    open(os.path.join(PAGES, "sphere.html"), "w").write(page)

def write_md(views_written):
    def md_tbl(headers, rows):
        out = ["| " + " | ".join(headers) + " |", "| " + " | ".join("---" for _ in headers) + " |"]
        for r in rows: out.append("| " + " | ".join(str(c).replace("|", "\\|") for c in r) + " |")
        return "\n".join(out)
    total = sum(m for _, m in MASS)
    parts_rows = [(q, p, f"[{w}]({u})", s, why) for q, p, w, u, s, why in PARTS]
    md = f'''# Pocket AI Sphere: design record

**Concept, 2026-10-29. Paper only: nothing bought, bent, soldered or flashed.**
Generated by `pages/gen/sphere.py`; edit the script, not this file. The drawings are on the
published page (`pages/sphere.html`, see `ARTIFACTS.md`).

## What it is

The third Pocket AI: the same assistant as the first build (screen, microphone, amplifier and
speaker, one button, Wi-Fi to the local server), plus the camera of the second build and a
weather sensor, in a 70 mm sphere of three brass rings instead of a box or a tower.

Three rings of 1.5 mm K&S #9862 rod: an equator and a side ring (left, over the top, right, under
the bottom) crossing at left and right so the front stays open, and a 44 mm base ring at
y = −27 that the sphere stands on and the cell holder rests in. Two 1.0 mm posts at the front
(x = ±13.5, z = 18) carry the OLED and the XIAO by their header pins. Five frame joints.
Inside: the two posts at z = 18 carry the OLED (y −18..9) below the XIAO ESP32-S3 Sense
(y 10..28, landscape, camera on its outer face); the NL169 cell lies across the bottom in its
holder resting in the base ring at y = −20 as ballast; the speaker is taped under it at y = −30 firing down through the base ring; the amplifier is taped
to the holder's back (z = −10); the AHT20 hangs flat from the top of the side ring (y = 30) in open
air; the toggle switch is glued to the back of the equator with its lever out; the action button
to the right of the equator.

Coordinates: origin at the centre, x right, y up, z toward the face. Radius 35.

## Why these numbers

- 70 mm is the smallest sphere that takes the 27 mm screen and the 21 mm XIAO on one plate
  18 mm forward of the centre with the 43 mm holder across the bottom; at 60 mm the holder's
  corners hit the rings.
- One 300 mm rod per big ring (220 mm around, 80 mm offcut); the base ring is a third rod.
- A side ring instead of a front one never crosses the face or the lens; the front is clear.
- Two posts do all the mounting: the OLED's and the XIAO's header pins solder to them.
- Cell at y = −20 in the 44 mm base ring puts a third of the mass low; it self-rights.
- The AHT20 sits 20 mm behind and above the XIAO with open rods around it; expect 1–2 °C of
  self-heating offset after an hour of streaming, subtracted in firmware.

## Parts

{md_tbl(["Qty", "Part", "Where", "Status", "Why, and what to check"], parts_rows)}

## Pin map

{md_tbl(["Header", "GPIO", "Net", "Job"], [(h, g, f"`{n}`" if n else "", j) for h, g, n, j in PINS])}

Carried over unchanged from the first two builds: the cell is the only source and nothing feeds
the `5V` pin; the amp is off until firmware raises SD, cap 65, GAIN open; neither speaker lead
is ground; the brass is not a conductor (meter frame-to-every-net before the cell goes in);
never solder to or cold-charge the cell.

## Frame cut list

{md_tbl(["Piece", "Stock", "Length", "How"], CUTS)}

Bending: one turn of 1.5 mm rod around a 66 mm drink can (springs back to about 70 mm), lap the
ends 8 mm, solder, file round, hide the joint under the base ring. Base ring around a 42 mm jar.

## Test every part before any brass

{md_tbl(["Step", "Do", "Pass when"], TESTS)}

## Build order

{chr(10).join(f"{i+1}. {s}" for i, s in enumerate(BUILD))}

## Mass and run time

{md_tbl(["Part", "g"], [(p, f"{m:g}") for p, m in MASS] + [("**Total**", f"**{total:.0f}**")])}

About 250 mA with the camera streaming and the assistant talking: roughly 3.5 h on the NL169;
about 7 h idle on Wi-Fi.

## Risks

- The two big rings meet at a right angle at left and right: peg the side ring upright on a
  cardboard disc, tack one crossing, check square, tack the other.
- Wi-Fi: three rods with 35 mm gaps are no cage at 2.4 GHz; point the antenna at the open front.
- Solder each board to the posts at two points, or the face twists.
- A sphere rolls when knocked off its ring; the low cell brings it back. Test self-righting with
  the cell in before wiring.
'''
    open(os.path.join(DOCS, "DESIGN.md"), "w").write(md)

if __name__ == "__main__":
    views = make_views()
    write_html(views)
    write_md(True)
    print("wrote", os.path.join(PAGES, "sphere.html"), "and", os.path.join(DOCS, "DESIGN.md"))
