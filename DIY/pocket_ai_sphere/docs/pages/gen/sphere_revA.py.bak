#!/usr/bin/env python3
"""Pocket AI Sphere: geometry, parts, pins and tests in one place.

Writes docs/pages/sphere.html (the published page) and docs/DESIGN.md (the record).
Coordinates in mm: x right, y up, z toward the viewer (the face). Origin at the
sphere's centre. Run from anywhere: python3 docs/pages/gen/sphere.py
"""
import math, os, re, html

HERE = os.path.dirname(os.path.abspath(__file__))
PAGES = os.path.dirname(HERE)
DOCS = os.path.dirname(PAGES)

R = 35.0            # sphere radius: 70 mm, a tennis ball is 67
LAT = 22.0          # latitude rings at y = +-22
LAT_R = math.sqrt(R*R - LAT*LAT)      # 27.2
BASE_R = 22.0; BASE_Y = -math.sqrt(R*R-BASE_R*BASE_R)   # -27.2: the sphere stands on this ring, the holder rests in it
PLATE_Z = 18.0; PLATE_X = 13.5; PLATE_Y0, PLATE_Y1 = -18.0, 28.0
FREQ = 2            # geodesic frequency: 2 = the Las Vegas look (120 struts), 1 = a plain icosahedron (30)

def geodesic(freq=FREQ, radius=R):
    """Class-I icosahedral geodesic: returns (vertices, edges) on a sphere, one triangular face
    at the bottom (so it stands on three hubs) and the matching face at the top."""
    phi = (1+5**0.5)/2
    V = []
    for a in (-1, 1):
        for b in (-phi, phi):
            V += [(0, a, b), (a, b, 0), (b, 0, a)]
    V = [tuple(x/ (1+phi*phi)**0.5 for x in v) for v in V]
    # faces: triples of mutually adjacent vertices (edge length 2/sqrt(1+phi^2))
    import itertools
    d_edge = 2/(1+phi*phi)**0.5
    def dist(a, b): return math.sqrt(sum((x-y)**2 for x, y in zip(a, b)))
    faces = [f for f in itertools.combinations(range(12), 3)
             if all(abs(dist(V[i], V[j])-d_edge) < 1e-6 for i, j in itertools.combinations(f, 2))]
    pts = {}; edges = set()
    def key(p): return tuple(round(x, 6) for x in p)
    def add(p):
        k = key(p)
        if k not in pts: pts[k] = len(pts)
        return pts[k]
    def nrm(p):
        l = math.sqrt(sum(x*x for x in p)); return tuple(x/l for x in p)
    for f in faces:
        A, B, C = (V[i] for i in f)
        # subdivide the face into freq^2 triangles
        grid = {}
        for i in range(freq+1):
            for j in range(freq+1-i):
                k = freq-i-j
                p = nrm(tuple((i*A[t]+j*B[t]+k*C[t])/freq for t in range(3)))
                grid[(i, j)] = add(p)
        for i in range(freq):
            for j in range(freq-i):
                a, b, c = grid[(i, j)], grid[(i+1, j)], grid[(i, j+1)]
                for e in ((a, b), (b, c), (c, a)): edges.add(tuple(sorted(e)))
                if j < freq-i-1:
                    d = grid[(i+1, j+1)]
                    for e in ((b, d), (d, c)): edges.add(tuple(sorted(e)))
    verts = [None]*len(pts)
    for k, i in pts.items(): verts[i] = k
    # orient: the centroid of face 0 points straight down
    A, B, C = (V[i] for i in faces[0])
    n = nrm(tuple(A[t]+B[t]+C[t] for t in range(3)))
    # rotation taking n to (0,-1,0): axis = n x target
    tgt = (0, -1, 0); ax = cross(n, tgt); sa = math.sqrt(sum(x*x for x in ax)); ca = dot(n, tgt)
    def rot(p):
        if sa < 1e-9: return p if ca > 0 else (p[0], -p[1], p[2])
        k = tuple(x/sa for x in ax)
        kp = cross(k, p); kd = dot(k, p)
        return tuple(p[t]*ca + kp[t]*sa + k[t]*kd*(1-ca) for t in range(3))
    verts = [tuple(radius*x for x in rot(v)) for v in verts]
    # yaw so that a hub sits at the front equator-ish: rotate so the vertex nearest to +z at y~0 faces front
    best = max(verts, key=lambda v: v[2] - abs(v[1]))
    yaw = math.atan2(best[0], best[2])
    cy, sy = math.cos(-yaw), math.sin(-yaw)
    verts = [(v[0]*cy + v[2]*sy, v[1], -v[0]*sy + v[2]*cy) for v in verts]
    return verts, sorted(edges)

def strut_lengths():
    ls = {}
    for a, b in GEO_E:
        l = round(math.dist(GEO_V[a], GEO_V[b]), 1); ls[l] = ls.get(l, 0)+1
    return sorted(ls.items())

# ------------------------------------------------------------------ projection
def norm(v):
    l = math.sqrt(sum(a*a for a in v)); return tuple(a/l for a in v)
def cross(a, b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])
def dot(a, b): return sum(x*y for x, y in zip(a, b))
GEO_V, GEO_E = geodesic()

class View:
    def __init__(self, az, el, S, W, H, ox=None, oy=None):
        az, el = math.radians(az), math.radians(el)
        self.c = (math.sin(az)*math.cos(el), math.sin(el), math.cos(az)*math.cos(el))
        up = (0, 1, 0) if abs(el) < math.radians(80) else (0, 0, -1)
        self.r = norm(cross(up, self.c)); self.u = norm(cross(self.c, self.r))
        self.S, self.W, self.H = S, W, H
        self.ox = W/2 if ox is None else ox; self.oy = H/2 if oy is None else oy
        self.light = norm((-0.35, 0.6, 0.72))
        self.els = []
    def P(self, p): return (self.ox + self.S*dot(p, self.r), self.oy - self.S*dot(p, self.u))
    def depth(self, p): return dot(p, self.c)
    def add(self, d, s): self.els.append((d, s))
    @staticmethod
    def fmt(pts): return " ".join(f"{x:.1f},{y:.1f}" for x, y in pts)

    def seg(self, a, b, w, col, dfade=True, dlift=0.0):
        pa, pb = self.P(a), self.P(b); d = (self.depth(a)+self.depth(b))/2
        k = 1.0
        if dfade:
            k = 0.55 + 0.45*(d + R)/(2*R)        # back rods thinner and paler
        op = 0.45 + 0.55*k if dfade else 1
        self.add(d+dlift, f'<line x1="{pa[0]:.1f}" y1="{pa[1]:.1f}" x2="{pb[0]:.1f}" y2="{pb[1]:.1f}" '
                 f'stroke="{col}" stroke-width="{w*k:.2f}" stroke-opacity="{op:.2f}" stroke-linecap="round"/>')
    def polyline3(self, pts, w, col, closed=True, dlift=0.0):
        n = len(pts)
        for i in range(n if closed else n-1):
            self.seg(pts[i], pts[(i+1) % n], w, col, dlift=dlift)
    def shade(self, nrm, base):
        k = 0.6 + 0.4*max(0.0, dot(norm(nrm), self.light))
        return f'fill="{base}" style="filter:brightness({k:.2f})"'
    def box(self, x0, x1, y0, y1, z0, z1, base="var(--paper)", stroke="var(--ink)", w=1.1, dlift=0.0, op=1.0):
        faces = [((0, 0, 1), [(x0, y0, z1), (x1, y0, z1), (x1, y1, z1), (x0, y1, z1)]),
                 ((0, 0, -1), [(x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0)]),
                 ((1, 0, 0), [(x1, y0, z0), (x1, y1, z0), (x1, y1, z1), (x1, y0, z1)]),
                 ((-1, 0, 0), [(x0, y0, z0), (x0, y1, z0), (x0, y1, z1), (x0, y0, z1)]),
                 ((0, 1, 0), [(x0, y1, z0), (x1, y1, z0), (x1, y1, z1), (x0, y1, z1)]),
                 ((0, -1, 0), [(x0, y0, z0), (x1, y0, z0), (x1, y0, z1), (x0, y0, z1)])]
        cen = ((x0+x1)/2, (y0+y1)/2, (z0+z1)/2)
        g = []
        for nrm, pts in faces:
            if dot(nrm, self.c) > 1e-6:
                g.append(f'<polygon points="{self.fmt([self.P(p) for p in pts])}" {self.shade(nrm, base)} '
                         f'fill-opacity="{op}" stroke="{stroke}" stroke-width="{w}" stroke-linejoin="round"/>')
        if not g:   # edge-on: draw the outline
            pts = faces[0][1]
            g.append(f'<polygon points="{self.fmt([self.P(p) for p in pts])}" fill="none" stroke="{stroke}" stroke-width="{w}"/>')
        self.add(self.depth(cen)+dlift, "".join(g))
    def flat(self, pts3, fill, stroke="none", w=0, dlift=0.0, op=1.0):
        cen = tuple(sum(p[i] for p in pts3)/len(pts3) for i in range(3))
        self.add(self.depth(cen)+dlift, f'<polygon points="{self.fmt([self.P(p) for p in pts3])}" fill="{fill}" '
                 f'fill-opacity="{op}" stroke="{stroke}" stroke-width="{w}" stroke-linejoin="round"/>')
    @staticmethod
    def hull(pts):
        pts = sorted(set(pts))
        if len(pts) < 3: return pts
        def cr(o, a, b): return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
        lo = []
        for p in pts:
            while len(lo) >= 2 and cr(lo[-2], lo[-1], p) <= 0: lo.pop()
            lo.append(p)
        up = []
        for p in reversed(pts):
            while len(up) >= 2 and cr(up[-2], up[-1], p) <= 0: up.pop()
            up.append(p)
        return lo[:-1]+up[:-1]
    def cylinder(self, c0, c1, radius, base, stroke, n=28, dlift=0.0):
        """cylinder from centre c0 to centre c1"""
        axis = norm(tuple(c1[i]-c0[i] for i in range(3)))
        a = (0, 1, 0) if abs(axis[1]) < 0.9 else (1, 0, 0)
        e1 = norm(cross(axis, a)); e2 = cross(axis, e1)
        def ring(c): return [tuple(c[i] + radius*(math.cos(t)*e1[i] + math.sin(t)*e2[i]) for i in range(3))
                             for t in [2*math.pi*k/n for k in range(n)]]
        b, t = ring(c0), ring(c1)
        pb = [self.P(p) for p in b]; pt = [self.P(p) for p in t]
        h = self.hull([(round(x, 2), round(y, 2)) for x, y in pb+pt])
        cen = tuple((c0[i]+c1[i])/2 for i in range(3))
        cap = pt if dot(axis, self.c) > 0 else pb
        self.add(self.depth(cen)+dlift, f'<polygon points="{self.fmt(h)}" fill="{base}" stroke="{stroke}" stroke-width="1.1" stroke-linejoin="round"/>'
                 f'<polygon points="{self.fmt(cap)}" fill="{base}" style="filter:brightness(1.08)" stroke="{stroke}" stroke-width="1.1"/>')

    def render(self, caption, labels=(), aria=""):
        self.els.sort(key=lambda e: e[0])
        out = [f'<svg viewBox="0 0 {self.W} {self.H}" role="img" aria-label="{html.escape(aria or caption)}">']
        out.append(f'<text x="18" y="24" font-size="13.5" font-weight="700" fill="var(--ink)">{html.escape(caption)}</text>')
        for d, s in self.els: out.append(s)
        # border labels with leaders
        for side in ("left", "right"):
            items = sorted([(self.P(p3)[1], p3, t) for sd, p3, t in labels
                            if (self.P(p3)[0] < self.ox) == (side == "left")])
            n = len(items)
            if not n: continue
            top, bot = 70, self.H-30
            step = (bot-top)/max(1, n-1)
            for i, (py, p3, t) in enumerate(items):
                x, y = self.P(p3); ys = top + i*step if n > 1 else (top+bot)/2
                xs = 232 if side == "left" else self.W-232
                xe = 242 if side == "left" else self.W-242
                out.append(f'<path d="M{x:.1f},{y:.1f} L{xe:.1f},{ys:.1f} L{xs:.1f},{ys:.1f}" fill="none" stroke="var(--ink-2)" stroke-width="0.9"/>'
                           f'<circle cx="{x:.1f}" cy="{y:.1f}" r="2.3" fill="var(--ink-2)"/>')
                anchor = "end" if side == "left" else "start"
                tx = xs-5 if side == "left" else xs+5
                out.append(f'<text x="{tx}" y="{ys+4:.1f}" font-size="12" text-anchor="{anchor}" fill="var(--ink)">{html.escape(t)}</text>')
        out.append('</svg>')
        return "\n".join(out)

# ------------------------------------------------------------------ the model
ROD = "var(--brass)"; THIN = "var(--brass)"
def circle_pts(center, radius, e1, e2, n=72):
    return [tuple(center[i] + radius*(math.cos(t)*e1[i] + math.sin(t)*e2[i]) for i in range(3))
            for t in [2*math.pi*k/n for k in range(n)]]
S2 = math.sqrt(0.5)

def build(v, wiring_hint=False):
    # silhouette for context
    sil = [v.P(p) for p in circle_pts((0, 0, 0), R, v.r, v.u, 90)]
    v.add(-99, f'<polygon points="{v.fmt(sil)}" fill="var(--paper)" stroke="var(--line)" stroke-width="1" stroke-dasharray="3 4"/>')
    sh = [v.P(p) for p in circle_pts((0, -35.5, 0), 26, (1, 0, 0), (0, 0, 1), 48)]
    v.add(-98, f'<polygon points="{v.fmt(sh)}" fill="var(--ink)" fill-opacity="0.08"/>')
    # three rings of 1.5 mm rod: equator, side meridian (over the top, left to right), base ring
    v.polyline3(circle_pts((0, 0, 0), R, (1, 0, 0), (0, 0, 1)), 3.2, ROD)         # equator
    v.polyline3(circle_pts((0, 0, 0), R, (1, 0, 0), (0, 1, 0)), 3.2, ROD)         # side meridian, plane z = 0
    v.polyline3(circle_pts((0, BASE_Y, 0), BASE_R, (1, 0, 0), (0, 0, 1)), 3.2, ROD)  # base ring
    # two 1.0 mm posts, base ring to equator, at the front: the screen and the XIAO hang on these
    zb = math.sqrt(BASE_R**2 - PLATE_X**2)     # 17.4: where the base ring passes x = +-13.5
    ze = math.sqrt(R**2 - PLATE_X**2)          # 32.3: where the equator passes x = +-13.5
    for x in (-PLATE_X, PLATE_X):
        v.seg((x, BASE_Y, zb), (x, PLATE_Y1, PLATE_Z), 2.0, THIN)
        v.seg((x, 0, PLATE_Z), (x, 0, ze), 2.0, THIN)   # short tie to the equator
    # OLED module 27 x 27 x 4, glass toward the viewer
    v.box(-13.5, 13.5, -18, 9, 14, 18, base="var(--signal-soft)", stroke="var(--signal)")
    v.flat([(-12, -13, 18.05), (12, -13, 18.05), (12, 2, 18.05), (-12, 2, 18.05)], "#101216", dlift=1.0)
    for ex in (-5.5, 5.5):   # eyes
        v.flat([(ex-3.2, -9.5, 18.1), (ex+3.2, -9.5, 18.1), (ex+3.2, -1.5, 18.1), (ex-3.2, -1.5, 18.1)], "#F4F4F0", dlift=4.0)
    # XIAO ESP32-S3 Sense, landscape, camera on its outer face
    v.box(-10.5, 10.5, 10, 28, 9, 18, base="var(--ok-soft)", stroke="var(--ok)")
    v.box(-4, 4, 15, 23, 18, 20.5, base="#2A2D33", stroke="#101216", dlift=0.03)     # camera module
    v.cylinder((0, 19, 20.5), (0, 19, 22), 2.2, "var(--ink-2)", "var(--ink)", dlift=0.05)  # lens
    v.box(10.5, 12.5, 15, 19, 11, 16, base="var(--ink-2)", stroke="var(--ink)", dlift=0.03) # USB-C on the right
    # cell holder tray and the NL169 cell lying left-right, low: the ballast
    v.box(-21.5, 21.5, -27, -24.5, -7, 7, base="var(--paper)", stroke="var(--ink-2)")
    for x in (-21.5, 19.5):
        v.box(x, x+2, -27, -13, -7, 7, base="var(--paper)", stroke="var(--ink-2)")
    v.cylinder((-17, -20, 0), (17, -20, 0), 8.3, "#C9CCD1", "#5A6068")
    # speaker taped under the holder, firing down through the base ring
    v.box(-10, 10, -32, -27.1, -6.5, 6.5, base="var(--paper)", stroke="var(--ink)")
    for x in (-6, -2, 2, 6):
        v.seg((x, -32.1, -5), (x, -32.1, 5), 0.8, "var(--ink-2)", dfade=False, dlift=0.02)
    # amplifier standing at the back
    v.box(-9, 9, -26, -8, -11, -8, base="var(--ok-soft)", stroke="var(--ok)")
    v.cylinder((14, -24, -10), (14, -16, -10), 4, "var(--ink-2)", "var(--ink)")              # 220 uF
    # AHT20 flat at the top, behind the XIAO, under the pole where the meridians cross
    v.box(-12.7, 12.7, 29, 31, -9, 8.8, base="var(--ok-soft)", stroke="var(--ok)")
    for x in (-10, 10):   # its two outer header pads solder to the meridian above it
        v.seg((x, 31, 0), (x, math.sqrt(R*R-x*x), 0), 1.6, THIN)
    # toggle switch at the back of the equator, lever out through the cage
    v.box(-4, 4, -5, 5, -34, -27, base="var(--ink-2)", stroke="var(--ink)")
    v.cylinder((0, 0, -34), (0, 3, -42), 1.2, "var(--ink-2)", "var(--ink)")
    # action button on the right of the equator
    v.box(28, 33, -3, 3, -3, 3, base="var(--paper)", stroke="var(--ink)")
    v.cylinder((33, 0, 0), (36.5, 0, 0), 1.7, "var(--ink-2)", "var(--ink)")

def make_views():
    out = {}
    v = View(14, 16, 5.2, 960, 640)
    build(v)
    out["hero"] = v.render("The sphere from the front right. 70 mm across; 5.2 px per mm.",
        labels=[("", (-13.5, -4, 18), "0.96\" OLED, the face"),
                ("", (0, 19, 22), "camera lens, over the eyes"),
                ("", (19, -20, 0), "NL169 cell, low, in the base ring"),
                ("", (-10, -29, 6), "speaker taped under the holder"),
                ("", (-BASE_R, BASE_Y, 0), "base ring, 44 mm: it stands on this"),
                ("", (-12.7, 30, 0), "AHT20 hung from the side ring"),
                ("", (12.5, 17, 13), "USB-C on the right"),
                ("", (36.5, 0, 0), "action button"),
                ("", (0, 3, -40), "power toggle, back"),
                ("", (R*0.7, 0, R*0.7), "equator, 1.5 mm rod"),
                ("", (0, R, 0), "side ring, 1.5 mm rod"),
                ("", (PLATE_X, -8, PLATE_Z), "two 1.0 mm posts carry the face"),
                ("", (9, -12, -9), "amp on the holder's back")],
        aria="Three-quarter view of the three-ring brass sphere with the OLED face, camera, cell, speaker, amp, sensor, switch and button in place")
    v = View(0, 0, 4.2, 440, 400); build(v)
    out["front"] = v.render("From the front: the face in the open window.")
    v = View(90, 0, 4.2, 440, 400); build(v)
    out["side"] = v.render("From the right: front to back, screen, cell, amp.")
    v = View(0, 89, 4.2, 440, 400); build(v)
    out["top"] = v.render("From above: the side ring over the sensor.")
    return out

# ------------------------------------------------------------------ the data
INV = "../../pocket_ai_assistant/docs/INVENTORY.md"
CINV = "../../cyber_clock_v2/docs/INVENTORY.md"
PARTS = [  # (qty, part, link text, url, status, why)
    ("1", "Seeed XIAO ESP32-S3 Sense", "owned x3, Amazon B0C69FFVHH", "https://www.amazon.com/dp/B0C69FFVHH", "owned",
