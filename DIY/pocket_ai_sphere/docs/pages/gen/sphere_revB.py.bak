# ------------------------------------------------------------------ the wiring sheet
SW, SH = 1360, 940

def esc(t): return str(t).replace("&", "&amp;").replace("<", "&lt;")
def T(x, y, s, cls="s", anchor="start", extra=""):
    return f'<text x="{x:.1f}" y="{y:.1f}" class="{cls}" text-anchor="{anchor}" {extra}>{esc(s)}</text>'
def dot(x, y, r=6): return f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{r}" class="joint"/>'

class Router:
    """Orthogonal polylines; a segment hops (semicircle) over every earlier segment of a different net it crosses.
    Same-net crossings are joints and get no hop. Draw rails and the busiest lanes first. Copied from the camera
    Pocket AI's wiring_board.py so this project stands on its own."""
    R = 8
    def __init__(self):
        self.segs = []; self.pins = []
    def pin(self, x, y, net): self.pins.append((x, y, net))
    def wire(self, pts, cls="rod", net=None):
        path = f"M{pts[0][0]:.1f},{pts[0][1]:.1f}"
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            horiz, vert = abs(y0 - y1) < 0.01, abs(x0 - x1) < 0.01
            hops = []
            if horiz:
                lo, hi = min(x0, x1), max(x0, x1)
                for (a0, b0, a1, b1, n) in self.segs:
                    if n == net or abs(a0 - a1) > 0.01: continue
                    if lo + self.R < a0 < hi - self.R and min(b0, b1) + 0.5 < y0 < max(b0, b1) - 0.5: hops.append(a0)
                sgn = 1 if x1 > x0 else -1
                for rx in sorted(set(hops), reverse=(sgn < 0)):
                    path += f" L{rx - self.R * sgn:.1f},{y0:.1f} A{self.R},{self.R} 0 0 {1 if sgn > 0 else 0} {rx + self.R * sgn:.1f},{y0:.1f}"
            elif vert:
                lo, hi = min(y0, y1), max(y0, y1)
                for (a0, b0, a1, b1, n) in self.segs:
                    if n == net or abs(b0 - b1) > 0.01: continue
                    if lo + self.R < b0 < hi - self.R and min(a0, a1) + 0.5 < x0 < max(a0, a1) - 0.5: hops.append(b0)
                sgn = 1 if y1 > y0 else -1
                for ry in sorted(set(hops), reverse=(sgn < 0)):
                    path += f" L{x0:.1f},{ry - self.R * sgn:.1f} A{self.R},{self.R} 0 0 {0 if sgn > 0 else 1} {x0:.1f},{ry + self.R * sgn:.1f}"
            path += f" L{x1:.1f},{y1:.1f}"
            self.segs.append((x0, y0, x1, y1, net))
        return f'<path d="{path}" class="{cls}"/>'
    def check(self, min_pin=14, min_lane=14):
        bad = []
        for (x0, y0, x1, y1, n) in self.segs:
            for (px, py, pn) in self.pins:
                if pn == n: continue
                if abs(x0 - x1) < 0.01 and min(y0, y1) - 2 <= py <= max(y0, y1) + 2 and abs(px - x0) < min_pin:
                    bad.append(f"vertical {n} at x={x0} passes {abs(px-x0):.0f}px from pin ({px},{py}) of {pn}")
                if abs(y0 - y1) < 0.01 and min(x0, x1) - 2 <= px <= max(x0, x1) + 2 and abs(py - y0) < min_pin:
                    bad.append(f"horizontal {n} at y={y0} passes {abs(py-y0):.0f}px from pin ({px},{py}) of {pn}")
        crossings = 0
        for i, (x0, y0, x1, y1, n) in enumerate(self.segs):
            for (a0, b0, a1, b1, m) in self.segs[:i]:
                if m == n: continue
                v1, v2 = abs(x0 - x1) < 0.01, abs(a0 - a1) < 0.01
                if v1 and v2 and abs(x0 - a0) < min_lane and min(y0, y1) < max(b0, b1) and max(y0, y1) > min(b0, b1):
                    bad.append(f"verticals {n} x={x0} and {m} x={a0} run {abs(x0-a0):.0f}px apart")
                if (not v1) and (not v2) and abs(y0 - b0) < min_lane and min(x0, x1) < max(a0, a1) and max(x0, x1) > min(a0, a1):
                    bad.append(f"horizontals {n} y={y0} and {m} y={b0} run {abs(y0-b0):.0f}px apart")
                if v1 != v2:
                    vx, vy0, vy1, hx0, hx1, hy = (x0, y0, y1, a0, a1, b0) if v1 else (a0, b0, b1, x0, x1, y0)
                    if min(hx0, hx1) + 0.5 < vx < max(hx0, hx1) - 0.5 and min(vy0, vy1) + 0.5 < hy < max(vy0, vy1) - 0.5:
                        crossings += 1
        return bad, crossings

def block(x, y, w, h, title, sub=None, cls="part", sub2=None, ty=24):
    o = [f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="9" class="{cls}"/>', T(x + w / 2, y + ty, title, "title", "middle")]
    if sub: o.append(T(x + w / 2, y + ty + 18, sub, "sub", "middle"))
    if sub2: o.append(T(x + w / 2, y + ty + 34, sub2, "sub", "middle"))
    return "".join(o)

def pin(rt, x, y, name, side, net, fn=None, fnx=None):
    rt.pin(x, y, net)
    o = [f'<circle cx="{x}" cy="{y}" r="4.5" class="pinend"/>']
    if side == "R":
        o.append(T(x - 10, y + 5, name, "pin", "end"))
        if fn: o.append(T(fnx, y + 5, fn, "fn", "end"))
    elif side == "L":
        o.append(T(x + 10, y + 5, name, "pin", "start"))
        if fn: o.append(T(fnx, y + 5, fn, "fn", "start"))
    elif side == "B":
        o.append(T(x, y - 8, name, "pin", "start", f'transform="rotate(-90 {x} {y - 8})"'))
    elif side == "T":
        o.append(T(x, y + 8, name, "pin", "end", f'transform="rotate(-90 {x} {y + 8})"'))
    return "".join(o)

def gnd(x, y):
    return f'<path d="M{x},{y} L{x},{y+12} M{x-11},{y+12} L{x+11},{y+12} M{x-7},{y+17} L{x+7},{y+17} M{x-3},{y+22} L{x+3},{y+22}" class="thin"/>'

def zigzag(rt, x, y0, y1, net):
    mid = (y0 + y1) / 2; z = 9
    pts = [(x, y0), (x, mid - 16)]
    for i, dx in enumerate((z, -z, z, -z, z, -z)):
        pts.append((x + dx, mid - 16 + (i + 0.5) * (32 / 6)))
    pts += [(x, mid + 16), (x, y1)]
    return rt.wire(pts, "thin", net)

def capacitor(rt, x, y0, y1, net):
    mid = (y0 + y1) / 2
    return "".join([rt.wire([(x, y0), (x, mid - 5)], "thin", net), rt.wire([(x, mid + 5), (x, y1)], "thin", "GND"),
                    f'<line x1="{x-12}" y1="{mid-5}" x2="{x+12}" y2="{mid-5}" class="thin"/>',
                    f'<line x1="{x-12}" y1="{mid+5}" x2="{x+12}" y2="{mid+5}" class="thin"/>'])

SHEET_CSS = ("<style>"
             ".part{fill:var(--paper);stroke:var(--ink);stroke-width:1.6}"
             ".usb{fill:var(--line);stroke:var(--ink-2);stroke-width:1.2}"
             ".title{font:700 17px 'Archivo','Helvetica Neue',Arial,sans-serif;fill:var(--ink)}"
             ".sub{font:400 12px 'Public Sans',system-ui,sans-serif;fill:var(--ink-2)}"
             ".h1{font:900 24px 'Archivo','Helvetica Neue',Arial,sans-serif;fill:var(--ink)}"
             ".h2{font:700 15px 'Archivo','Helvetica Neue',Arial,sans-serif;fill:var(--ink)}"
             ".pin{font:700 13px 'JetBrains Mono',monospace;fill:var(--ink)}"
             ".fn{font:400 11.5px 'Public Sans',system-ui,sans-serif;fill:var(--ink-2)}"
             ".lab{font:700 12.5px 'Public Sans',system-ui,sans-serif;fill:var(--ink)}"
             ".mono{font:400 11.5px 'JetBrains Mono',monospace;fill:var(--ink)}"
             ".brass{font:700 12px 'JetBrains Mono',monospace;fill:var(--brass);letter-spacing:.08em}"
             ".rod{fill:none;stroke:var(--ink);stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}"
             ".bus{fill:none;stroke:var(--brass);stroke-width:5;stroke-linecap:round;stroke-linejoin:round}"
             ".thin{fill:none;stroke:var(--ink);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
             ".joint{fill:var(--ink)}"
             ".pinend{fill:var(--paper);stroke:var(--ink);stroke-width:1.8}"
             "</style>")

def wiring_sheet():
    rt = Router(); w = rt.wire
    o = [T(20, 30, "Pocket AI Sphere: every connection on one sheet", "h1"),
         T(20, 48, "A dot is a joint. A line that hops over another does not touch it. Thick = wire you solder (26 AWG for BAT+ and GND, 30 AWG for the rest, all white).", "sub"),
         T(20, 64, "Thin = a resistor or capacitor leg, or a lead that comes with the part. Ground symbols are one net: the holder's − lead is the star. Nothing is soldered to brass.", "sub")]

    # ---------------------------------------------------------------- XIAO, centre
    XX, XY, XW, XH = 560, 140, 300, 500
    o.append(block(XX, XY, XW, XH, "XIAO ESP32-S3 Sense", "black · camera GPIO10-18, 38-40, 47, 48 · PDM mic GPIO41/42", sub2="all inside the Sense board · SD slot stays empty", ty=290))
    Lp = {}
    for name, y, fn, net in (("3V3", 190, "3.3 V out, 700 mA", "3V3"), ("GND", 220, "signal ground", "GND"), ("D4", 250, "GPIO5 · SDA", "SDA"), ("D5", 280, "GPIO6 · SCL", "SCL"),
                             ("D0", 540, "GPIO1 · BCLK", "BCLK"), ("D1", 570, "GPIO2 · LRC", "LRC"), ("D2", 600, "GPIO3 · DIN", "DIN"), ("D3", 630, "GPIO4 · amp SD", "AMP_SD")):
        Lp[name] = (XX, y); o.append(pin(rt, XX, y, name, "L", net, fn, XX + 50))
    Rp = {}
    for name, y, fn, net in (("D7", 190, "GPIO44 · button", "BTN"), ("GND", 220, "button return", "GND")):
        Rp[name] = (XX + XW, y); o.append(pin(rt, XX + XW, y, name, "R", net, fn, XX + XW - 50))
    for i, line in enumerate(("D6 = GPIO43: spare, leave free (UART TX)", "D8-D10 = GPIO7-9: spare, the SD slot's SPI",
                              "5V pin: USB only · nothing connects here", "BAT pads: on the back, at the USB end")):
        o.append(T(XX + XW - 12, 318 + i * 17, line, "fn", "end"))
    Bp = {}
    for name, x, net in (("BAT+", 760, "BAT+"), ("BAT−", 830, "GND")):
        Bp[name] = (x, XY + XH); o.append(pin(rt, x, XY + XH, name, "B", net))
    o.append(f'<rect x="{XX+XW-52}" y="{XY+8}" width="38" height="15" rx="3" class="usb"/>'); o.append(T(XX + XW - 33, XY + 19, "USB-C", "fn", "middle"))
    o.append(T(XX + XW - 58, XY + 19, "flash · console · charges the cell at 100 mA", "fn", "end"))

    # ---------------------------------------------------------------- button, right
    o.append(block(1000, 160, 170, 80, "Action button", "white cap · to GND", ty=32))
    o.append(pin(rt, 1000, 190, "", "L", "BTN")); o.append(pin(rt, 1000, 220, "", "L", "GND"))
    o.append(w([Rp["D7"], (1000, 190)], "rod", "BTN")); o.append(w([Rp["GND"], (1000, 220)], "rod", "GND"))
    o.append(T(930, 182, "BTN", "lab", "middle")); o.append(T(930, 212, "GND", "lab", "middle"))

    # ---------------------------------------------------------------- the four I2C lanes to the left, the OLED and the AHT20 under them
    lane_end = {"3V3": 110, "GND": 150, "SDA": 200, "SCL": 240}
    o.append(w([Lp["3V3"], (80, 190)], "rod", "3V3"))
    o.append(w([Lp["GND"], (150, 220)], "rod", "GND"))
    o.append(w([Lp["D4"], (200, 250)], "rod", "SDA"))
    o.append(w([Lp["D5"], (240, 280)], "rod", "SCL"))
    for yy, lab in ((190, "3V3"), (220, "GND"), (250, "SDA"), (280, "SCL")):
        o.append(T(520, yy - 7, lab, "lab", "middle"))
    OX, OY, OW, OH = 60, 340, 220, 130
    o.append(block(OX, OY, OW, OH, "0.96\" OLED", "SSD1306 · I2C 0x3C · 3.3 V", sub2="read the silkscreen order first", ty=52))
    for x, name, net in ((110, "VCC", "3V3"), (150, "GND", "GND"), (200, "SDA", "SDA"), (240, "SCL", "SCL")):
        o.append(pin(rt, x, OY, name, "T", net)); o.append(w([(x, OY), (x, {"3V3": 190, "GND": 220, "SDA": 250, "SCL": 280}[net])], "rod", net))
        if x != lane_end[net] or net == "3V3": o.append(dot(x, {"3V3": 190, "GND": 220, "SDA": 250, "SCL": 280}[net]))
    o.append(capacitor(rt, 80, 190, 300, "3V3")); o.append(gnd(80, 300)); o.append(T(96, 252, "10 µF +", "fn")); o.append(T(96, 266, "100 nF", "fn"))
    AX, AY, AW, AH = 310, 340, 200, 130
    o.append(block(AX, AY, AW, AH, "AHT20", "black · I2C 0x38 · 2.7-5.5 V", sub2="on two hooks at the top", ty=52))
    for x, name, net in ((340, "VIN", "3V3"), (380, "GND", "GND"), (430, "SDA", "SDA"), (480, "SCL", "SCL")):
        o.append(pin(rt, x, AY, name, "T", net)); o.append(w([(x, AY), (x, {"3V3": 190, "GND": 220, "SDA": 250, "SCL": 280}[net])], "rod", net))
        o.append(dot(x, {"3V3": 190, "GND": 220, "SDA": 250, "SCL": 280}[net]))

    # ---------------------------------------------------------------- amp and speaker, bottom left
    MX, MY, MW, MH = 100, 480, 240, 200
    o.append(block(MX, MY, MW, MH, "MAX98357A amp", "blue · hidden behind the screen", ty=20))
    o.append(T(MX + 12, MY + MH - 14, "GAIN open = 9 dB", "fn")); o.append(T(MX + 12, MY + MH - 28, "2.5-5.5 V in", "fn"))
    Ap = {}
    for name, y, net in (("BCLK", 540, "BCLK"), ("LRC", 570, "LRC"), ("DIN", 600, "DIN"), ("SD", 630, "AMP_SD")):
        Ap[name] = (MX + MW, y); o.append(pin(rt, MX + MW, y, name, "R", net))
    for name, y, net in (("OUT+", 560, "SPK+"), ("OUT−", 600, "SPK-")):
        Ap[name] = (MX, y); o.append(pin(rt, MX, y, name, "L", net))
    for name, x, net in (("GND", 230, "GND"), ("VIN", 300, "BAT+")):
        Ap[name] = (x, MY + MH); o.append(pin(rt, x, MY + MH, name, "B", net))
    for a, b, net in (("D0", "BCLK", "BCLK"), ("D1", "LRC", "LRC"), ("D2", "DIN", "DIN"), ("D3", "SD", "AMP_SD")):
        o.append(w([Lp[a], Ap[b]], "rod", net)); o.append(T(450, Lp[a][1] - 7, b, "lab", "middle"))
    o.append(zigzag(rt, 400, 630, 690, "AMP_SD")); o.append(dot(400, 630)); o.append(gnd(400, 690)); o.append(T(414, 664, "R1 4.7 kΩ", "fn"))
    o.append(block(8, 520, 72, 100, "Speaker", "8 Ω · black", ty=36))
    rt.pin(80, 560, "SPK+"); rt.pin(80, 600, "SPK-")
    o += [f'<circle cx="80" cy="560" r="4.5" class="pinend"/>', f'<circle cx="80" cy="600" r="4.5" class="pinend"/>']
    o.append(w([(80, 560), Ap["OUT+"]], "thin", "SPK+")); o.append(w([(80, 600), Ap["OUT−"]], "thin", "SPK-"))
    o.append(T(44, 636, "own leads", "fn", "middle"))

    # ---------------------------------------------------------------- the power chain along the bottom
    RY = 740
    o.append(w([(300, RY), (900, RY)], "bus", "BAT+")); o.append(dot(300, RY))
    o.append(T(600, RY - 10, "BAT+ rail · 3.0-4.2 V from the cell · 26 AWG white", "brass", "middle"))
    o.append(w([Ap["VIN"], (300, RY)], "rod", "BAT+"))
    o.append(w([Ap["GND"], (230, 720)], "rod", "GND")); o.append(gnd(230, 720))
    o.append(capacitor(rt, 360, RY, 800, "BAT+")); o.append(dot(360, RY)); o.append(gnd(360, 800)); o.append(T(376, 776, "220 µF", "fn"))
    o.append(w([Bp["BAT+"], (760, RY)], "rod", "BAT+")); o.append(dot(760, RY))
    o.append(w([Bp["BAT−"], (830, 680)], "rod", "GND")); o.append(gnd(830, 680))
    o.append(block(440, 780, 170, 90, "16340 cell", "NL169 · 950 mAh · in the tray", ty=26))
    rt.pin(480, 780, "BAT+"); rt.pin(610, 850, "GND")
    o += [f'<circle cx="480" cy="780" r="4.5" class="pinend"/>', T(492, 772, "+ red", "pin", "start"),
          f'<circle cx="610" cy="850" r="4.5" class="pinend"/>', T(598, 855, "− black", "pin", "end")]
    o.append(w([(610, 850), (650, 850)], "rod", "GND")); o.append(gnd(650, 850)); o.append(T(650, 888, "the star", "fn", "middle"))
    o.append(block(690, 780, 190, 90, "Toggle", "MTS-102 · middle lug in, outer lug out", sub2="lever forward = on · charge with it ON", ty=30))
    rt.pin(730, 780, "BAT+"); rt.pin(840, 780, "BAT+")
    o += [f'<circle cx="730" cy="780" r="4.5" class="pinend"/>', T(742, 772, "in", "pin", "start"),
          f'<circle cx="840" cy="780" r="4.5" class="pinend"/>', T(852, 772, "out", "pin", "start")]
    o.append(w([(480, 780), (480, 760), (730, 760), (730, 780)], "rod", "BAT+"))
    o.append(w([(840, 780), (840, RY)], "rod", "BAT+")); o.append(dot(840, RY))

    # ---------------------------------------------------------------- the numbers, right
    NX, NY = 940, 300
    o.append(T(NX, NY, "The power chain", "h2"))
    for i, line in enumerate(("cell → toggle → BAT+ rail → XIAO BAT+ pad and amp VIN", "the XIAO's regulator makes 3.3 V for itself, the camera,", "the screen and the sensor; the amp runs on the cell itself",
                              "returns: amp and XIAO to the holder's − lead (the star);", "screen, sensor, button, R1 to the XIAO's GND pin", "USB-C in, toggle ON: the XIAO's charger fills the cell")):
        o.append(T(NX, NY + 22 + i * 16, line, "fn"))
    o.append(T(NX, NY + 136, "From the 950 mAh cell", "h2"))
    for i, (mode, ma, note, _long) in enumerate(POWER):
        yy = NY + 158 + i * 34
        o.append(T(NX, yy, mode, "lab")); o.append(T(NX, yy + 15, f"{ma} mA · {note}", "fn"))
    o.append(T(NX, NY + 350, "Never", "h2"))
    for i, line in enumerate(("the 5V pin · a wire to brass · a scope ground on the speaker", "the cell soldered, or charged below 0 °C")):
        o.append(T(NX, NY + 372 + i * 16, line, "fn"))
    o.append(T(NX, NY + 420, "Meter before the cell goes in", "h2"))
    for i, line in enumerate(("every ring and post against BAT+, GND, 3V3: open", "holder red lead to the button top: 3.6-4.2 V", "amp SD to GND: 4.7 kΩ · BAT+ to GND: open, not a short")):
        o.append(T(NX, NY + 442 + i * 16, line, "fn"))

    bad, crossings = rt.check()
    for b in bad: print("CLEARANCE:", b)
    assert not bad, f"{len(bad)} clearance failures"
    o.append(T(20, SH - 24, f"{REV}, {REV_DATE}, approved as drawn {APPROVED}: the sphere's first wiring sheet. {len(rt.segs)} segments, {crossings} crossings, each drawn as a hop; the clearance check passes.", "sub"))
    o.append(T(20, SH - 8, "Pins and powers from the Seeed XIAO ESP32S3 wiki, the Adafruit AHT20 and MAX98357A pages, the Same Sky and Nitecore sheets. Not built.", "sub"))
    return f'<svg viewBox="0 0 {SW} {SH}" role="img" aria-label="Pocket AI Sphere wiring sheet">{SHEET_CSS}{"".join(o)}</svg>', crossings

# ------------------------------------------------------------------ writers
def tbl(headers, rows, cls=""):
    h = "".join(f"<th>{c}</th>" for c in headers)
    b = "".join("<tr>" + "".join(f"<td>{c}</td>" for c in r) + "</tr>" for r in rows)
    return f'<div class="tw"><table class="{cls}"><tr>{h}</tr>{b}</table></div>'

def md_inline(t):
    import re
    t = html.escape(t, quote=False)
    t = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", t)
    return t

def write_html(views, sheet, crossings):
    link = lambda text, url: f'<a href="{html.escape(url)}">{html.escape(text)}</a>'
    parts_rows = []
    for qty, part, where, url, status, colour, why in PARTS:
        badge = {"TO BUY": '<span class="badge buy">to buy</span>', "owned": '<span class="badge own">owned</span>',
                 "optional": '<span class="badge opt">optional</span>', "in the mail": '<span class="badge opt">in the mail</span>'}[status]
        parts_rows.append((qty, f"{html.escape(part)}<br>{badge}", link(where, url), html.escape(colour), html.escape(why)))
    total = sum(m for _, m in MASS)
    css = open(os.path.join(HERE, "style.css")).read()
    page = f'''<title>Pocket AI Sphere</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap">
<style>{css}</style>
<div class="wrap">
<div class="masthead">
  <div class="eyebrow">Pocket AI &middot; third build &middot; {REV}, approved as drawn {APPROVED}</div>
  <h1>A Pocket AI in a brass sphere</h1>
  <div class="sub">Same assistant as the first Pocket AI, plus a camera and a weather sensor, in three brass rings. Step one of the build rule, approved as drawn on {APPROVED}; step two, the physics, is the companion page. Nothing bent, soldered or flashed; one board in the mail. Source: <code>pocket_ai_sphere/docs/DESIGN.md</code>, drawn by <code>docs/pages/gen/sphere.py</code>.</div>
</div>

<p>Three rings and two posts. An equator and a side ring of 1.5&nbsp;mm brass rod cross at left and right, so the front and back are open; a 44 mm base ring under them is what it stands on and what the cell tray rests on. Two thin posts rise from the base ring through the screen's mounting holes and carry the XIAO above it. That is the whole frame: five joints, two ties, two hooks. The screen sits below the equator and the camera above it, so the equator reads as a brow. The heavy cell lies on the floor as ballast with the speaker lying on it, firing up; the sensor hangs from the top in moving air. The two blue parts, the amplifier and the toggle's body, stand in the gap behind the screen where nothing sees them; the chrome lever, a white button cap and one white wire bundle are the only things that are not brass or black.</p>

<figure>{views["hero"]}
<figcaption>Every part in the colour it is sold in: brass rods, black boards, black glass with white pixels, the chrome lever and the white cap. The two blue parts sit behind the screen. Rods at the back are drawn paler.</figcaption></figure>

<div class="grid3">
<figure>{views["front"]}</figure>
<figure>{views["side"]}</figure>
<figure>{views["back"]}</figure>
</div>

<div class="kpis">
<div><b>70 mm</b><span>diameter; a tennis ball is 67</span></div>
<div><b>{total:.0f} g</b><span>estimated, cell in</span></div>
<div><b>3.4 h</b><span>streaming and talking; 7.8 h idle</span></div>
<div><b>10 h</b><span>to charge through the XIAO's USB-C, asleep</span></div>
</div>

<h2>What changed from Rev A</h2>
<ul class="changes">{"".join(f"<li>{md_inline(s)}</li>" for s in CHANGES)}</ul>

<h2>Colour, part by part</h2>
<p>The rule of 2026-11-09: no paint and no covers; parts in brass, ivory, white or black, and anything sold only in another colour placed out of sight. Nothing here is skinned, sleeved or sprayed.</p>
{tbl(["Part", "Colour as sold", "Where it sits", "What shows"], COLOURS)}

<h2>Why these numbers</h2>
<ul>
<li><strong>70 mm</strong> is the smallest sphere that takes a 27 mm screen below the equator and the 21 mm XIAO above it, 19 mm forward of the centre, with the 43 mm tray across the floor. The screen's lower corners sit on the surface at y = −24.5, 2.7 mm above the base ring.</li>
<li><strong>Screen under the brow, camera over it.</strong> The equator is a rod at y = 0, 14 mm in front of the boards. Put the glass below it and the lens above it and the rod divides the face instead of crossing it. The equator passes only the screen's pin strip.</li>
<li><strong>One 300 mm rod per ring.</strong> A 70 mm circle is 220 mm around, so each big ring is one rod with an 80 mm offcut and no splice in view; the base ring is a third rod.</li>
<li><strong>The posts are the screen's own mounting holes.</strong> Four 2 mm holes on about a 23 mm pitch: two straight rods pass through them and the module cannot twist. The XIAO has no holes, so its short edges are glued to the same two rods, 0.5 mm away. No pin touches brass and the frame stays floating.</li>
<li><strong>An 11 mm gap behind the screen</strong> is what hides the two blue parts: the screen's board is 18 mm forward of the centre and the tray's front wall 6.5 mm, so the 8 mm toggle body stands against the wall and the 3 mm amplifier against the screen. Both sit above the screen's bottom edge and below the speaker's top, so neither the front nor the back sees them.</li>
<li><strong>Cell at y = −19</strong> puts 20 g of the 58 on the floor; that is what brings it back upright when you press the button.</li>
<li><strong>Sensor at the top, heat at the front.</strong> The AHT20 reads air, not the XIAO, because it sits 20 mm behind and 8 mm above the stack with open rods around it. Expect 1–2 °C of self-heating after an hour of streaming; the firmware subtracts a measured offset.</li>
</ul>

<h2>Parts</h2>
<p>Everything but the controller is in the drawers. The controller is in the pair Amazon expects by 11-15. Nothing to buy.</p>
{tbl(["Qty", "Part", "Where", "Colour", "Why, and what to check"], parts_rows, "parts")}

<h2>The wiring sheet</h2>
<figure class="sheet">{sheet}
<figcaption>The sphere's first wiring sheet. One rail, the cell itself; the XIAO's regulator feeds the screen and the sensor; the amp runs on the cell. {crossings} crossings, each a hop. Every pin and voltage checked against the Seeed wiki and the Adafruit pages.</figcaption></figure>

<h2>Pin map</h2>
{tbl(["Header", "GPIO", "Net", "Job"], [(h, g, f"<code>{n}</code>" if n else "", j) for h, g, n, j in PINS])}

<h2>Every wire, and why</h2>
{tbl(["Net", "From", "To", "Wire", "Why"], [(f"<code>{n}</code>", a, b, wv, y) for n, a, b, wv, y in NETS])}

<h2>Power, run time, charge time</h2>
{tbl(["Mode", "mA from the cell", "Time"], [(m, str(ma), t) for m, ma, _s, t in POWER])}
<div class="note warn"><span class="lbl">Carried over, unchanged</span>
<ul>
<li>The cell is the only source. Nothing into the XIAO's <code>5V</code> pin; only the holder on the BAT pads.</li>
<li>Amp off until firmware raises SD; volume cap 65; GAIN open.</li>
<li>Neither speaker lead is ground. No GND wire, no scope ground.</li>
<li>The brass is not a conductor: meter frame-to-every-net before the cell goes in, and after every solder session.</li>
<li>Never solder to the cell; never charge it below 0 °C; watch the first charge.</li>
</ul></div>

<h2>Frame cut list</h2>
{tbl(["Piece", "Stock", "Length", "How"], CUTS)}
<div class="note tip"><span class="lbl">Bending a true ring</span>
<p>Wrap the 1.5 mm rod one full turn around a 66 mm can (a 12 oz drink can); it springs back to about 70 mm. Overlap the ends 8 mm side by side, solder the lap, file it round, and put the joint where the base ring will cover it. Check against a 70 mm circle drawn with a compass. The base ring wraps around a 42 mm jar.</p></div>

<h2>Test every part before any brass</h2>
<p>Eight breadboard steps, each with a pass line. They use Seeed's own examples, so no firmware has to exist yet. Do them in order; each adds one part to the last.</p>
{tbl(["Step", "Do", "Pass when"], TESTS, "tests")}

<h2>Build order</h2>
<ol>{"".join(f"<li>{html.escape(s)}</li>" for s in BUILD)}</ol>

<h2>Mass</h2>
{tbl(["Part", "g"], [(p, f"{m:g}") for p, m in MASS] + [("<strong>Total</strong>", f"<strong>{total:.0f}</strong>")])}

<h2>What could go wrong</h2>
<ul>
<li><strong>Two rings meeting at a right angle</strong> is the only fiddly joint: hold the side ring upright in the equator with two clothes pegs on a cardboard disc, tack one crossing, check square, tack the other.</li>
<li><strong>The screen's holes.</strong> If the module in the drawer has no holes, or a pitch the posts cannot match, the fallback is two dabs of glue at the screen's edges, as for the XIAO.</li>
<li><strong>The screen's board colour</strong> is the one open colour question: check it in the drawer. Blue would show as a thin frame around the glass.</li>
<li><strong>Wi-Fi.</strong> Three rods with 35 mm gaps are no cage at 2.4 GHz; lay the XIAO's antenna flat on its back, under Kapton, pointing up.</li>
<li><strong>Glue carries the XIAO.</strong> Four dabs on a 0.5 mm gap hold 8 g with margin, but let them cure a day before the sphere is handled.</li>
<li><strong>It rolls.</strong> Knocked off its base ring, a sphere rolls; the low cell brings it back upright. Test the self-righting with the cell in before wiring.</li>
</ul>
<hr>
</div>
'''
    open(os.path.join(PAGES, "sphere.html"), "w").write(page)

def write_md(crossings):
    def md_tbl(headers, rows):
        out = ["| " + " | ".join(headers) + " |", "| " + " | ".join("---" for _ in headers) + " |"]
        for r in rows: out.append("| " + " | ".join(str(c).replace("|", "\\|") for c in r) + " |")
        return "\n".join(out)
    total = sum(m for _, m in MASS)
    parts_rows = [(q, p, f"[{w}]({u})", s, c, why) for q, p, w, u, s, c, why in PARTS]
    md = f'''# Pocket AI Sphere: design record

**{REV}, {REV_DATE}, approved as drawn by the builder on {APPROVED}. Nothing bent, soldered or flashed; the XIAO is in the mail.**
Generated by `pages/gen/sphere.py`; edit the script, not this file. The drawings and the wiring
sheet are on the published page (`pages/sphere.html`, [artifact]({ARTIFACT}), see `ARTIFACTS.md`).
Rev A (2026-10-29) is kept as `pages/gen/sphere_revA.py.bak` and `pages/sphere_revA.html.bak`.

## What it is

The third Pocket AI: the same assistant as the first build (screen, microphone, amplifier and
speaker, one button, Wi-Fi to the local server), plus the camera of the second build and a
weather sensor, in a 70 mm sphere of three brass rings instead of a box or a tower.

Three rings of 1.5 mm K&S rod: an equator and a side ring (left, over the top, right, under
the bottom) crossing at left and right so the front stays open, and a 44 mm base ring at
y = −27 that the sphere stands on and the cell tray rests on. Two 1.0 mm posts at x = ±11.5,
18.8 mm forward of the centre, rise from the base ring through the OLED's four mounting holes
and past the XIAO, whose short edges are glued to them; a 15 mm tie from each post to the
equator; two J-hooks from the top of the side ring for the sensor. Five frame joints.

Inside: the OLED below the equator (y −24.5..2.5, glass 21.5 mm forward), the XIAO ESP32-S3 Sense
above it (y 5..23, landscape, USB-C left, lens at y 14); the NL169 cell lying across the floor
in its tray (y −27..−13, z −11.5..6.5) as ballast; the toggle's body against the tray's front
wall and the amplifier against the back of the screen, both in the 11 mm gap between them, the
chrome lever out to the right at y −17; the speaker lying across the cell on the tray's walls
(y −10..−5) firing up; the 220 µF standing behind the tray; the AHT20 flat at y 30 under the top
of the side ring; the button inside the right joint, white cap out at x 37.

Coordinates: origin at the centre, x right, y up, z toward the face. Radius 35.

