#!/usr/bin/env python3
"""Pocket AI Sphere: geometry, parts, pins, nets and tests in one place.

Writes docs/pages/sphere.html (the published page) and docs/DESIGN.md (the record).
Coordinates in mm: x right, y up, z toward the viewer (the face). Origin at the
sphere's centre. Run from anywhere: python3 docs/pages/gen/sphere.py

History. 2026-10-29, Rev A: three great circles, then a 2V geodesic (120 struts) at the builder's
ask for the Las Vegas look, then back to three rings at his word ("only 2 or 3 lines other than the
shape"). 2026-11-10, Rev B (this file): the first wiring sheet, every part in its own colour under
the no-paint, no-cover rule of 2026-11-09, and four mistakes of Rev A fixed: the speaker was drawn
below the ring the sphere stands on; the equator crossed the screen at eye level; the boards'
header pins were to be soldered to the posts, which would have shorted them together; the AHT20
was to hang by its two outer pads (VIN and SDA). The Rev A generator is kept as sphere_revA.py.bak.
"""
import math, os, html

HERE = os.path.dirname(os.path.abspath(__file__))
PAGES = os.path.dirname(HERE)
DOCS = os.path.dirname(PAGES)

REV = "Rev B"
REV_DATE = "2026-11-10"
APPROVED = "2026-11-10"      # the builder approved Rev B as drawn
PHYSICS = "sphere-physics.html"  # step two, written after the approval
ARTIFACT = "https://claude.ai/artifact/TyrrZEifUATc6Fea6JbwQ2"

# ------------------------------------------------------------------ the numbers (mm)
R = 35.0                                   # sphere radius: 70 mm, a tennis ball is 67
BASE_R = 22.0                              # the base ring: 44 mm, what it stands on
BASE_Y = -math.sqrt(R*R - BASE_R*BASE_R)   # -27.2
PX = 11.5                                  # the two posts: at the OLED's mounting-hole pitch (23 mm; measure the module)
PZ = math.sqrt(BASE_R**2 - PX**2)          # 18.8: where the base ring passes x = +-11.5; the posts rise straight from it
POST_TOP = 23.0                            # the posts end at the top of the XIAO
TIE_Y = 3.5                                # the forward tie to the equator leaves the post just above the screen
TIE_Z = math.sqrt(R*R - PX*PX)             # 33.1: where the equator passes x = +-11.5
OLED = dict(x=13.5, y0=-24.5, y1=2.5, z0=PZ-1.0, z1=PZ+1.0, glass=PZ+2.7)   # 27 x 27 module, PCB 2 mm, glass 1.7 proud
XIAO = dict(x=10.5, y0=5.0, y1=23.0, z0=16.5, z1=17.7, sense0=22.2, sense1=23.7, lens=26.0)  # board 21 x 18; Sense board on top
HOLDER = dict(x=21.5, y0=-27.0, y1=-13.0, z0=-11.5, z1=6.5)                 # 43 x 18 x 14 tray, resting on the base ring
CELL = dict(y=-18.6, z=-2.5, r=8.3, x=17.0)                                 # NL169 16.6 x 34.1, lying left-right; its top at y -10.3
AMP = dict(x0=-12.5, x1=3.5, y0=-24.5, y1=-5.5, z0=13.3, z1=16.3)           # 16 x 19 x 3 board, standing behind the screen (above its bottom edge)
TOG = dict(x0=3.5, x1=13.5, y0=-23.5, y1=-10.5, z0=6.5, z1=14.5, ly=-17.0, lz=10.5, lever=26.0)  # 10 x 13 x 8 body against the tray wall, lever out to the right
SPK = dict(x0=-12.0, x1=8.0, y0=-10.3, y1=-5.4, z0=-9.0, z1=4.0)            # 20 x 13 x 4.9, lying across the cell on the tray walls, firing up
CAP = dict(x=16.0, y0=-27.0, y1=-16.0, z=-14.7, r=3.2)                      # 220 uF, 6.3 x 11, standing behind the tray
AHT = dict(x=12.7, y0=29.2, y1=30.8, z=8.9, hole_x=10.15, hole_z=6.35)      # 25.4 x 17.8 board, holes on 20.3 x 12.7
BTN = dict(x0=29.5, x1=33.0, cap=37.0)                                      # on the inside of the right joint, white cap out

# ------------------------------------------------------------------ projection
def norm(v):
    l = math.sqrt(sum(a*a for a in v)); return tuple(a/l for a in v)
def cross(a, b): return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])
def dot3(a, b): return sum(x*y for x, y in zip(a, b))

class View:
    def __init__(self, az, el, S, W, H, ox=None, oy=None):
        az, el = math.radians(az), math.radians(el)
        self.c = (math.sin(az)*math.cos(el), math.sin(el), math.cos(az)*math.cos(el))
        up = (0, 1, 0) if abs(el) < math.radians(80) else (0, 0, -1)
        self.r = norm(cross(up, self.c)); self.u = norm(cross(self.c, self.r))
        self.S, self.W, self.H = S, W, H
        self.ox = W/2 if ox is None else ox; self.oy = H/2 if oy is None else oy
        self.light = norm((-0.35, 0.6, 0.72))
        self.els = []
    def P(self, p): return (self.ox + self.S*dot3(p, self.r), self.oy - self.S*dot3(p, self.u))
    def depth(self, p): return dot3(p, self.c)
    def add(self, d, s): self.els.append((d, s))
    @staticmethod
    def fmt(pts): return " ".join(f"{x:.1f},{y:.1f}" for x, y in pts)

    def seg(self, a, b, w, col, dfade=True, dlift=0.0):
        pa, pb = self.P(a), self.P(b); d = (self.depth(a)+self.depth(b))/2
        k = 1.0
        if dfade:
            k = 0.55 + 0.45*(d + R)/(2*R)        # back rods thinner and paler
        op = 0.45 + 0.55*k if dfade else 1
        self.add(d+dlift, f'<line x1="{pa[0]:.1f}" y1="{pa[1]:.1f}" x2="{pb[0]:.1f}" y2="{pb[1]:.1f}" '
                 f'stroke="{col}" stroke-width="{w*k:.2f}" stroke-opacity="{op:.2f}" stroke-linecap="round"/>')
    def polyline3(self, pts, w, col, closed=True, dlift=0.0):
        n = len(pts)
        for i in range(n if closed else n-1):
            self.seg(pts[i], pts[(i+1) % n], w, col, dlift=dlift)
    def shade(self, nrm, base):
        k = 0.6 + 0.4*max(0.0, dot3(norm(nrm), self.light))
        return f'fill="{base}" style="filter:brightness({k:.2f})"'
    def box(self, x0, x1, y0, y1, z0, z1, base="var(--paper)", stroke="var(--ink)", w=1.1, dlift=0.0, op=1.0):
        faces = [((0, 0, 1), [(x0, y0, z1), (x1, y0, z1), (x1, y1, z1), (x0, y1, z1)]),
                 ((0, 0, -1), [(x0, y0, z0), (x1, y0, z0), (x1, y1, z0), (x0, y1, z0)]),
                 ((1, 0, 0), [(x1, y0, z0), (x1, y1, z0), (x1, y1, z1), (x1, y0, z1)]),
                 ((-1, 0, 0), [(x0, y0, z0), (x0, y1, z0), (x0, y1, z1), (x0, y0, z1)]),
                 ((0, 1, 0), [(x0, y1, z0), (x1, y1, z0), (x1, y1, z1), (x0, y1, z1)]),
                 ((0, -1, 0), [(x0, y0, z0), (x1, y0, z0), (x1, y0, z1), (x0, y0, z1)])]
        cen = ((x0+x1)/2, (y0+y1)/2, (z0+z1)/2)
        g = []
        for nrm, pts in faces:
            if dot3(nrm, self.c) > 1e-6:
                g.append(f'<polygon points="{self.fmt([self.P(p) for p in pts])}" {self.shade(nrm, base)} '
                         f'fill-opacity="{op}" stroke="{stroke}" stroke-width="{w}" stroke-linejoin="round"/>')
        if not g:
            pts = faces[0][1]
            g.append(f'<polygon points="{self.fmt([self.P(p) for p in pts])}" fill="none" stroke="{stroke}" stroke-width="{w}"/>')
        self.add(self.depth(cen)+dlift, "".join(g))
    def flat(self, pts3, fill, stroke="none", w=0, dlift=0.0, op=1.0):
        cen = tuple(sum(p[i] for p in pts3)/len(pts3) for i in range(3))
        self.add(self.depth(cen)+dlift, f'<polygon points="{self.fmt([self.P(p) for p in pts3])}" fill="{fill}" '
                 f'fill-opacity="{op}" stroke="{stroke}" stroke-width="{w}" stroke-linejoin="round"/>')
    @staticmethod
    def hull(pts):
        pts = sorted(set(pts))
        if len(pts) < 3: return pts
        def cr(o, a, b): return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
        lo = []
        for p in pts:
            while len(lo) >= 2 and cr(lo[-2], lo[-1], p) <= 0: lo.pop()
            lo.append(p)
        up = []
        for p in reversed(pts):
            while len(up) >= 2 and cr(up[-2], up[-1], p) <= 0: up.pop()
            up.append(p)
        return lo[:-1]+up[:-1]
    def cylinder(self, c0, c1, radius, base, stroke, n=28, dlift=0.0):
        axis = norm(tuple(c1[i]-c0[i] for i in range(3)))
        a = (0, 1, 0) if abs(axis[1]) < 0.9 else (1, 0, 0)
        e1 = norm(cross(axis, a)); e2 = cross(axis, e1)
        def ring(c): return [tuple(c[i] + radius*(math.cos(t)*e1[i] + math.sin(t)*e2[i]) for i in range(3))
                             for t in [2*math.pi*k/n for k in range(n)]]
        b, t = ring(c0), ring(c1)
        pb = [self.P(p) for p in b]; pt = [self.P(p) for p in t]
        h = self.hull([(round(x, 2), round(y, 2)) for x, y in pb+pt])
        cen = tuple((c0[i]+c1[i])/2 for i in range(3))
        cap = pt if dot3(axis, self.c) > 0 else pb
        self.add(self.depth(cen)+dlift, f'<polygon points="{self.fmt(h)}" fill="{base}" stroke="{stroke}" stroke-width="1.1" stroke-linejoin="round"/>'
                 f'<polygon points="{self.fmt(cap)}" fill="{base}" style="filter:brightness(1.08)" stroke="{stroke}" stroke-width="1.1"/>')

    def render(self, caption, labels=(), aria=""):
        self.els.sort(key=lambda e: e[0])
        out = [f'<svg viewBox="0 0 {self.W} {self.H}" role="img" aria-label="{html.escape(aria or caption)}">']
        out.append(f'<text x="18" y="24" font-size="13.5" font-weight="700" fill="var(--ink)">{html.escape(caption)}</text>')
        for d, s in self.els: out.append(s)
        for side in ("left", "right"):
            items = sorted([(self.P(p3)[1], p3, t) for sd, p3, t in labels
                            if (self.P(p3)[0] < self.ox) == (side == "left")])
            n = len(items)
            if not n: continue
            top, bot = 70, self.H-30
            step = (bot-top)/max(1, n-1)
            for i, (py, p3, t) in enumerate(items):
                x, y = self.P(p3); ys = top + i*step if n > 1 else (top+bot)/2
                xs = 250 if side == "left" else self.W-250
                xe = 260 if side == "left" else self.W-260
                out.append(f'<path d="M{x:.1f},{y:.1f} L{xe:.1f},{ys:.1f} L{xs:.1f},{ys:.1f}" fill="none" stroke="var(--ink-2)" stroke-width="0.9"/>'
                           f'<circle cx="{x:.1f}" cy="{y:.1f}" r="2.3" fill="var(--ink-2)"/>')
                anchor = "end" if side == "left" else "start"
                tx = xs-5 if side == "left" else xs+5
                out.append(f'<text x="{tx}" y="{ys+4:.1f}" font-size="12" text-anchor="{anchor}" fill="var(--ink)">{html.escape(t)}</text>')
        out.append('</svg>')
        return "\n".join(out)

# ------------------------------------------------------------------ the model
ROD = "var(--brass)"; BLK = "var(--blk)"; BLO = "var(--blk-lo)"; BLUE = "var(--blue)"; CHR = "var(--chrome)"
WHITE = "var(--white)"; PXL = "var(--px)"; GLASS = "var(--glass)"
def circle_pts(center, radius, e1, e2, n=72):
    return [tuple(center[i] + radius*(math.cos(t)*e1[i] + math.sin(t)*e2[i]) for i in range(3))
            for t in [2*math.pi*k/n for k in range(n)]]

def build(v):
    # silhouette and shadow for context
    sil = [v.P(p) for p in circle_pts((0, 0, 0), R, v.r, v.u, 90)]
    v.add(-99, f'<polygon points="{v.fmt(sil)}" fill="var(--paper)" stroke="var(--line)" stroke-width="1" stroke-dasharray="3 4"/>')
    sh = [v.P(p) for p in circle_pts((0, BASE_Y-0.5, 0), 26, (1, 0, 0), (0, 0, 1), 48)]
    v.add(-98, f'<polygon points="{v.fmt(sh)}" fill="var(--ink)" fill-opacity="0.08"/>')
    # three rings of 1.5 mm rod: equator (y 0), side ring (z 0), base ring
    v.polyline3(circle_pts((0, 0, 0), R, (1, 0, 0), (0, 0, 1)), 3.2, ROD)
    v.polyline3(circle_pts((0, 0, 0), R, (1, 0, 0), (0, 1, 0)), 3.2, ROD)
    v.polyline3(circle_pts((0, BASE_Y, 0), BASE_R, (1, 0, 0), (0, 0, 1)), 3.2, ROD)
    # two 1.0 mm posts straight up from the base ring, through the OLED's holes, past the XIAO; a tie each to the equator
    for x in (-PX, PX):
        v.seg((x, BASE_Y, PZ), (x, POST_TOP, PZ), 2.0, ROD)
        v.seg((x, TIE_Y, PZ), (x, 0, TIE_Z), 2.0, ROD)
    # OLED: black module below the equator, glass toward the viewer, pins along its top edge
    o = OLED
    v.box(-o["x"], o["x"], o["y0"], o["y1"], o["z0"], o["z1"], base=BLK, stroke=BLO)
    v.box(-12.5, 12.5, -22, -4, o["z1"], o["glass"], base=GLASS, stroke=BLO, dlift=0.5)
    for ex in (-5.5, 5.5):   # the eyes
        v.flat([(ex-3.2, -16, o["glass"]+0.05), (ex+3.2, -16, o["glass"]+0.05), (ex+3.2, -9, o["glass"]+0.05), (ex-3.2, -9, o["glass"]+0.05)], PXL, dlift=4.0)
    for px_ in (-3.8, -1.3, 1.3, 3.8):   # header pads
        v.flat([(px_-0.5, 0.5, o["z1"]+0.02), (px_+0.5, 0.5, o["z1"]+0.02), (px_+0.5, 2.2, o["z1"]+0.02), (px_-0.5, 2.2, o["z1"]+0.02)], CHR, dlift=1.0)
    # XIAO ESP32-S3 Sense above the equator, landscape, USB-C to the left, the Sense board and lens toward the viewer
    xx = XIAO
    v.box(-xx["x"], xx["x"], xx["y0"], xx["y1"], xx["z0"], xx["z1"], base=BLK, stroke=BLO)
    for bx in (-8.5, 6.0):   # the two board-to-board connectors
        v.box(bx, bx+2.5, 7, 21, xx["z1"], xx["sense0"], base=BLO, stroke=BLO, dlift=0.01)
    v.box(-xx["x"], xx["x"], xx["y0"], xx["y1"], xx["sense0"], xx["sense1"], base=BLK, stroke=BLO, dlift=0.02)
    v.box(-4, 4, 10, 18, xx["sense1"], xx["lens"]-0.5, base=BLO, stroke=BLO, dlift=0.03)
    v.cylinder((0, 14, xx["lens"]-0.5), (0, 14, xx["lens"]), 2.2, GLASS, BLO, dlift=0.05)
    v.cylinder((7.5, 8, xx["sense1"]), (7.5, 8, xx["sense1"]+0.3), 0.6, GLASS, BLO, dlift=0.04)   # the PDM mic port
    v.box(-xx["x"]-2, -xx["x"], 10, 14, xx["z0"]+0.5, xx["z0"]+3.5, base=CHR, stroke=BLO, dlift=0.03)       # USB-C, left
    # the holder tray on the base ring and the cell lying in it: black tray, black-and-yellow wrap
    h = HOLDER
    v.box(-h["x"], h["x"], h["y0"], h["y0"]+1.5, h["z0"], h["z1"], base=BLK, stroke=BLO)
    for x in (-h["x"], h["x"]-2):
        v.box(x, x+2, h["y0"], h["y1"], h["z0"], h["z1"], base=BLK, stroke=BLO)
    for z in (h["z0"], h["z1"]-1.2):
        v.box(-h["x"], h["x"], h["y0"], h["y1"]-4, z, z+1.2, base=BLK, stroke=BLO)
    c = CELL
    v.cylinder((-c["x"], c["y"], c["z"]), (c["x"], c["y"], c["z"]), c["r"], "var(--wrap)", BLO)
    v.cylinder((c["x"]-3.5, c["y"], c["z"]), (c["x"]-0.5, c["y"], c["z"]), c["r"]+0.1, "var(--yellow)", BLO, dlift=0.05)
    # the gap behind the screen: the blue amplifier and the blue toggle body, out of sight; the chrome lever out to the right
    a = AMP; v.box(a["x0"], a["x1"], a["y0"], a["y1"], a["z0"], a["z1"], base=BLUE, stroke=BLO)
    t = TOG; v.box(t["x0"], t["x1"], t["y0"], t["y1"], t["z0"], t["z1"], base=BLUE, stroke=BLO)
    v.cylinder((t["x1"], t["ly"], t["lz"]), (t["x1"]+3, t["ly"], t["lz"]), 3.0, CHR, BLO, dlift=0.04)
    v.cylinder((t["x1"]+3, t["ly"], t["lz"]), (t["lever"], t["ly"]+1.5, t["lz"]), 1.2, CHR, BLO, dlift=0.05)
    # speaker standing behind the holder, firing back; the 220 uF beside it
    s = SPK
    v.box(s["x0"], s["x1"], s["y0"], s["y1"], s["z0"], s["z1"], base=BLK, stroke=BLO, dlift=0.06)
    for x in (-8, -4, 0, 4):
        v.seg((x, s["y1"]+0.1, s["z0"]+2), (x, s["y1"]+0.1, s["z1"]-2), 0.8, "var(--ink-2)", dfade=False, dlift=0.08)
    cp = CAP; v.cylinder((cp["x"], cp["y0"], cp["z"]), (cp["x"], cp["y1"], cp["z"]), cp["r"], BLK, BLO)
    # AHT20 flat under the top of the side ring, on two hooks through its front mounting holes
    q = AHT
    v.box(-q["x"], q["x"], q["y0"], q["y1"], -q["z"], q["z"], base=BLK, stroke=BLO)
    v.box(-1.6, 1.6, q["y1"], q["y1"]+1.0, -1.6, 1.6, base=CHR, stroke=BLO, dlift=0.02)    # the sensor can
    for x in (-q["hole_x"], q["hole_x"]):
        yr = math.sqrt(R*R - x*x)
        v.seg((x, yr, 0), (x, q["y1"]+0.3, 0), 1.6, ROD)
        v.seg((x, q["y1"]+0.3, 0), (x, q["y1"]+0.3, q["hole_z"]), 1.6, ROD)
        v.seg((x, q["y1"]+0.3, q["hole_z"]), (x, q["y0"]-1.5, q["hole_z"]), 1.6, ROD)
    # action button on the inside of the right joint, white cap out
    b = BTN
    v.box(b["x0"], b["x1"], -3, 3, -3, 3, base=BLK, stroke=BLO)
    v.cylinder((b["x1"], 0, 0), (b["cap"], 0, 0), 2.5, WHITE, "var(--ink-2)", dlift=0.05)
    # the one wire bundle: white 30 AWG down behind the boards into the gap
    v.seg((-7, XIAO["y0"], XIAO["z0"]-0.3), (-7, AMP["y1"]+0.5, XIAO["z0"]-0.3), 1.8, WHITE, dfade=False, dlift=0.01)

def make_views():
    out = {}
    v = View(24, 13, 5.2, 960, 640)
    build(v)
    out["hero"] = v.render(f"The sphere from the front right. 70 mm across; 5.2 px per mm. {REV}, {REV_DATE}.",
        labels=[("", (-9, -12, OLED["glass"]), "0.96\" OLED face, below the equator"),
                ("", (0, 14, XIAO["lens"]), "camera and mic, above the equator"),
                ("", (-12, 12, XIAO["z0"]+2), "USB-C on the left: flash, charge"),
                ("", (CELL["x"]-2, CELL["y"], CELL["z"]+8), "16340 cell in its tray: the ballast"),
                ("", (TOG["lever"], TOG["ly"]+1.5, TOG["lz"]), "power lever: body behind the screen"),
                ("", (AMP["x0"]+2, AMP["y1"]-2, AMP["z1"]), "amplifier hidden behind the screen"),
                ("", (SPK["x1"]-3, SPK["y1"], SPK["z1"]-3), "speaker on the cell, firing up"),
                ("", (-BASE_R, BASE_Y, 0), "base ring, 44 mm: it stands on this"),
                ("", (-q_x(), AHT["y1"], 0), "AHT20 on two hooks, top of the ring"),
                ("", (BTN["cap"], 0, 0), "button, white cap, at the right pole"),
                ("", (R*0.7, 0, R*0.7), "equator, 1.5 mm rod: the brow line"),
                ("", (0, R, 0), "side ring, 1.5 mm rod"),
                ("", (PX, 15, PZ), "posts through the screen's holes"),
                ("", (-7, -3, XIAO["z0"]), "white wire bundle behind the boards")],
        aria="Three-quarter view of the three-ring brass sphere with the OLED face below the equator, the camera above it, the cell low with the speaker on it, the sensor at the top")
    v = View(0, 0, 4.2, 440, 400); build(v)
    out["front"] = v.render("From the front: screen below the brow, camera above.")
    v = View(90, 0, 4.2, 440, 400); build(v)
    out["side"] = v.render("From the right: the lever and the button; the stack front to back.")
    v = View(180, 0, 4.2, 440, 400); build(v)
    out["back"] = v.render("From behind: the cell, the speaker on it, the cap; nothing blue.")
    return out

def q_x(): return AHT["x"]

# ------------------------------------------------------------------ the data
INV = "../../pocket_ai_assistant/docs/INVENTORY.md"
CINV = "../../cyber_clock_v2/docs/INVENTORY.md"
L = {
    "xiao": "https://www.amazon.com/dp/B0C69FFVHH",
    "oled": "https://www.amazon.com/dp/B09T6SJBV5",
    "aht20": "https://www.adafruit.com/product/4566",
    "amp": "https://www.amazon.com/dp/B0CDWXZZCH",
    "amp_ada": "https://www.adafruit.com/product/3006",
    "spk": "https://www.digikey.com/en/products/detail/same-sky-formerly-cui-devices/CES-20134-088PM/10821309",
    "cell": "https://imrbatteries.com/products/nitecore-nl169-16340-950mah-battery",
    "holder": "https://www.amazon.com/dp/B0CRGK889F",
    "toggle": "https://www.amazon.com/dp/B0CZ6XZ2P9",
    "button": "https://www.amazon.com/dp/B0FHW6HMG4",
    "kits": "https://www.amazon.com/dp/B0F4P352BB",
    "rod15": "https://www.amazon.com/dp/B005WPAW9M",
    "rod10": "https://www.amazon.com/dp/B005WPB7YG",
    "wire": "https://www.amazon.com/dp/B073RDGTPB",
    "glue": "https://www.amazon.com/s?k=b-7000+glue",
