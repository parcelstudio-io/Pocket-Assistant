             ".ghost{fill:none;stroke:var(--ink-2);stroke-width:1.1;stroke-dasharray:3 3}"
             ".cavity{fill:var(--bg);stroke:var(--ink-2);stroke-width:.7}"
             ".desk{fill:none;stroke:var(--ink);stroke-width:1.6}"
