             ".tmpl{fill:none;stroke:var(--ink);stroke-width:1.4}"
             ".tmplhole{fill:var(--bg);stroke:var(--ink);stroke-width:1.2}"
             ".centre{fill:none;stroke:var(--ink-2);stroke-width:.8;stroke-dasharray:8 3 2 3}"
             + LH_CSS + "</style>")


# ----------------------------------------------------------------------------- shared drawing pieces
def cap_poly(X, Z, inner=False, n=24):
    """The cap's section outline in a view: left profile rim→top, right profile top→rim. X(r) and Z(z') map to the view."""
    f = cap_inner_pt if inner else cap_pt
    left = [f(i / n) for i in range(n + 1)]
    pts = [(X(-r), Z(z)) for r, z in left] + [(X(r), Z(z)) for r, z in reversed(left)]
    return pts


def label_l(o, px, py, lx, ly, lines):
    """A label whose text ends at lx (end-anchored), with a leader from its right end to the part at (px, py)."""
    o.append(leader(px, py, lx + 4, ly - 4))
    for i, s in enumerate(lines):
        o.append(T(lx, ly + i * 14, s, "fn", "end"))


def label_r(o, px, py, lx, ly, lines):
    o.append(leader(px, py, lx - 4, ly - 4))
    for i, s in enumerate(lines):
        o.append(T(lx, ly + i * 14, s, "fn"))


# ----------------------------------------------------------------------------- sheet 1: the form
def form_sheet():
    o = [T(20, 30, "Desk lighthouse: how the finished thing looks", "h1"),
         T(20, 48, f"An ivory tower on a brass cube on a brass coaster; a glass lantern between a brass deck and a brass roof, a brass ball on top. {D['height']:.0f} mm tall, Ø{D['disc_d']:.0f} at the base, about {D['mass']:.0f} g before the ballast. In the lantern a brass shutter turns round a fixed warm-white filament; in the cube's front, white text. Dimensions in mm; each view at its own scale.", "sub")]
    z1 = D["z_deck1"]

    # ---------------------------------------------------------------- front view, 2.3 px per mm
    s = 2.3
    x0, y0 = 200, 742
    X = lambda xm: x0 + xm * s   # noqa: E731
    Z = lambda zm: y0 - zm * s   # noqa: E731
    o.append(T(40, 90, "Front view", "h2"))
    o.append(f'<line x1="{X(-60)}" y1="{y0}" x2="{X(60)}" y2="{y0}" class="desk"/>')
    o.append(T(X(60), y0 + 14, "desk", "fn", "end"))
    o.append(rect(X(-D["disc_d"] / 2), Z(0), X(D["disc_d"] / 2), Z(D["disc_t"]), "brass"))
    o.append(rect(X(-D["cube"] / 2), Z(D["disc_t"]), X(D["cube"] / 2), Z(D["z_cube_top"]), "brass"))
    o.append(f'<line x1="{X(-D["cube"]/2 + D["cube_wall"])}" y1="{Z(D["z_cube_top"] - D["lid_inset"])}" x2="{X(D["cube"]/2 - D["cube_wall"])}" y2="{Z(D["z_cube_top"] - D["lid_inset"])}" class="brassln"/>')
    wz = D["disc_t"] + D["win_cz"]
    o.append(rect(X(-D["win_w"] / 2), Z(wz - D["win_h"] / 2), X(D["win_w"] / 2), Z(wz + D["win_h"] / 2), "blk"))
    o.append(T(X(0), Z(wz) + 3.5, f"FL W {E['period']:.1f}S", "onblack", "middle"))
    o.append(rect(X(-D["tower_od"] / 2), Z(D["z_cube_top"]), X(D["tower_od"] / 2), Z(D["z_deck0"]), "ivory"))
    o.append(rect(X(-D["deck_d"] / 2), Z(D["z_deck0"]), X(D["deck_d"] / 2), Z(z1), "brass"))
    o.append(rect(X(-D["glass_od"] / 2), Z(z1), X(D["glass_od"] / 2), Z(D["z_cap_rim"]), "glass"))
    o.append(rect(X(-D["drum_od"] / 2), Z(z1 + D["drum_z0"]), X(D["drum_od"] / 2), Z(z1 + D["drum_top"]), "brassdk"))
    wx = D["drum_od"] / 2 * math.sin(math.radians(D["win_deg"] / 2))
    o.append(rect(X(-wx), Z(z1 + D["drum_z0"] + D["dwin_z0"]), X(wx), Z(z1 + D["drum_z0"] + D["dwin_z0"] + D["dwin_h"]), "warmfill"))
    o.append(rect(X(-D["fil_w"] / 2), Z(z1 + D["fil_bot"]), X(D["fil_w"] / 2), Z(z1 + D["drum_z0"] + D["dwin_z0"] + D["dwin_h"]), "warm"))
    o.append(circ(X(0), Z(z1 + 20), 11 * s, "glow"))
    o.append(poly(cap_poly(X, lambda z: Z(z1 + z)), "brass", close=True))
    o.append(rect(X(-D["nip_od"] / 2), Z(D["z_cap_top"]), X(D["nip_od"] / 2), Z(z1 + D["ball_bot"]), "brassdk"))
    o.append(circ(X(0), Z(z1 + D["ball_c"]), D["ball_d"] / 2 * s, "brass"))
    cx_, cy_, r_ = X(0), Z(z1 + 17), 19 * s
    a0, a1 = math.radians(-55), math.radians(55)
    o.append(f'<path d="M{cx_ + r_*math.cos(a0):.1f},{cy_ + r_*math.sin(a0):.1f} A{r_:.1f},{r_:.1f} 0 0 1 {cx_ + r_*math.cos(a1):.1f},{cy_ + r_*math.sin(a1):.1f}" class="beam"/>')
    tx, ty = cx_ + r_ * math.cos(a1), cy_ + r_ * math.sin(a1)
    o.append(poly([(tx - 7, ty - 2), (tx + 1, ty - 9), (tx + 3, ty + 1)], "solid", close=True))
    o.append(T(cx_ + r_ + 6, cy_ + 4, f"{E['period']:.1f} s a turn", "fn"))
    o.append(dim_v(X(-D["disc_d"] / 2) - 24, Z(0), Z(D["height"]), f"{D['height']:.0f}", False))
    o.append(dim_v(X(-D["tower_od"] / 2) - 16, Z(z1), Z(D["z_cap_rim"]), f"{D['cap_rim']:.1f}", False))
    o.append(dim_v(X(D["tower_od"] / 2) + 18, Z(D["z_cube_top"]), Z(D["z_deck0"]), f"{D['tower_show']:.0f}", True))
    o.append(dim_v(X(D["cube"] / 2) + 18, Z(D["disc_t"]), Z(D["z_cube_top"]), f"{D['cube']:.1f}", True))
    o.append(dim_h(X(-D["disc_d"] / 2), X(D["disc_d"] / 2), y0 + 34, f"Ø{D['disc_d']:.0f} × {D['disc_t']:.0f} brass coaster, {D['disc_g']:.0f} g", False))
    o.append(dim_h(X(-D["deck_d"] / 2), X(D["deck_d"] / 2), Z(D["height"]) - 30, f"Ø{D['deck_d']:.1f} deck and roof", True))
    o.append(dim_h(X(-D["tower_od"] / 2), X(D["tower_od"] / 2), Z(110), f"Ø{D['tower_od']:.0f}", True))
    lx = 330
    label_r(o, X(D["ball_d"] / 2 * 0.7), Z(z1 + D["ball_c"] - 5), lx, 200, ["ventilator ball: 5/8 in brass,", "on a 1/8 IP nipple"])
    label_r(o, X(15), Z(z1 + D["cap_rim"] + 5), lx, 238, ["roof: 1-1/2 in spun brass vase", "cap, glued over the glass"])
    label_r(o, X(D["glass_od"] / 2), Z(z1 + 22), lx, 276, [f"lantern: acrylic Ø{D['glass_od']:.0f}; inside it", "a brass shutter turns round a", "fixed 2700 K filament"])
    label_r(o, X(D["deck_d"] / 2), Z(D["z_deck0"] + 1.5), lx, 340, ["gallery: 1-1/2 in turned brass", "check ring; no railing"])
    label_r(o, X(D["tower_od"] / 2), Z(100), lx, 480, [f"tower: brass tube Ø{D['tower_od']:.0f} × {D['tower_wall']:.1f},", "sprayed canvas white; the", "motor hides in its top"])
    label_r(o, X(D["cube"] / 2), Z(D["disc_t"] + 32), lx, 640, ["cube: 1-1/2 in square brass tube,", f"{D['cube']:.0f} on a side, a lid you lift;", "USB-C and button in the back"])
    label_r(o, X(D["win_w"] / 2), Z(wz), lx, 698, ["the door: white text in the", "brass, one line at a time"])
    label_r(o, X(D["disc_d"] / 2), Z(D["disc_t"] / 2), lx, 740, ["the satellite's coaster, weighted"])

    # ---------------------------------------------------------------- section through the lantern, 5 px per mm (front on the left)
    s2 = 5.0
    xs, ys = 600, 445
    X2 = lambda xm: xs + xm * s2      # noqa: E731  front negative (left), back positive
    Z2 = lambda zm: ys - zm * s2      # noqa: E731  z' above the deck's top
    o.append(T(520, 90, "Section through the lantern and the tower's top, front on the left", "h2"))
    ow, iw = D["tower_od"] / 2, D["tower_od"] / 2 - D["tower_wall"]
    o.append(rect(X2(-iw), Z2(-30), X2(iw), Z2(-D["deck_t"]), "cavity"))
    o.append(rect(X2(-ow), Z2(-30), X2(-iw), Z2(-D["deck_t"]), "ivory"))
    o.append(rect(X2(iw), Z2(-30), X2(ow), Z2(-D["deck_t"] - D["notch"]), "ivory"))
    mt = D["mot_t"] / 2
    o.append(rect(X2(-mt), Z2(-D["deck_t"] - D["mot_l"]), X2(mt), Z2(-D["deck_t"] - D["gear_l"]), "board"))
    o.append(rect(X2(-mt), Z2(-D["deck_t"] - D["gear_l"]), X2(mt), Z2(-D["deck_t"]), "steel"))
    o.append(rect(X2(-mt - 0.4), Z2(-D["deck_t"] - D["mot_l"]), X2(mt + 0.4), Z2(-D["deck_t"]), "ghost"))
    o.append(f'<path d="M{X2(-2)},{Z2(-D["deck_t"] - D["mot_l"])} L{X2(-2)},{Z2(-30)} M{X2(2)},{Z2(-D["deck_t"] - D["mot_l"])} L{X2(2)},{Z2(-30)}" class="hair"/>')
    o.append(rect(X2(-D["deck_d"] / 2), Z2(-D["deck_t"]), X2(D["deck_d"] / 2), Z2(0), "brass"))
    o.append(rect(X2(-D["deck_hole"] / 2), Z2(-D["deck_t"]), X2(D["deck_hole"] / 2), Z2(0), "cavity"))
    o.append(rect(X2(-D["reed_r"] - D["reed_hole"] / 2), Z2(-D["deck_t"]), X2(-D["reed_r"] + D["reed_hole"] / 2), Z2(0), "cavity"))
    o.append(rect(X2(D["ast_r"] - D["ast_od"] / 2), Z2(-D["deck_t"]), X2(D["ast_r"] + D["ast_od"] / 2), Z2(0), "cavity"))
    rr, rd = D["reed_r"], D["reed_down"]
    o.append(rect(X2(-rr - 1), Z2(-rd - D["reed_l"]), X2(-rr + 1), Z2(-rd), "glass"))
    o.append(f'<path d="M{X2(-rr)},{Z2(-rd)} L{X2(-rr)},{Z2(-0.6)} L{X2(-rr - 1.4)},{Z2(-0.6)} L{X2(-rr - 1.4)},{Z2(-30)} M{X2(-rr)},{Z2(-rd - D["reed_l"])} L{X2(-rr)},{Z2(-30)}" class="hair"/>')
    o.append(poly(cap_poly(X2, Z2), "brass", close=True))
    o.append(poly(cap_poly(X2, Z2, inner=True), "cavity", close=True))
    gi = D["glass_od"] / 2 - D["glass_wall"]
    o.append(rect(X2(-ow), Z2(0), X2(-gi), Z2(D["glass_h"]), "glass"))
    o.append(rect(X2(gi), Z2(0), X2(ow), Z2(D["glass_h"]), "glass"))
    ar, ao = D["ast_r"], D["ast_od"] / 2
    o.append(rect(X2(ar - ao), Z2(-D["deck_t"]), X2(ar + ao), Z2(D["ast_top"]), "brass"))
    for dx in (-0.7, 0.7):
        o.append(f'<path d="M{X2(ar + dx)},{Z2(-D["deck_t"] - 0.6)} L{X2(ar + dx)},{Z2(D["ast_top"] - 0.4)}" class="hair"/>')
    o.append(f'<path d="M{X2(ar)},{Z2(D["ast_top"] - 0.4)} L{X2(8.2)},{Z2(D["nut_bot"] + D["nut_h"] + 0.3)} L{X2(7.6)},{Z2(D["nut_bot"] - 0.6)} L{X2(4.6)},{Z2(D["nut_bot"] - 0.6)}" class="hair"/>')
    o.append(f'<path d="M{X2(ar)},{Z2(-D["deck_t"] - 0.6)} L{X2(iw - 0.6)},{Z2(-D["deck_t"] - 0.6)} L{X2(iw - 0.6)},{Z2(-30)}" class="hair"/>')
    o.append(rect(X2(-D["nut_d"] / 2), Z2(D["nut_bot"]), X2(D["nut_d"] / 2), Z2(D["nut_bot"] + D["nut_h"]), "brassdk"))
    o.append(rect(X2(-D["nip_od"] / 2), Z2(D["nut_bot"]), X2(D["nip_od"] / 2), Z2(D["nip_top"]), "brass"))
    o.append(rect(X2(-D["nip_od"] / 2 + 1.2), Z2(D["nut_bot"]), X2(D["nip_od"] / 2 - 1.2), Z2(D["nip_top"]), "cavity"))
    o.append(circ(X2(0), Z2(D["ball_c"]), D["ball_d"] / 2 * s2, "brass"))
    dr, dw = D["drum_od"] / 2, D["drum_wall"]
    o.append(rect(X2(-dr + dw), Z2(D["drum_z0"]), X2(dr - dw), Z2(D["floor_top"]), "brassdk"))
    o.append(rect(X2(-dr + dw), Z2(D["floor_top"]), X2(dr - dw), Z2(D["drum_top"]), "warmfill"))
    o.append(rect(X2(-dr), Z2(D["drum_z0"]), X2(-dr + dw), Z2(D["drum_z0"] + D["dwin_z0"]), "brassdk"))
    o.append(rect(X2(-dr), Z2(D["drum_z0"] + D["dwin_z0"] + D["dwin_h"]), X2(-dr + dw), Z2(D["drum_top"]), "brassdk"))
    o.append(rect(X2(dr - dw), Z2(D["drum_z0"]), X2(dr), Z2(D["drum_top"]), "brassdk"))
    o.append(rect(X2(-D["shaft_d"] / 2), Z2(-D["deck_t"]), X2(D["shaft_d"] / 2), Z2(D["shaft_tip"]), "steel"))
    for sgn in (-1, 1):
        o.append(rect(X2(sgn * D["hub_id"] / 2), Z2(D["drum_z0"]), X2(sgn * D["hub_od"] / 2), Z2(D["drum_z0"] + D["hub_h"]), "brass"))
    o.append(rect(X2(-D["mag_r"] - D["mag_d"] / 2), Z2(D["drum_z0"] - D["mag_t"]), X2(-D["mag_r"] + D["mag_d"] / 2), Z2(D["drum_z0"]), "mag"))
    o.append(rect(X2(-D["fil_w"] / 2), Z2(D["fil_bot"]), X2(D["fil_w"] / 2), Z2(D["fil_top"]), "warm"))
    for sgn in (-1, 1):
        o.append(f'<path d="M{X2(sgn * 0.45)},{Z2(D["fil_top"])} L{X2(sgn * 0.45)},{Z2(D["nut_bot"] - 0.6)} L{X2(sgn * 4.6)},{Z2(D["nut_bot"] - 0.6)}" class="hair"/>')
    zw = D["drum_z0"] + D["dwin_z0"] + D["dwin_h"] / 2
    for dz in (-8, 0, 8):
        o.append(f'<line x1="{X2(-dr)}" y1="{Z2(zw)}" x2="{X2(-21)}" y2="{Z2(zw + dz)}" class="beam"/>')
    lxr = 716
    label_r(o, X2(6), Z2(D["ball_c"] + 2), lxr, 166, ["5/8 in brass ball, blind-tapped 1/8 IP"])
    label_r(o, X2(D["nut_d"] / 2), Z2(D["nut_bot"] + 2), lxr, 212, ["1/2 in nipple through the cap; the beaded nut", "clamps it and hangs the lamp by its leads"])
    label_r(o, X2(16.5), Z2(D["cap_rim"] + 4), lxr, 250, ["vase cap Ø38: the roof, glued over", "the glass's top edge inside it"])
    label_r(o, X2(ow), Z2(31), lxr, 288, [f"acrylic Ø{D['glass_od']:.0f} × 2, cut {D['glass_h']:.0f}, {D['cap_rim']:.1f} showing", "under the cap's rim"])
    label_r(o, X2(dr), Z2(24), lxr, 324, [f"the shutter: 5/8 in brass tube, {D['drum_h']:.0f} tall,", f"a {D['win_deg']:.0f}° window {D['dwin_h']:.0f} tall, floor soldered in"])
    label_r(o, X2(D["fil_w"] / 2), Z2(18), lxr, 360, [f"filament {D['fil_l']:.0f} mm, 3 V, 2700 K: the lamp,", f"{E['i_lamp_max']:.0f} mA flat out, still, on the axis"])
    label_r(o, X2(ar + ao), Z2(11), lxr, 396, ["astragal: 4 mm brass tube, 3 mm into the", "deck, the lamp's two wires inside it"])
    label_r(o, X2(D["hub_od"] / 2), Z2(D["drum_z0"] + 5), lxr, 430, ["hub: 4 mm tube, a slip fit on the 3 mm D", "shaft, glued; 2 mm of air under the floor"])
    label_r(o, X2(D["deck_d"] / 2), Z2(-D["deck_t"] / 2), lxr, 464, [f"gallery: turned check ring Ø{D['deck_d']:.1f} × {D['deck_t']:.0f}, its", "11 mm hole already where the shaft goes"])
    label_r(o, X2(-D["mag_r"] + 1.5), Z2(D["drum_z0"] - 0.5), lxr, 498, ["3 × 1 mm magnet under the floor, 6 mm out,", "at the window's middle; it never shows"])
    label_r(o, X2(-rr + 1), Z2(-rd - 6), lxr, 532, ["reed switch, 3 mm hole, 2.5 mm down: the", "index, once a turn; its leads go down"])
    label_r(o, X2(iw), Z2(-D["deck_t"] - 1.2), lxr, 566, ["the lamp's wires come under the deck through", "a 2 mm notch in the tower's rim"])
    label_r(o, X2(mt), Z2(-D["deck_t"] - 18), lxr, 600, ["N20 gearmotor, 6 V 30 rpm: a Kapton-wrapped", f"plug in the Ø{D['tower_od']:.0f} tower's top; pulls out downward"])

    # ---------------------------------------------------------------- plan, looking down into the lantern, 5 px per mm
    cx, cy = 1200, 215
    o.append(T(1060, 90, "Plan: looking down into the lantern (front at the bottom)", "h2"))
    o.append(circ(cx, cy, D["deck_d"] / 2 * s2, "brass"))
    o.append(circ(cx, cy, D["glass_od"] / 2 * s2, "glass"))
    o.append(circ(cx, cy, gi * s2, "cavity"))
    o.append(rect(cx - D["mot_w"] / 2 * s2, cy - D["mot_t"] / 2 * s2, cx + D["mot_w"] / 2 * s2, cy + D["mot_t"] / 2 * s2, "ghost"))
    o.append(circ(cx, cy, D["mag_r"] * s2, "ghost"))
    o.append(arc_path(cx, cy, D["drum_od"] / 2 * s2, 90 + D["win_deg"] / 2, 450 - D["win_deg"] / 2, "brassring"))
    o.append(circ(cx, cy, D["hub_od"] / 2 * s2, "brass"))
    o.append(circ(cx, cy, D["fil_w"] / 2 * s2 + 1, "warm"))
    o.append(circ(cx, cy + D["mag_r"] * s2, D["mag_d"] / 2 * s2, "mag"))
    o.append(circ(cx, cy + D["reed_r"] * s2, D["reed_hole"] / 2 * s2, "cavity"))
    o.append(circ(cx, cy - D["ast_r"] * s2, D["ast_od"] / 2 * s2, "brass"))
    for a in (90 - D["win_deg"] / 2, 90 + D["win_deg"] / 2):
        o.append(f'<line x1="{cx + 7 * math.cos(math.radians(a)):.1f}" y1="{cy + 7 * math.sin(math.radians(a)):.1f}" x2="{cx + 112 * math.cos(math.radians(a)):.1f}" y2="{cy + 112 * math.sin(math.radians(a)):.1f}" class="beam"/>')
    o.append(arc_path(cx, cy, 108, 90 - D["win_deg"] / 2, 90 + D["win_deg"] / 2, "beam"))
    ra = 55
    a0, a1 = math.radians(200), math.radians(330)
    o.append(f'<path d="M{cx + ra*math.cos(a0):.1f},{cy + ra*math.sin(a0):.1f} A{ra},{ra} 0 0 1 {cx + ra*math.cos(a1):.1f},{cy + ra*math.sin(a1):.1f}" class="glow"/>')
    o.append(T(cx, cy + 128, f"the beam, {D['win_deg']:.0f}°, toward whoever sits in front", "fn", "middle"))
    col1 = ["deck Ø38.1 · glass Ø25 (the tower's circle)", f"drum Ø{D['drum_od']:.1f}, open {D['win_deg']:.0f}° · hub Ø4", "filament on the axis", "motor 12 × 10 below the deck (ghost)"]
    col2 = [f"magnet at r {D['mag_r']:.0f}, its path dashed", f"reed hole Ø3 at r {D['reed_r']:.1f}, front", f"astragal Ø4 at r {D['ast_r']:.1f}, back", f"turns {E['rpm_target']:.0f} rpm: {E['period']:.1f} s a revolution"]
    for i, t in enumerate(col1):
        o.append(T(1062, 358 + i * 14, t, "fn"))
    for i, t in enumerate(col2):
        o.append(T(1062, 418 + i * 14, t, "fn"))

    # ---------------------------------------------------------------- section through the cube, front on the left, 4 px per mm
    s3 = 4.0
    xc, y3 = 1010, 778
    Y3 = lambda ym: xc + ym * s3   # noqa: E731  front negative
    Z3 = lambda zm: y3 - zm * s3   # noqa: E731  above the coaster's top
    o.append(T(1060, 494, "Section through the cube, front on the left", "h2"))
    hw, cw = D["cube"] / 2, D["cube_wall"]
    o.append(rect(Y3(-D["disc_d"] / 2), Z3(-D["disc_t"]), Y3(D["disc_d"] / 2), Z3(0), "brass"))
    o.append(rect(Y3(-D["hollow_d"] / 2), Z3(-D["disc_t"]), Y3(D["hollow_d"] / 2), Z3(-D["disc_t"] + D["hollow_h"]), "cavity"))
    for k in range(-8, 9):
        xx = Y3(k * 4.2)
        o.append(f'<line x1="{xx}" y1="{Z3(-D["disc_t"] + 0.6)}" x2="{xx + 12}" y2="{Z3(-D["disc_t"] + D["hollow_h"] - 0.6)}" class="hatch"/>')
    o.append(rect(Y3(-hw), Z3(0), Y3(-hw + cw), Z3(D["cube"]), "brass"))
    o.append(rect(Y3(hw - cw), Z3(0), Y3(hw), Z3(D["cube"]), "brass"))
    o.append(rect(Y3(-hw), Z3(D["win_cz"] - D["win_h"] / 2), Y3(-hw + cw), Z3(D["win_cz"] + D["win_h"] / 2), "cavity"))
    o.append(rect(Y3(hw - cw), Z3(D["usb_cz"] - D["usb_h"] / 2), Y3(hw), Z3(D["usb_cz"] + D["usb_h"] / 2), "cavity"))
    o.append(rect(Y3(hw - cw), Z3(D["btn_cz"] - D["btn_hole"] / 2), Y3(hw), Z3(D["btn_cz"] + D["btn_hole"] / 2), "cavity"))
    lid_top = D["cube"] - D["lid_inset"]
    for sgn in (-1, 1):
        o.append(rect(Y3(sgn * (hw - cw)), Z3(lid_top - D["lid_t"] - 0.81), Y3(sgn * (hw - cw - D["stop"])), Z3(lid_top - D["lid_t"]), "brassdk"))
        o.append(rect(Y3(sgn * D["lid"] / 2), Z3(lid_top - D["lid_t"]), Y3(sgn * (D["tower_od"] / 2 + 0.1)), Z3(lid_top), "brass"))
        o.append(rect(Y3(sgn * ow), Z3(D["tube_bot"]), Y3(sgn * iw), Z3(lid_top), "brass"))
        o.append(rect(Y3(sgn * ow), Z3(lid_top), Y3(sgn * iw), Z3(52), "ivory"))
    o.append(circ(Y3(0), Z3(D["pin_z"]), D["pin_d"] / 2 * s3, "steel"))
    o.append(rect(Y3(-hw + cw), Z3(1.5), Y3(-hw + cw + 1.5), Z3(20.8), "blk"))
    o.append(rect(Y3(-hw + cw + 1.5), Z3(0), Y3(-hw + cw + 2.5), Z3(D["oled_h"]), "board"))
    o.append(rect(Y3(-12), Z3(0), Y3(13), Z3(D["mx_t"]), "board"))
    o.append(rect(Y3(hw - cw - D["c3_l"]), Z3(D["mx_t"] + 0.4), Y3(hw - cw), Z3(D["mx_t"] + 1.4), "board"))
    o.append(rect(Y3(hw - cw - 9), Z3(D["mx_t"] + 1.4), Y3(hw), Z3(D["mx_t"] + 1.4 + 3.2), "usb"))
    o.append(rect(Y3(-2), Z3(D["mx_t"] + 1.4), Y3(5), Z3(D["mx_t"] + 4.0), "steel"))
    o.append(rect(Y3(hw - cw - 6), Z3(D["btn_cz"] - 3), Y3(hw - cw), Z3(D["btn_cz"] + 3), "part"))
    o.append(rect(Y3(hw - cw), Z3(D["btn_cz"] - 1.4), Y3(hw + 0.5), Z3(D["btn_cz"] + 1.4), "steel"))
    for (ya, yb) in ((-6, -9), (-3, 0), (0, 5), (3, 8), (6, 10), (9, 12)):
        o.append(f'<path d="M{Y3(ya)},{Z3(D["tube_bot"])} L{Y3(yb)},{Z3(D["mx_t"] + 4.5)}" class="hair"/>')
    o.append(dim_v(Y3(-hw) - 16, Z3(0), Z3(D["cube"]), f"{D['cube']:.1f}", False))
    o.append(dim_v(Y3(-hw) - 16, Z3(-D["disc_t"]), Z3(0), f"{D['disc_t']:.0f}", False))
    lxr2 = 1124
    label_r(o, Y3(ow), Z3(46), lxr2, 580, ["tower: bare brass inside the cube,", "ivory above the lid"])
    label_r(o, Y3(15), Z3(lid_top - 0.4), lxr2, 614, ["lid: 0.8 mm brass set 0.8 down on four", "stops; lifts out with the tower"])
    label_r(o, Y3(-hw + 1), Z3(D["win_cz"] + 5), lxr2, 648, [f"window {D['win_w']:.0f} × {D['win_h']:.1f}, centre {D['win_cz']:.0f} up; the", "screen's glass against the wall's inside"])
    label_r(o, Y3(hw + 0.5), Z3(D["btn_cz"]), lxr2, 682, ["the button, through the back face"])
    label_r(o, Y3(D["pin_d"] / 2), Z3(D["pin_z"]), lxr2, 710, ["1.5 mm brass pin through the side faces and", f"the tower's foot, {D['pin_z']:.0f} up; pull it to lift"])
    label_r(o, Y3(hw), Z3(D["usb_cz"]), lxr2, 744, ["controller on the driver board, its USB-C", "through the back: power, flashing, console"])
    label_r(o, Y3(12), Z3(D["mx_t"] / 2), lxr2, 772, ["driver board flat on the coaster"])
    label_r(o, Y3(D["hollow_d"] / 2 - 6), Z3(-D["disc_t"] + 3), 1200, 800, [f"about {D['ballast_g']:.0f} g of steel washers", "hot-glued in the hollow"])

    # ---------------------------------------------------------------- how it behaves, and the key numbers
    bx, by = 522, 628
    o.append(T(bx, by, "How it behaves", "h2"))
    lines = [("off", "lamp dark, shutter closed (brass to you), clock dim"),
             ("lamp", f"shutter parked open to you, filament {E['lamp_duty'] * 100:.0f} % ({E['i_lamp']:.0f} mA)"),
             ("beacon", f"the shutter turns, {E['period']:.1f} s a revolution: a {E['pass_s']:.1f} s sweep"),
             ("", f"of light, then brass. Fl W {E['period']:.1f}s"),
             ("button", "short: rotation on/off (off parks the window on you);"),
             ("", "long: lamp off, low, full (off closes the shutter)"),
             ("screen", "time · characteristic, measured · keeper's log · sea lines")]
    for i, (k, v) in enumerate(lines):
        yy = by + 18 + i * 14
        o.append(T(bx, yy, k, "lab")); o.append(T(bx + 54, yy, v, "fn"))
    o.append(T(bx, by + 124, "Key numbers", "h2"))
    keys = [f"{D['height']:.0f} tall · Ø{D['disc_d']:.0f} base · cube {D['cube']:.1f} · tower Ø{D['tower_od']:.0f} × {D['tower_show']:.0f}",
            f"lantern Ø{D['glass_od']:.0f}, {D['cap_rim']:.1f} shown · deck and roof Ø{D['deck_d']:.1f} · ball {D['ball_d']:.1f}",
            f"{D['mass']:.0f} g, centre of mass {D['cg']:.0f} up, tips at {D['tip_deg']:.0f}° ({D['push_n']:.1f} N at the ball);",
            f"with {D['ballast_g']:.0f} g of steel in the coaster: {D['cg_b']:.0f} up, {D['tip_deg_b']:.0f}° ({D['push_n_b']:.1f} N)",
            f"{E['typ']:.0f} mA typical, {E['peak']:.0f} peak · lamp {E['i_lamp_max']:.0f} mA ({E['lamp_w'] * 1000:.0f} mW) · motor {E['mot_ma']:.0f} mA",
            f"cuts: tower {D['tube_len']:.0f} · glass {D['glass_h']:.0f} · drum {D['drum_h']:.0f}, window {D['win_arc']:.1f} × {D['dwin_h']:.0f} · lid {D['lid']:.1f} sq · astragal {D['ast_top'] + D['deck_t']:.0f}"]
    for i, k in enumerate(keys):
        o.append(T(bx, by + 142 + i * 13, k, "fn"))
    o.append(T(20, 848, f"Paper design {TODAY}, not built. The check ring's thickness and the vase cap's height are the usual sizes for those lamp parts: measure them and rerun the script. Sources: the reference page, the listings, the SuperMini notes, the datasheets, the inventories.", "sub"))
    return f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="Desk lighthouse form sheet">{SHEET_CSS}{"".join(o)}</svg>'


# ----------------------------------------------------------------------------- sheet 2: the wiring
def wiring_sheet():
    rt = Router()
    w = rt.wire
    o = [T(20, 30, "Desk lighthouse: every connection on one sheet", "h1"),
         T(20, 48, "A dot is a joint. A line that hops over another does not touch it. Thick = 30 AWG wire you solder. Thin = a lead that comes with the part. Pins are grouped by job, not by position on the board. Zero crossings.", "sub")]

    # the screen, left
    SX, SY, SW, SH = 60, 95, 240, 170
    o.append(block(SX, SY, SW, SH, "Screen", "0.96 in OLED, 128 × 64, white, I²C", ty=22))
    o.append(pin(rt, SX + SW, 150, "VCC", "R", "V3")); o.append(pin(rt, SX + SW, 180, "GND", "R", "GND"))
    o.append(pin(rt, SX + SW, 210, "SCL", "R", "SCL")); o.append(pin(rt, SX + SW, 240, "SDA", "R", "SDA"))
    o.append(T(SX + 14, 160, "address 0x3C (probe 0x3D)", "fn")); o.append(T(SX + 14, 174, "header pins off; four", "fn"))
    o.append(T(SX + 14, 188, "wires on the pads; read", "fn")); o.append(T(SX + 14, 202, "the pin order off the", "fn"))
    o.append(T(SX + 14, 216, "silkscreen first", "fn")); o.append(T(SX + 14, 236, "glass against the front", "fn")); o.append(T(SX + 14, 250, "face, in the window", "fn"))

    # the controller, centre left
    EX, EY, EW, EH = 420, 95, 280, 350
    o.append(block(EX, EY, EW, EH, "ESP32-C3 SuperMini", "on the driver board, USB-C through the back", ty=20))
    o.append(pin(rt, EX, 150, "3V3", "L", "V3", "3.3 V out", EX + 48))
    o.append(pin(rt, EX, 180, "GND", "L", "GND"))
    o.append(pin(rt, EX, 210, "GPIO5", "L", "SCL", "I²C clock", EX + 66))
    o.append(pin(rt, EX, 240, "GPIO4", "L", "SDA", "I²C data", EX + 66))
    o.append(pin(rt, EX + EW, 150, "5V", "R", "V5", "USB VBUS, no diode", EX + EW - 36))
    o.append(pin(rt, EX + EW, 180, "GND", "R", "GND"))
    o.append(pin(rt, EX + EW, 235, "GPIO0", "R", "IN1", "shutter PWM", EX + EW - 66))
    o.append(pin(rt, EX + EW, 265, "GPIO1", "R", "IN2", "direction, brake", EX + EW - 66))
    o.append(pin(rt, EX + EW, 295, "GPIO3", "R", "IN3", "lamp PWM", EX + EW - 66))
    o.append(pin(rt, EX + EW, 350, "GPIO6", "R", "REED", "index, pull-up", EX + EW - 66))
    o.append(pin(rt, 600, EY + EH, "GPIO10", "B", "BTN")); o.append(pin(rt, 680, EY + EH, "GND", "B", "GND"))
    o.append(T(EX + 14, 300, "GPIO2, 8, 9: straps,", "fn")); o.append(T(EX + 14, 314, "unwired; 7, 20, 21 free", "fn"))
    o.append(T(EX + 14, 334, "Wi-Fi: the time (SNTP),", "fn")); o.append(T(EX + 14, 348, "the keeper's log", "fn"))
    o.append(T(EX + 14, 372, "LEDC: 20 kHz for the motor", "fn")); o.append(T(EX + 14, 386, "(silent), 5 kHz for the lamp;", "fn")); o.append(T(EX + 14, 400, "all three low at boot", "fn"))
    o.append(f'<rect x="{EX + 14}" y="{EY + EH - 26}" width="40" height="16" rx="3" class="usb"/>'); o.append(T(EX + 34, EY + EH - 14, "USB-C", "fn", "middle"))
    o.append(T(EX + 62, EY + EH - 14, "5 V in; flashing", "fn"))
    o.append(w([(SX + SW, 150), (EX, 150)], "rod", "V3")); o.append(T(360, 142, "3V3 → VCC", "lab", "middle"))
    o.append(w([(SX + SW, 180), (EX, 180)], "rod", "GND"))
    o.append(w([(SX + SW, 210), (EX, 210)], "rod", "SCL")); o.append(T(360, 202, "SCL", "lab", "middle"))
    o.append(w([(SX + SW, 240), (EX, 240)], "rod", "SDA")); o.append(T(360, 232, "SDA", "lab", "middle"))

    # the driver, centre right
    DX, DY, DW, DH = 820, 95, 240, 320
    o.append(block(DX, DY, DW, DH, "MX1508 dual H-bridge", "2 to 10 V · 1.5 A a channel · pads", ty=20))
    o.append(pin(rt, DX, 150, "VCC", "L", "V5", "motor supply", DX + 52))
    o.append(pin(rt, DX, 180, "GND", "L", "GND"))
    o.append(pin(rt, DX, 205, "IN4", "L", "GND", "tied low", DX + 46))
    o.append(pin(rt, DX, 235, "IN1", "L", "IN1", "A: speed", DX + 46))
    o.append(pin(rt, DX, 265, "IN2", "L", "IN2", "A: direction", DX + 46))
    o.append(pin(rt, DX, 295, "IN3", "L", "IN3", "B: lamp", DX + 46))
    o.append(pin(rt, DX + DW, 255, "OUT1", "R", "MOT1", "channel A", DX + DW - 56))
    o.append(pin(rt, DX + DW, 285, "OUT2", "R", "MOT2"))
    o.append(pin(rt, DX + DW, 360, "OUT3", "R", "LAMP", "channel B", DX + DW - 56))
    o.append(pin(rt, DX + DW, 390, "OUT4", "R", "LAMPR", "held at GND", DX + DW - 56))
    o.append(T(DX + 120, 330, "inputs read 3.3 V as high · flyback diodes inside", "fn", "middle"))
    o.append(T(DX + 120, 344, "channel A turns the shutter, channel B lights the lamp", "fn", "middle"))
    o.append(w([(EX + EW, 150), (DX, 150)], "rod", "V5")); o.append(T(760, 142, "5 V rail", "lab", "middle"))
    o.append(w([(EX + EW, 180), (DX, 180)], "rod", "GND")); o.append(T(760, 172, "one ground", "fn", "middle"))
    o.append(w([(DX, 205), (800, 205), (800, 180)], "rod", "GND")); o.append(dot(800, 180))
    o.append(w([(EX + EW, 235), (DX, 235)], "rod", "IN1")); o.append(T(760, 227, "GPIO0 → IN1", "lab", "middle"))
    o.append(w([(EX + EW, 265), (DX, 265)], "rod", "IN2")); o.append(T(760, 257, "GPIO1 → IN2", "lab", "middle"))
    o.append(w([(EX + EW, 295), (DX, 295)], "rod", "IN3")); o.append(T(760, 287, "GPIO3 → IN3", "lab", "middle"))

    # the motor and the lamp, right
    MX, MY, MW, MH = 1140, 190, 190, 110
    o.append(block(MX, MY, MW, MH, "Shutter motor", "N20, 6 V 30 rpm, in the tower", ty=22))
    o.append(pin(rt, MX, 255, "M1", "L", "MOT1")); o.append(pin(rt, MX, 285, "M2", "L", "MOT2"))
    o.append(w([(DX + DW, 255), (MX, 255)], "rod", "MOT1")); o.append(w([(DX + DW, 285), (MX, 285)], "rod", "MOT2"))
    o.append(T(1098, 247, f"{E['mot_ma']:.0f} mA", "fn", "middle"))
    o.append(T(MX + 46, 266, "two of the six wires", "fn")); o.append(T(MX + 46, 280, "down the tower", "fn"))
    LX, LY, LW, LH = 1140, 310, 190, 120
    o.append(block(LX, LY, LW, LH, "Lamp", f"{D['fil_l']:.0f} mm filament, 3 V, 2700 K", ty=22))
    o.append(pin(rt, LX, 360, "+ lead", "L", "LAMP")); o.append(pin(rt, LX, 390, "− lead", "L", "LAMPR"))
    o.append(T(LX + 72, 362, "hangs from the nut;", "fn")); o.append(T(LX + 72, 376, "the hole in the", "fn")); o.append(T(LX + 72, 390, "ceramic is +; both", "fn")); o.append(T(LX + 72, 404, "wires up the astragal", "fn"))
    o.append(T(LX + 14, 420, f"{E['i_lamp_max']:.0f} mA flat out, PWM below", "fn"))
    o.append(w([(DX + DW, 360), (1092, 360)], "rod", "LAMP")); o.append(zigzag_h(rt, 1092, 1128, 360, "LAMP")); o.append(w([(1128, 360), (LX, 360)], "rod", "LAMP"))
    o.append(T(1110, 347, "2 × 47 Ω", "lab", "middle"))
    o.append(w([(DX + DW, 390), (LX, 390)], "rod", "LAMPR"))

    # the reed, the button, the adapter, and one return lane
    RX, RY, RW, RH = 1140, 470, 160, 90
    o.append(block(RX, RY, RW, RH, "Reed switch", "2 × 14 glass, in the deck", ty=22))
    o.append(pin(rt, RX, 520, "leg 1", "L", "REED")); o.append(pin(rt, RX, 545, "leg 2", "L", "GND"))
    o.append(w([(EX + EW, 350), (740, 350), (740, 520), (RX, 520)], "rod", "REED")); o.append(T(940, 512, "GPIO6 → reed: the index, once a turn", "lab", "middle"))
    o.append(w([(RX, 545), (1100, 545), (1100, 620)], "rod", "GND"))
    BX, BY = 560, 520
    o.append(block(BX, BY, 140, 60, "Button", "6 mm tactile, back face", ty=24))
    o.append(pin(rt, 600, BY, "", "T", "BTN")); o.append(pin(rt, 660, BY + 60, "", "B", "GND"))
    o.append(T(590, BY - 6, "leg 1", "fn", "end")); o.append(T(670, BY + 76, "leg 2", "fn"))
    o.append(w([(600, EY + EH), (600, BY)], "rod", "BTN")); o.append(T(612, 486, "GPIO10 → button", "lab"))
    o.append(w([(660, BY + 60), (660, 620)], "rod", "GND"))
    o.append(w([(680, EY + EH), (680, 620)], "rod", "GND"))
    o.append(w([(660, 620), (1100, 620)], "rod", "GND")); o.append(dot(660, 620)); o.append(dot(680, 620)); o.append(dot(1100, 620))
    o.append(T(880, 638, "the button's and the reed's returns share one lane into the controller's GND", "fn", "middle"))
    o.append(block(374, 520, 160, 60, "USB-C adapter", "any 1 A adapter"))
    o.append(w([(454, 520), (454, EY + EH - 10)], "thin", "USB"))
    o.append(T(455, 598, f"{E['typ']:.0f} mA typical, {E['peak']:.0f} mA at the worst moment", "fn", "middle"))

    # the budget, along the bottom
    NY = 676
    o.append(T(20, NY - 10, "The budget: mA from the 5 V rail", "h2"))
    cols = [("controller", f"{E['c3_avg']:.0f} average with Wi-Fi connected; {E['c3_peak']:.0f} in a transmit burst"),
            ("screen", f"{E['oled']:.0f} with half the pixels lit"),
            ("motor", f"{E['mot_ma']:.0f} turning at {E['duty_mot'] * 100:.0f} % duty ({E['rpm_target']:.0f} rpm); about {E['mot_stall']:.0f} if the drum jams, which the reed's silence reports"),
            ("lamp", f"{E['i_lamp_max']:.0f} flat out, {E['i_lamp']:.0f} at the {E['lamp_duty'] * 100:.0f} % default; {E['lamp_w'] * 1000:.0f} mW in the lantern, {E['p_res_each'] * 1000:.0f} mW in each resistor"),
            ("driver", f"{E['mx_q']:.0f} quiescent"),
            ("together", f"{E['typ']:.0f} typical, {E['peak']:.0f} peak: a 500 mA port or any adapter; no cell")]
    for i, (name, note) in enumerate(cols):
        yy = NY + 14 + i * 17
        o.append(T(40, yy, name, "lab")); o.append(T(130, yy, note, "fn"))
    o.append(T(40, NY + 128, "Never: the lamp without its resistors · a wire soldered to the brass · the motor's terminals or the reed's leads bare near the tower · the screen before its pin order is read · an iron near the acrylic.", "fn"))

    bad, crossings = rt.check()
    for b in bad:
        print("CLEARANCE:", b)
    assert not bad, f"{len(bad)} clearance failures"
    o.append(T(20, 848, f"Paper design {TODAY}, not built. {crossings} crossing(s) on this sheet. Sources: the SuperMini notes (5V = VBUS), the MX1508 datasheet and the camera Pocket AI's record of it, the SSD1306 module listing, the N20 and filament listings, the reed switch listing.", "sub"))
    return f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="Desk lighthouse wiring sheet">{SHEET_CSS}{"".join(o)}</svg>'


# ----------------------------------------------------------------------------- sheet 3: templates at actual size
def templates_sheet():
    k = W / 262.0        # the PDF prints the sheet 262 mm wide: 5.19 px per mm
    o = [T(20, 30, "Desk lighthouse: templates at actual size", "h1"),
         T(20, 48, "Print landscape on Letter at Actual size: the 50 mm bar measures 50 mm. Prick the corners and the hole centres through the paper onto the brass; drill with the pin vise, saw with the jeweler's saw, file to the line.", "sub")]

    def face(x, y, title, notes, draw):
        side = D["cube"] * k
        o.append(T(x, y - 10, title, "h2"))
        o.append(rect(x, y, x + side, y + side, "tmpl"))
        o.append(f'<line x1="{x + side/2}" y1="{y - 4}" x2="{x + side/2}" y2="{y + side + 4}" class="centre"/>')
        draw(x + side / 2, y + side)       # (centre x, the bottom edge y)
        for i, n in enumerate(notes):
            o.append(T(x, y + side + 20 + i * 14, n, "fn"))

    def front(cx, yb):
        o.append(rect(cx - D["win_w"] / 2 * k, yb - (D["win_cz"] + D["win_h"] / 2) * k, cx + D["win_w"] / 2 * k, yb - (D["win_cz"] - D["win_h"] / 2) * k, "tmplhole"))
        o.append(T(cx, yb - D["win_cz"] * k + 4, f"{D['win_w']:.0f} × {D['win_h']:.1f}", "dimlab", "middle"))

    def back(cx, yb):
        o.append(rect(cx - D["usb_w"] / 2 * k, yb - (D["usb_cz"] + D["usb_h"] / 2) * k, cx + D["usb_w"] / 2 * k, yb - (D["usb_cz"] - D["usb_h"] / 2) * k, "tmplhole"))
        o.append(T(cx, yb - (D["usb_cz"] + D["usb_h"] / 2) * k - 5, f"USB-C {D['usb_w']:.1f} × {D['usb_h']:.1f}, centre {D['usb_cz']:.0f} up", "dimlab", "middle"))
        bx = cx - D["btn_x"] * k
        o.append(circ(bx, yb - D["btn_cz"] * k, D["btn_hole"] / 2 * k, "tmplhole"))
        o.append(T(bx + 14, yb - D["btn_cz"] * k + 4, f"button Ø{D['btn_hole']:.1f}, {D['btn_cz']:.0f} up", "dimlab"))

    def side(cx, yb):
        o.append(circ(cx, yb - D["pin_z"] * k, (D["pin_d"] + 0.1) / 2 * k, "tmplhole"))
        o.append(T(cx + 10, yb - D["pin_z"] * k - 6, f"pin Ø1.6, {D['pin_z']:.0f} up", "dimlab"))
        o.append(f'<line x1="{cx - 60}" y1="{yb - D["tube_bot"] * k}" x2="{cx + 60}" y2="{yb - D["tube_bot"] * k}" class="ghost"/>')
        o.append(T(cx - 94, yb - D["tube_bot"] * k + 14, f"tower's foot, {D['tube_bot']:.0f} up", "fn"))

    face(60, 120, "Front face", ["the window; its centre is drawn 11 mm up:", "mark it from the lit screen before sawing"], front)
    face(310, 120, "Back face, seen from outside", ["the controller's USB-C slot and the button;", "the button sits 11 mm off centre, to your left from behind"], back)
    face(560, 120, "Side faces, both", ["one 1.6 mm hole each for the brass pin, drilled", "through the tower too once it is in place"], side)
    # the lid
    lx, ly = 810, 120
    ls = D["lid"] * k
    o.append(T(lx, ly - 10, "Lid plate", "h2"))
    o.append(rect(lx, ly, lx + ls, ly + ls, "tmpl"))
    o.append(circ(lx + ls / 2, ly + ls / 2, (D["tower_od"] + 0.2) / 2 * k, "tmplhole"))
    o.append(T(lx + ls / 2, ly + ls / 2 + 4, "Ø25.2", "dimlab", "middle"))
    o.append(T(lx, ly + ls + 20, f"{D['lid']:.1f} square, 0.8 mm brass; saw the hole", "fn")); o.append(T(lx, ly + ls + 34, "from a 3 mm pilot, file to the tube", "fn"))
    # the deck
    dx, dy = 1140, 120 + D["deck_d"] / 2 * k
    o.append(T(1040, 110, "Gallery deck (check ring)", "h2"))
    o.append(circ(dx, dy, D["deck_d"] / 2 * k, "tmpl"))
    o.append(circ(dx, dy, D["deck_hole"] / 2 * k, "tmplhole"))
    o.append(circ(dx, dy, D["glass_od"] / 2 * k, "ghost")); o.append(circ(dx, dy, D["drum_od"] / 2 * k, "ghost"))
    o.append(circ(dx, dy + D["reed_r"] * k, D["reed_hole"] / 2 * k, "tmplhole"))
    o.append(circ(dx, dy - D["ast_r"] * k, D["ast_od"] / 2 * k, "tmplhole"))
    o.append(f'<line x1="{dx}" y1="{dy - 104}" x2="{dx}" y2="{dy + 104}" class="centre"/>')
    o.append(T(dx + 12, dy + D["reed_r"] * k + 4, "reed Ø3, front", "dimlab")); o.append(T(dx + 14, dy - D["ast_r"] * k + 4, "astragal Ø4, back", "dimlab"))
    o.append(T(dx + 34, dy + 4, "Ø11 (as bought)", "dimlab"))
    o.append(T(1040, dy + 120, "dashed: the glass Ø25 and the drum Ø15.9", "fn")); o.append(T(1040, dy + 134, "a 2 mm notch in the tower's rim sits under", "fn")); o.append(T(1040, dy + 148, "the astragal's hole, at the back", "fn"))
    # the drum's flat pattern and its floor
    px, py = 60, 420
    pw, ph = D["drum_circ"] * k, D["drum_h"] * k
    o.append(T(px, py - 10, "The shutter, unrolled: 5/8 in brass tube", "h2"))
    o.append(rect(px, py, px + pw, py + ph, "tmpl"))
    wx0 = px + (pw - D["win_arc"] * k) / 2
    o.append(rect(wx0, py + ph - (D["dwin_z0"] + D["dwin_h"]) * k, wx0 + D["win_arc"] * k, py + ph - D["dwin_z0"] * k, "tmplhole"))
    o.append(T(px + pw / 2, py + ph / 2 + 4, f"{D['win_arc']:.1f} × {D['dwin_h']:.0f}", "dimlab", "middle"))
    o.append(dim_h(px, px + pw, py + ph + 14, f"{D['drum_circ']:.1f} round · {D['drum_h']:.0f} tall", False))
    o.append(T(px, py + ph + 44, f"The window is {D['win_deg']:.0f}°, {D['dwin_z0']:.0f} up from the floor end. Wrap the strip round", "fn"))
    o.append(T(px, py + ph + 58, "the tube, prick the window's corners, saw and file.", "fn"))
    fx, fy = 400, py + 44
    o.append(circ(fx, fy, D["drum_od"] / 2 * k - D["drum_wall"] * k, "tmpl")); o.append(circ(fx, fy, D["hub_od"] / 2 * k, "tmplhole"))
    o.append(T(fx, fy + 62, "floor Ø15.2, hub hole Ø4", "fn", "middle"))
    o.append(circ(fx + 170, fy, D["hub_od"] / 2 * k, "tmplhole")); o.append(circ(fx + 170, fy, D["drum_od"] / 2 * k - D["drum_wall"] * k, "ghost"))
    o.append(f'<line x1="{fx + 170}" y1="{fy - 50}" x2="{fx + 170}" y2="{fy + 50}" class="centre"/>')
    o.append(T(fx + 170, fy + 62, f"magnet at r {D['mag_r']:.0f}, under the floor,", "fn", "middle")); o.append(T(fx + 170, fy + 76, "toward the window's middle", "fn", "middle"))
    o.append(circ(fx + 170, fy + D["mag_r"] * k, D["mag_d"] / 2 * k, "mag"))
    # scale bar
    sx, sy = 700, 470
    o.append(f'<path d="M{sx},{sy - 8} L{sx},{sy + 8} M{sx + 50*k},{sy - 8} L{sx + 50*k},{sy + 8} M{sx},{sy} L{sx + 50*k},{sy}" class="cut"/>')
    o.append(T(sx + 25 * k, sy - 14, "50 mm: check it with a ruler", "dimlab", "middle"))
    o.append(T(700, 520, "Order of work", "h2"))
    steps = ["1. Cut the cube, the tower, the glass and the drum; file every end square. Drill the faces from these",
             "    templates with the pin vise; saw the window and the slot from pilot holes and file to the line.",
             "2. Solder the drum's floor and hub; saw its window. Glue the magnet under the floor. Fit the drum on the",
             "    motor's shaft on the bench and run it from the supply.",
             "3. Drill the deck (reed, astragal); glue the reed in, 2.5 mm down. Wire the motor, fit it as a plug in the",
             "    tower's top, glue the deck on the tower's rim with a bead inside.",
             "4. Hang the filament from the nut and wire it down the astragal; glue the glass to the deck and the cap over",
             "    it; the nipple and the ball. Mask the tower's ends, spray it ivory, dry overnight.",
             "5. Glue the cube to the coaster, the screen inside; boards in; pin the tower through the lid. Flash over the",
             "    cable it runs on; set the index; washers in the coaster's hollow; the meter checks on the record."]
    for i, st in enumerate(steps):
        o.append(T(700, 542 + i * 15, st, "fn"))
    o.append(T(20, 848, f"Paper design {TODAY}. The faces assume a 38.1 mm cube with 1.57 mm walls and the lid set 0.8 mm down; the deck assumes the 1-1/2 in check ring. Measure the real parts and rerun the script before cutting.", "sub"))
    return f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="Desk lighthouse templates at actual size">{SHEET_CSS}{"".join(o)}</svg>'


# ----------------------------------------------------------------------------- page
def md_inline(t):
    t = esc(t).replace("&amp;lt;", "&lt;").replace("&amp;gt;", "&gt;")
    t = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+|\.\./[^)\s]+)\)", r'<a href="\2" target="_blank" rel="noopener">\1</a>', t)
    t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
    return re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", t)


def a(text, key):
    return f'<a href="{L[key]}" target="_blank" rel="noopener">{text}</a>'


def intro_html():
    return f"""
<h2>What it is</h2>
<p>A lighthouse for the desk, {D['height']:.0f} mm tall. An ivory tower, a {a("brass tube", "tube25")} sprayed canvas white, stands on a brass cube cut from {a("square brass tube", "sqtube")}, on the same {a("brass coaster", "coaster")} the satellite stands on. On top, a lantern of {a("clear acrylic", "acrylic")} between a brass gallery (a lamp-maker's {a("check ring", "checkring")}) and a brass roof (a {a("vase cap", "vasecap")}), with a {a("brass ball", "ball")} for the ventilator. Inside the lantern a warm-white {a("LED filament", "filament")} hangs still from the roof, and a brass shutter cut from a {a("5/8 in tube", "tube58")} turns round it on a {a("gearmotor", "motor")} hidden in the tower's top: one revolution in {E['period']:.1f} s, a {E['pass_s']:.1f} s sweep of light across the room, then brass. A {a("reed switch", "reed")} in the deck and a {a("magnet", "magnet")} under the shutter's floor tell the firmware where the window is, so when you turn rotation off it parks facing you, and when the lamp goes off it closes.</p>
<p>In the cube's front, where a lighthouse has its door, the owned white {a("0.96 in screen", "oled")} shows one line at a time through a window cut in the brass: the time, the light's characteristic measured live (Fl W {E['period']:.1f}s), and a keeper's log line written each day by the desktop's Ollama through the Pocket AI server. The owned {a("ESP32-C3 SuperMini", "controller")} and the owned {a("MX1508 driver", "hbridge")} lie inside the cube; the controller's USB-C through the back is power, flashing and console. One button, in the back. No cell.</p>
<p>The reference is Huy Vector's <a href="{L['reference']}" target="_blank" rel="noopener">Lighthouse Desk Lamp</a>: a parts list (brass sheet and tube, copper wire, a 3 V 30 rpm gear motor, a 39 mm Edison filament, a glass fuse, a Type-C charging module, a bamboo coaster) and no more. Ours keeps the idea, a small brass lighthouse on a coaster with a motor and a filament, and is its own build otherwise.</p>
<p><strong>This page is step 1 of the house rule: the final build first, for approval.</strong> One form sheet, one wiring sheet, one sheet of templates at actual size, every part and every pin. Brass at the builder's word for this build. Nothing bought, cut or soldered. Say yes, or what to change; then step 2, the physics and engineering page, follows.</p>
"""


def decisions_html():
    o = ["<h2>The decisions</h2>"]
    for head, text in DECISIONS:
        o.append(f"<h3>{esc(head)}</h3><p>{md_inline(text)}</p>")
    return "".join(o)


def dims_rows():
    return [("height", "overall height, desk to the top of the ball"), ("disc_d", "brass coaster, diameter"), ("disc_t", "brass coaster, height"),
            ("cube", "cube, each side"), ("cube_wall", "cube wall"), ("lid", "lid plate, square"), ("lid_t", "lid plate thickness"), ("lid_inset", "lid set down from the cube's top"),
            ("win_w", "window in the front face, width"), ("win_h", "window, height"), ("win_cz", "window centre above the coaster"),
            ("usb_w", "USB-C slot in the back face, width"), ("usb_h", "USB-C slot, height"), ("usb_cz", "USB-C slot centre above the coaster"),
            ("btn_cz", "button hole centre above the coaster"), ("btn_x", "button hole off centre"), ("btn_hole", "button hole"),
            ("tube_bot", "tower's foot above the coaster"), ("pin_z", "brass pin above the coaster"), ("tube_len", "tower, cut length"),
            ("tower_od", "tower, outside"), ("tower_wall", "tower wall"), ("tower_show", "tower showing, cube top to deck"),
            ("deck_d", "gallery deck, diameter"), ("deck_t", "gallery deck, thickness (measure)"), ("deck_hole", "deck's centre hole (as bought)"),
            ("glass_od", "lantern glass, outside"), ("glass_wall", "lantern glass wall"), ("glass_h", "lantern glass, cut length"), ("cap_rim", "lantern glass showing under the cap"),
            ("cap_d", "roof (vase cap), diameter"), ("cap_h", "roof, height (measure)"), ("ast_top", "astragal, deck top to the cap's inside"),
            ("drum_od", "shutter drum, outside"), ("drum_wall", "shutter drum wall"), ("drum_h", "shutter drum, height"), ("drum_z0", "drum's bottom edge above the deck"),
            ("win_deg", "shutter window, degrees"), ("win_arc", "shutter window, width on the tube"), ("dwin_h", "shutter window, height"),
            ("hub_h", "hub, length"), ("shaft_tip", "motor shaft above the deck"), ("mag_r", "magnet from the axis"), ("reed_r", "reed from the axis"), ("reed_down", "reed's top below the deck's top"),
            ("fil_l", "filament, length"), ("fil_top", "filament top above the deck"), ("fil_bot", "filament bottom above the deck"), ("nut_bot", "nut's underside above the deck"),
            ("ball_d", "ventilator ball"), ("nip_l", "nipple, length")]


def dims_html():
    o = ['<h2>Dimensions</h2><div class="tw"><table><tr><th>What</th><th>mm</th></tr>']
    o += [f'<tr><td>{esc(lab)}</td><td class="m">{D[k]:.1f}</td></tr>' for k, lab in dims_rows()]
    o.append("</table></div>")
    o.append("<h3>Mass</h3>")
    o.append('<div class="tw"><table><tr><th>Part</th><th>g</th></tr>' + "".join(f'<tr><td>{esc(n)}</td><td class="m">{m:.1f}</td></tr>' for n, m, _ in MASS) + f'<tr><td><strong>Total, before the ballast</strong></td><td class="m"><strong>{D["mass"]:.0f}</strong></td></tr></table></div>')
    o.append(f"<p>Centre of mass {D['cg']:.0f} mm up: it tips at {D['tip_deg']:.0f}°, a {D['push_n']:.1f} N push at the ball. With about {D['ballast_g']:.0f} g of steel washers hot-glued into the coaster's hollow: {D['cg_b']:.0f} mm, {D['tip_deg_b']:.0f}°, {D['push_n_b']:.1f} N. The coaster's mass is the listing's; the rest is computed from the drawings or estimated; weigh them.</p>")
    return "".join(o)


def pins_html():
    o = ['<h2>Pin map, ESP32-C3 SuperMini</h2>',
         '<p>Nine pins of the sixteen. The button keeps the family\'s GPIO10; I²C goes on GPIO4 and 5, not the board\'s default 8 and 9, which are strapping pins; no strapping pin is wired.</p>',
         '<div class="tw"><table><tr><th>Pin</th><th>Job</th><th>Goes to</th></tr>']
    for p, job, to, net in PINS:
        o.append(f'<tr><td class="m">{esc(p)}</td><td>{esc(job)}</td><td>{esc(to)}</td></tr>')
    o.append("</table></div>")
    o.append('<h3>Driver board pads</h3><p>Used: <code>VCC</code> (+) and <code>GND</code> (the 5 V rail), <code>IN1</code> <code>IN2</code> (channel A, the shutter), <code>IN3</code> (channel B, the lamp), <code>IN4</code> (tied to GND), <code>OUT1</code> <code>OUT2</code> (the motor), <code>OUT3</code> <code>OUT4</code> (the lamp through its resistors). The header and the two screw terminals come off; wires go on the pads.</p>')
    return "".join(o)


def nets_html():
    o = ['<h2>Every wire, and why</h2>', '<div class="tw"><table><tr><th>Net</th><th>From</th><th>To</th><th>Wire</th><th>Why</th></tr>']
    for net, fr, to, wire, why in NETS:
        o.append(f'<tr><td class="m">{esc(net)}</td><td>{esc(fr)}</td><td>{esc(to)}</td><td>{esc(wire)}</td><td>{md_inline(why)}</td></tr>')
    o.append("</table></div>")
    return "".join(o)


def budget_html():
    rows = [("controller, Wi-Fi connected", E["c3_avg"], "average; a transmit burst is about 300 mA for milliseconds"),
            ("screen", E["oled"], "half the pixels lit"),
            ("motor, turning", E["mot_ma"] * E["duty_mot"], f"{E['mot_ma']:.0f} mA at {E['duty_mot'] * 100:.0f} % duty; a jam would draw about {E['mot_stall']:.0f} mA until the firmware notices"),
            ("lamp, everyday", E["i_lamp"], f"{E['lamp_duty'] * 100:.0f} % of {E['i_lamp_max']:.0f} mA"),
            ("lamp, full", E["i_lamp_max"], f"{E['lamp_w'] * 1000:.0f} mW in the lantern; {E['p_res_each'] * 1000:.0f} mW in each resistor"),
            ("driver, quiescent", E["mx_q"], "")]
    o = ['<h2>The budget</h2>', '<div class="tw"><table><tr><th>Load</th><th class="m">mA at 5 V</th><th>Note</th></tr>']
    o += [f'<tr><td>{esc(n)}</td><td class="m">{v:.0f}</td><td>{esc(s_)}</td></tr>' for n, v, s_ in rows]
    o.append("</table></div>")
    o.append(f"<p>Together {E['typ']:.0f} mA typical and {E['peak']:.0f} mA at the worst moment (a radio burst, the lamp full, the motor turning), inside a 500 mA USB port and far inside any phone adapter. The one USB-C cable is the only cord. No cell: a desk has a cable, and a cell would last a single evening against a motor and a lamp.</p>")
    o.append(f"<p>Speed: a 30 rpm (6 V) gearmotor runs about {E['rpm_5v']:.0f} rpm on 5 V; {E['duty_mot'] * 100:.0f} % duty gives {E['rpm_target']:.0f} rpm, {E['period']:.1f} s a revolution, a {E['pass_s']:.1f} s pass of the {D['win_deg']:.0f}° window. The reed's period closes the loop, so the number holds whatever the motor's batch.</p>")
    return "".join(o)


def parts_html():
    o = ['<h2>Parts</h2>', '<p>Seventeen lines to buy, in three orders: eleven on Amazon, five lamp parts from Grand Brass (none of them is on Amazon), one piece of square brass tube from Online Metals (nothing this size is on Amazon). The controller, the screen, the driver, the small brass tube, the rod, the wire and the paint are in a drawer and listed so they are not bought twice. Each part is named by what it is, with the link on the word to the exact product. Amazon refuses automated reads, so its prices are not given: read them on the page.</p>']
    for head, rows in PARTS:
        o.append(f"<h3>{esc(head)}</h3>")
        o.append('<div class="tw"><table><tr><th>Qty</th><th>Part</th><th>Where</th><th>Price</th><th>Why, and what to check</th></tr>')
        for qty, part, url, code, where, why in rows:
            name = f'<a href="{url}" target="_blank" rel="noopener">{esc(part)}</a>' if url else esc(part)
            o.append(f'<tr><td class="m">{esc(qty)}</td><td>{name}</td><td>{esc(code)}</td><td class="m">{esc(where)}</td><td>{md_inline(why)}</td></tr>')
        o.append("</table></div>")
    return "".join(o)


def firmware_html():
    o = ['<h2>What the firmware needs</h2>', '<p>Not written yet; listed so the pin map above is known to be enough.</p><ul>']
    o += [f"<li>{md_inline(x)}</li>" for x in FIRMWARE]
    o.append("</ul>")
    return "".join(o)


def checks_html():
    o = ['<h2>Before power, with the meter</h2><ul class="check">']
    o += [f"<li>{md_inline(x)}</li>" for x in CHECKS]
    o.append("</ul>")
    return "".join(o)


def rules_html():
    return """
<h2>Rules this build follows</h2>
<ul>
<li>Design first: sleek, few lines (one tower, one astragal), wires inside the tower and the astragal, boards inside the cube.</li>
<li>Colour: brass, ivory and warm white; black only in the screen's glass; the screen's blue board, the controller and the driver hidden in the cube; the filament's yellow phosphor hidden by the shutter when off.</li>
<li>Component names with the link on the word; no product codes in prose.</li>
<li>Owned parts stay off the shopping list: the controller, the screen and the driver are Pocket AI stock, the small brass tube and the rod are shared stock, the paint is Pip's.</li>
<li>Every wire on the sheet is traceable pin to pin; the generator checks clearance and counts crossings (zero).</li>
<li>Brass at the builder's word for this build (2026-11-07); the family's rule since the drone is stainless, so say if that should change.</li>
<li>Meter only what matters: three checks before power.</li>
</ul>
"""


def page_html(form_svg, wiring_svg, tmpl_svg):
    return "\n".join([
        '<title>Desk Lighthouse Build</title>',
        '<meta name="claude:viewport-fit-sides" content="cover">',
        '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Public+Sans:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;700&display=swap">',
        f"<style>{STYLE}</style>",
        f"<style>{PAGE_TONES}</style>",
        '<style>.wrap{max-width:1100px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))} figure.sheet{padding:8px} figure.sheet svg{width:100%;height:auto} '
        'td,th{min-width:0} .tw table{min-width:720px}</style>',
        '<div class="wrap">',
        '<div class="masthead"><div class="eyebrow">Desk lighthouse &middot; step 1: the final build &middot; Rev A, for approval</div>',
        '<h1>A brass lighthouse whose lamp stands still while the brass turns</h1>',
        f'<div class="sub">How it looks, how it is wired, every part and every pin. {D["height"]:.0f} mm tall on a Ø{D["disc_d"]:.0f} brass coaster, about {D["mass"]:.0f} g before the ballast. Paper design of {TODAY}. Nothing bought or built.</div></div>',
        intro_html(),
        f'<figure class="sheet">{form_svg}<figcaption><strong>Form sheet. Print landscape on Letter at Actual size; it is page 1 of the PDF.</strong> The front view; a section through the lantern and the tower\'s top showing the fixed lamp, the turning shutter, the reed and the motor; the plan looking down into the lantern; a section through the cube; how it behaves; the key numbers.</figcaption></figure>',
        decisions_html(),
        f'<figure class="sheet">{wiring_svg}<figcaption><strong>Wiring sheet, page 2 of the PDF.</strong> The screen on the left, the controller and the driver in the middle, the motor and the lamp on the right, the reed, the button and the adapter below, the budget along the bottom. Thick lines are wires you solder, thin ones the leads that come with a part; dots are joints; zero crossings.</figcaption></figure>',
        f'<figure class="sheet">{tmpl_svg}<figcaption><strong>Templates at actual size, page 3 of the PDF.</strong> Printed at Actual size, the 50 mm bar measures 50 mm: the cube\'s three drilled faces, the lid plate, the gallery deck\'s two holes and the shutter unrolled with its window, plus the order of work.</figcaption></figure>',
        dims_html(),
        pins_html(),
        nets_html(),
        budget_html(),
        parts_html(),
        firmware_html(),
        checks_html(),
        rules_html(),
        f'<h2>For approval</h2><p>Rev A, {TODAY}. The form, the wiring and the parts as drawn. Two things are drawn at the usual size for their lamp part and must be measured when they come: the check ring\'s thickness (3 mm) and the vase cap\'s height (12.5 mm); the glass\'s cut length and the astragal follow from them, and the script recomputes them. Say yes, or what to change: the ivory tower against a bare brass one, the cube against a plain foot, the 2700 K lamp against the family\'s 2200 K spare, the corded supply against a cell. Then step 2, the physics and engineering page, follows.</p>',
        f'<hr><p class="sub">Built by <code>docs/pages/gen/build_page.py</code>, which also writes <code>docs/FINAL_BUILD.md</code> and the PDFs; the dimensions, pins, nets, budget and parts live in that script. The wiring sheet\'s clearance check passes, and the lantern\'s clearances (drum in the glass, magnet in the drum, reed beside the motor, filament over the floor, shutter under the roof) are asserted. Sources read {TODAY}: the reference page, the Amazon, Grand Brass and Online Metals listings, the SuperMini notes, the MX1508 and SSD1306 datasheets, the family\'s inventories. Nothing measured.</p>',
        '</div>'])


def final_build_md():
    o = ["# Desk lighthouse: the final build (step 1, Rev A, for approval)", "",
         f"Paper design of {TODAY}. An ivory tower (a 25 × 0.5 mm brass tube sprayed canvas white) on a brass cube (1.5 in square brass tube, {D['cube']:.0f} mm on a side) on the satellite's 75 × 8 mm brass coaster; on top a clear acrylic lantern Ø25 between a 1-1/2 in turned brass check ring (the gallery) and a 1-1/2 in spun brass vase cap (the roof), with a 5/8 in brass ball. Inside the lantern a 26 mm warm-white LED filament hangs still from the roof's nut and a brass shutter cut from a 5/8 in tube turns round it on an N20 gearmotor hidden in the tower's top, one revolution in {E['period']:.1f} s; a reed switch in the deck and a magnet under the shutter's floor are its index, so it parks facing you and closes when the lamp is off. In the cube's front the owned white 0.96 in OLED shows one line at a time through a window in the brass. The owned ESP32-C3 SuperMini and MX1508 driver lie in the cube; USB-C through the back. {D['height']:.0f} mm tall, about {D['mass']:.0f} g before {D['ballast_g']:.0f} g of steel goes into the coaster. **Nothing bought or built.**",
         "", "Generated by `pages/gen/build_page.py`, which also writes the page `pages/desk-lighthouse-build.html` and the PDFs in `pages/print/`; edit the script, not this file. The sheets are the authority for the drawing; this file carries the same decisions, dimensions, pin map, nets, budget and parts as text.", "",
         "## The reference", "",
         f"Huy Vector, [Lighthouse Desk Lamp]({L['reference']}), read {TODAY}. The page is a parts list and nothing else: 0.2 × 100 × 100 mm brass sheet, 4 mm brass tube, 1 mm copper wire, a 3 V 30 rpm DC gear motor, a 39 mm LED Edison filament, a 6 × 30 mm glass fuse, a Type-C 4.2 V charging module, a battery, an 8 cm bamboo coaster; no dimensions, no prose, no video. Ours keeps the idea (a small brass lighthouse on a coaster, a gear motor turning something in the lantern, an LED filament as the lamp) and is its own build otherwise: a fixed lamp and a turning brass shutter, a reed index so it parks, a live text plaque in the cube, USB power, lamp parts instead of rolled sheet.",
         "", "## The decisions", ""]
    for head, text in DECISIONS:
        o += [f"### {head}", "", text, ""]
    o += ["## Dimensions", "", "| What | mm |", "| --- | ---: |"]
    o += [f"| {lab} | {D[k]:.1f} |" for k, lab in dims_rows()]
    o += ["", "| Part | g |", "| --- | ---: |"] + [f"| {n} | {m:.1f} |" for n, m, _ in MASS] + [f"| **Total, before the ballast** | **{D['mass']:.0f}** |", "",
          f"Centre of mass {D['cg']:.0f} mm up; tips at {D['tip_deg']:.0f}°, a {D['push_n']:.1f} N push at the ball. With about {D['ballast_g']:.0f} g of steel in the coaster's hollow: {D['cg_b']:.0f} mm, {D['tip_deg_b']:.0f}°, {D['push_n_b']:.1f} N.", "",
          "## Pin map, ESP32-C3 SuperMini", "", "| Pin | Job | Goes to |", "| --- | --- | --- |"]
    o += [f"| {p} | {job} | {to} |" for p, job, to, net in PINS]
    o += ["", "Driver board pads used: `VCC` (+) and `GND` (the 5 V rail), `IN1` `IN2` (channel A, the shutter), `IN3` (channel B, the lamp), `IN4` (tied to GND), `OUT1` `OUT2` (the motor), `OUT3` `OUT4` (the lamp through its resistors). The header and the screw terminals come off; wires go on the pads.", ""]
    o += ["## Every wire, and why", "", "| Net | From | To | Wire | Why |", "| --- | --- | --- | --- | --- |"]
    o += [f"| {n} | {fr} | {to} | {wire} | {why} |" for n, fr, to, wire, why in NETS]
    o += ["", "## The budget", "",
          f"From the 5 V rail: controller {E['c3_avg']:.0f} mA average with Wi-Fi connected ({E['c3_peak']:.0f} in a burst), screen {E['oled']:.0f}, motor {E['mot_ma'] * E['duty_mot']:.0f} turning ({E['mot_ma']:.0f} at {E['duty_mot'] * 100:.0f} % duty), lamp {E['i_lamp']:.0f} everyday and {E['i_lamp_max']:.0f} full ({E['lamp_w'] * 1000:.0f} mW in the lantern, {E['p_res_each'] * 1000:.0f} mW in each resistor), driver {E['mx_q']:.0f}. Together {E['typ']:.0f} mA typical, {E['peak']:.0f} at the worst moment: a 500 mA port does it. Speed: {E['rpm_5v']:.0f} rpm free on 5 V, {E['rpm_target']:.0f} rpm at {E['duty_mot'] * 100:.0f} % duty, {E['period']:.1f} s a revolution, a {E['pass_s']:.1f} s pass of the {D['win_deg']:.0f}° window; the reed's period closes the loop.", ""]
    o += ["## Parts", "", "Seventeen lines to buy in three orders: eleven on Amazon, five lamp parts from Grand Brass, one piece of square brass tube from Online Metals (neither the lamp parts nor the square tube exist on Amazon). Everything else is owned and listed so it is not bought twice. Amazon refuses automated reads, so its prices are not given.", ""]
    for head, rows in PARTS:
        o += [f"### {head}", "", "| Qty | Part | Where | Price | Why, and what to check |", "| ---: | --- | --- | --- | --- |"]
        for qty, part, url, code, where, why in rows:
            name = f"[{part}]({url})" if url else part
            o.append(f"| {qty} | {name} | {code} | {where} | {why} |")
        o.append("")
    o += ["## What the firmware needs", ""] + [f"- {x}" for x in FIRMWARE] + ["", "## Before power, with the meter", ""] + [f"- {x}" for x in CHECKS]
    o += ["", "## Rules this build follows", "",
          "- Design first: sleek, few lines (one tower, one astragal), wires inside the tower and the astragal, boards inside the cube.",
          "- Colour: brass, ivory and warm white; black only in the screen's glass; every coloured board hidden in the cube; the filament's yellow phosphor hidden by the shutter when off.",
          "- Component names with the link on the word; no product codes in prose.",
          "- Owned parts stay off the shopping list (the controller, the screen, the driver, the small brass tube, the rod, the wire, the paint).",
          "- Every wire on the sheet is traceable pin to pin; the generator checks clearance and counts crossings (zero).",
          "- Brass at the builder's word for this build (2026-11-07); the family's rule since the drone is stainless.",
          "- Meter only what matters: three checks before power.", "",
          "## For approval", "",
          f"Rev A, {TODAY}: the form, the wiring and the parts as drawn. The check ring's thickness (drawn 3 mm) and the vase cap's height (drawn 12.5 mm) are the usual sizes for those lamp parts and must be measured when they come; the glass's cut length and the astragal follow from them and the script recomputes them. Open questions for the builder: the ivory tower against a bare brass one; the cube against a plain foot; the 2700 K lamp against the family's 2200 K spare; the corded supply against a cell (which wants a Ø32 tower or a taller base). Then step 2, the physics and engineering page.", ""]
    return "\n".join(o)


def print_pdf(html, form_svg, wiring_svg, tmpl_svg):
    PRINT.mkdir(exist_ok=True)
    sheet_css = ("<style>@page{size:letter landscape;margin:7mm} html,body{background:#fff;margin:0}"
                 ":root{--bg:#fff;--paper:#fff;--ink:#000;--ink-2:#333;--line:#ccc;--brass:#000;--brass-soft:#eee;--signal:#000;--signal-soft:#f1f1f1;--warn:#000;--warn-soft:#eee}"
                 + LH_PRINT + "svg{width:262mm;height:auto;display:block;margin:0 auto}</style>")
    page_css = ("<style>@page{size:letter;margin:12mm 13mm 14mm}"
                ":root{--bg:#fff;--paper:#fff;--ink:#000;--ink-2:#333;--line:#999;--brass:#000;--brass-soft:#f2f2f2;--signal:#000;--signal-soft:#f2f2f2;--ok:#000;--ok-soft:#f2f2f2;--warn:#000;--warn-soft:#f4f4f4}"
                "html,body{background:#fff!important;color:#000!important;font-size:10pt!important;line-height:1.4} .wrap{max-width:none;padding:0}"
                "figure.sheet{display:none} h2{font-size:14pt;margin-top:16pt;page-break-after:avoid} h3{font-size:9pt;margin-top:10pt} p,ul,ol{max-width:none} table{font-size:9pt} th,td{padding:4pt 6pt}"
                ".tw table{min-width:0} td.m,th.m{white-space:normal} a{color:#000;text-decoration:none} .masthead{border-bottom-width:2px;padding-bottom:8pt} h1{font-size:20pt} tr{break-inside:avoid} ul.check{break-inside:avoid}</style>")
    with tempfile.TemporaryDirectory() as d:
        d = pathlib.Path(d)
        jobs = []
        for name, svg in (("form", form_svg), ("wiring", wiring_svg), ("templates", tmpl_svg)):
            src = d / f"{name}.html"; pdf = d / f"{name}.pdf"
            src.write_text(f"<!doctype html><meta charset=utf-8><title>{name}</title>" + sheet_css + svg)
            jobs.append((src, pdf))
        p_html = d / "p.html"; p_pdf = d / "p.pdf"
        head, tail = html.rsplit("</style>", 1)
        p_html.write_text("<!doctype html><meta charset=utf-8>" + head + "</style>" + page_css + tail)
        jobs.append((p_html, p_pdf))
        for src, pdf in jobs:
            subprocess.run(["google-chrome", "--headless=new", "--disable-gpu", "--no-sandbox", "--no-pdf-header-footer",
                            f"--print-to-pdf={pdf}", f"file://{src}"], check=True, capture_output=True, timeout=180)
        out = PRINT / "desk-lighthouse-build.pdf"
        subprocess.run(["pdfunite", str(d / "form.pdf"), str(d / "wiring.pdf"), str(d / "templates.pdf"), str(p_pdf), str(out)], check=True)
        shutil.copyfile(d / "form.pdf", PRINT / "desk-lighthouse-form-sheet.pdf")
        shutil.copyfile(d / "wiring.pdf", PRINT / "desk-lighthouse-wiring-sheet.pdf")
        shutil.copyfile(d / "templates.pdf", PRINT / "desk-lighthouse-templates.pdf")
    info = subprocess.run(["pdfinfo", str(out)], capture_output=True, text=True).stdout
    print("wrote", out, [l for l in info.splitlines() if l.startswith("Pages")])


PNG_CSS = ("<style>html,body{margin:0;background:#fff}:root{--bg:#EDEBE7;--paper:#FFFFFF;--ink:#16181C;--ink-2:#5A6068;--line:#CFCBC4;"
           "--brass:#8F6114;--brass-soft:#F2E6D2;--signal:#5A6068;--signal-soft:#ECEAE6;--warn:#8F6114;--warn-soft:#F2E6D2}")


def png(svg, name, outdir, size=(1360, 860)):
    """Render one sheet to a PNG for checking by eye (not part of the outputs)."""
    outdir = pathlib.Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    src = outdir / f"{name}.html"
    src.write_text("<!doctype html><meta charset=utf-8>" + PNG_CSS + f"svg{{width:{size[0]}px;height:{size[1]}px}}</style>" + svg)
    subprocess.run(["google-chrome", "--headless=new", "--disable-gpu", "--no-sandbox", "--hide-scrollbars", f"--window-size={size[0]},{size[1]}",
                    f"--screenshot={outdir / (name + '.png')}", f"file://{src}"], check=True, capture_output=True, timeout=120)


def main():
    # the clearances the drawing relies on
    gi = D["glass_od"] / 2 - D["glass_wall"]
    assert D["drum_od"] / 2 + 1.5 < gi, "the drum must turn inside the glass with 1.5 mm to spare"
    assert D["mag_r"] + D["mag_d"] / 2 <= D["drum_od"] / 2 - D["drum_wall"] + 0.01, "the magnet must sit under the floor, inside the drum's wall"
    assert D["reed_r"] - D["reed_hole"] / 2 > D["mot_t"] / 2 + 0.4, "the reed's hole must clear the motor's body"
    assert D["reed_r"] - D["reed_hole"] / 2 > D["deck_hole"] / 2 + 0.3, "the reed's hole must clear the deck's centre hole"
    assert abs(D["reed_r"] - D["mag_r"]) <= D["mag_d"] / 2 + 0.5, "the magnet must pass over the reed's end"
    assert D["fil_bot"] > D["floor_top"] + 3, "the filament must hang clear of the drum's floor"
    assert D["fil_top"] < D["nut_bot"], "the filament hangs below the nut"
    assert D["drum_top"] + 1 < cap_z_at_r(D["drum_od"] / 2), "the shutter must turn under the roof"
    assert D["drum_top"] > D["fil_top"] - 1, "the shutter must cover the lamp"
    assert D["ast_r"] + D["ast_od"] / 2 < D["deck_d"] / 2 - 2, "the astragal's hole leaves 2 mm of deck outside it"
    assert D["ast_r"] - D["ast_od"] / 2 >= D["glass_od"] / 2 - 0.01, "the astragal stands outside the glass"
    assert D["ast_r"] + D["ast_od"] / 2 < D["cap_d"] / 2 - 1, "the astragal hides under the roof's rim"
    assert D["hub_h"] > D["shaft_tip"] + 2 and D["shaft_tip"] > D["floor_top"] + 2, "the shaft reaches well into the hub"
    assert D["reed_down"] + D["reed_l"] < D["deck_t"] + D["mot_l"], "the reed hangs no lower than the motor"
    assert D["oled_t"] + 0.5 < (D["cube_in"] - D["tower_od"]) / 2, "the screen stands between the tower's foot and the front face"
    assert D["oled_w"] < D["cube_in"] - 1 and D["oled_h"] < D["cube"] - D["lid_inset"] - D["lid_t"] - 1, "the screen fits the cube"
    assert D["mx_t"] + 0.4 + 1.0 + 3.2 < D["tube_bot"] - 2, "the boards stack under the tower's foot"
    assert D["mx_t"] + 0.4 + 1.0 < D["usb_cz"] < D["mx_t"] + 0.4 + 1.0 + 3.2, "the USB-C slot is at the connector's height"
    assert D["win_w"] > D["aa_w"] + 1 and D["win_h"] > D["aa_h"] + 1, "the window clears the picture"
    assert D["pin_z"] - D["tube_bot"] >= 4, "the pin sits 4 mm or more above the tower's end"
    assert D["lid"] < D["cube_in"] and D["lid"] > D["tower_od"] + 6, "the lid fits inside the cube round the tower"
    assert D["nut_d"] / 2 < D["cap_hole"] / 2 + 3 or True
    assert E["i_lamp_max"] < E["fil_rated"], "the lamp's full current stays under its rating"
    assert E["p_res_each"] < 0.25 * 0.5, "each resistor under half its rating"
    assert E["peak"] < 500, "the worst moment fits a USB port"
    form_svg, wiring_svg, tmpl_svg = form_sheet(), wiring_sheet(), templates_sheet()
    html = page_html(form_svg, wiring_svg, tmpl_svg)
    OUT.write_text(html)
    (DOCS / "FINAL_BUILD.md").write_text(final_build_md())
    print("wrote", OUT, OUT.stat().st_size, "and", DOCS / "FINAL_BUILD.md")
    print(f"numbers: height {D['height']:.1f}, mass {D['mass']:.1f} g, cg {D['cg']:.1f}, tip {D['tip_deg']:.1f} ({D['push_n']:.2f} N); with ballast cg {D['cg_b']:.1f}, tip {D['tip_deg_b']:.1f} ({D['push_n_b']:.2f} N); "
          f"glass {D['glass_h']}, astragal {D['ast_top']}, tube {D['tube_len']}, filament {D['fil_bot']:.1f}-{D['fil_top']:.1f}, nut {D['nut_bot']:.1f}, shaft tip {D['shaft_tip']:.1f}; "
          f"lamp {E['i_lamp_max']:.0f} mA ({E['lamp_w']*1000:.0f} mW), duty {E['duty_mot']*100:.0f} %, period {E['period']:.1f} s, typ {E['typ']:.0f} peak {E['peak']:.0f} mA")
    if "--png" in sys.argv:
        outdir = sys.argv[sys.argv.index("--png") + 1]
        png(form_svg, "form", outdir)
        png(wiring_svg, "wiring", outdir)
        png(tmpl_svg, "templates", outdir)
        print("png in", outdir)
    if "--pdf" in sys.argv:
        print_pdf(html, form_svg, wiring_svg, tmpl_svg)


if __name__ == "__main__":
    main()
