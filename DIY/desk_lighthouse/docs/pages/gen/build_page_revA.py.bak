# ----------------------------------------------------------------------------- the decisions
DECISIONS = [
    ("A lighthouse at a glance: disc, cube, tower, lantern, roof",
     f"Five solids and two diameters. A brass coaster Ø75; a brass cube {D['cube']:.0f} mm on a side with white text glowing in its front; an ivory tower Ø25, {D['tower_show']:.0f} mm tall; a glass lantern Ø25 between a brass deck and a brass roof, both Ø{D['deck_d']:.0f}; a brass ball on top. {D['height']:.0f} mm tall, about {D['mass']:.0f} g before the ballast. Everything that is 38 mm is brass and everything that is 25 is tower, so the eye reads a rhythm, not a kit of parts. No railing, no stripes, no door, no rocks."),
    ("The lamp stands still and the brass turns round it",
     f"A real lighthouse does not spin its lamp; the lens turns round a fixed light. Here the lamp is a {D['fil_l']:.0f} mm LED filament hanging from the roof, and a brass drum with a {D['win_deg']:.0f}° window turns round it on a gearmotor's shaft, one revolution in {E['period']:.1f} s: a {E['pass_s']:.1f} s sweep of light across the room, then brass. No slip rings, no wire ever moves. The motor sits inside the tower's top as a plug, under the deck; the drum rides on a 4 mm brass hub over its D shaft. When rotation is off, the window parks facing you and the lantern is a lamp. When the lamp is off, the drum closes and shows you brass."),
    ("A reed switch so it knows where the window is",
     f"A DC gearmotor has no idea where it stopped. A 3 × 1 mm magnet under the drum's floor passes 3.5 mm over the end of a glass reed switch standing in a hole in the deck, once a revolution, at the moment the window faces front. From that one pulse the firmware times each revolution and trims the PWM so it is always {E['period']:.1f} s, parks the window on you when you turn rotation off, closes the shutter by running on half a turn when the lamp goes off, and notices a jammed drum. Two wires, no sensor power, nothing visible."),
    ("Warm white, 2700 K, not the family's amber",
     f"The hologram and the satellite use a 2200 K filament as a pool of amber on brass, and eight of them are spare. A lighthouse lamp is not a pool: it is the light itself, and the rule is white or warm white. A 26 mm, 3 V, 100 mA ceramic filament at 2700 K is an incandescent lamp's colour; {E['i_lamp_max']:.0f} mA through {E['r_lamp']:.1f} Ω from the 5 V rail, {E['lamp_w'] * 1000:.0f} mW, dimmed to {E['lamp_duty'] * 100:.0f} % by day. Its phosphor is yellow when off, which is why the shutter closes over it."),
    ("The text lives in the door",
     f"Every lighthouse has a plaque at its foot: a name, a year. Ours is alive. The owned 0.96 in white OLED stands against the inside of the cube's front face with its glass in a {D['win_w']:.0f} × {D['win_h']:.1f} mm window cut in the brass, so only the 21.7 × 10.9 mm picture shows, white letters in a brass frame, {D['win_cz']:.0f} mm up: where a door would be. One line at a time, large: the time; the light's characteristic measured live from the reed (Fl W {E['period']:.1f}s); and the keeper's log, one line a day written by the desktop's own Ollama through the Pocket AI server, with a built-in list of sea lines for when the desktop is asleep. The screen's blue board, the controller and the driver are all inside the cube; nothing coloured shows."),
    ("Lamp-maker's parts as architecture",
     f"The gallery is a 1-1/2 in turned brass check ring, a solid disc with an 11 mm hole already where the shaft goes. The roof is a 1-1/2 in spun brass vase cap; the ventilator ball is a 5/8 in brass ball tapped 1/8 IP, on a 1/2 in nipple with a beaded nut inside the cap that also hangs the lamp. Five parts, about $7, from one lamp-parts house, each already the right shape and the right metal, none of it machined. Nothing is printed."),
    ("One astragal, and it carries the wires",
     f"The lantern's one glazing bar is a 4 mm brass tube standing on the deck at the back, tangent to the glass, up into the roof. The lamp's two wires run inside it, cross the cap's underside to the nut, and at the bottom come out under the deck through a 2 mm notch in the tower's rim into the tower. One line beyond the outline, and it is doing a job. From the front it is hidden behind the drum."),
    ("An ivory tower on brass",
     f"The brief is a brass build with some ivory. So the tower, the one big surface, is the ivory: a 25 × 0.5 mm brass tube sprayed with Pip's canvas white, its ends masked bare where they hide in the cube and under the deck. Everything else stays brass: coaster, cube, deck, drum, cap, ball, astragal. Light is warm white in the lantern and white on the screen; black only in the screen's glass. Brass at the builder's word for this build; the family's rule since the drone is stainless."),
    ("The cube: a square tube, a lid you lift, a pin you pull",
     f"A 1.5 in brass square tube with 1.57 mm walls, cut {D['cube']:.1f} mm long, standing glued on the coaster. Its lid is a {D['lid']:.1f} mm plate of 0.8 mm brass set 0.8 mm down on four stops, with the tower passing through its Ø25.2 hole; a 1.5 mm brass pin through both side faces and the tower's foot, {D['pin_z']:.0f} mm up, is the tower's anchor, flush and invisible in the brass. Pull the pin and the tower lifts out with the lid, and everything inside is in your hand. The cube is {D['cube']:.0f} mm, not smaller, because the screen's 27 mm board must stand beside the Ø25 tower's foot. Its own USB-C and button are in the back face."),
    ("Corded, not a cell",
     f"Every family build so far carries a 16340. This one is a lamp: a motor turning all evening and a lamp at {E['i_lamp']:.0f} mA would empty a cell in ten hours, and a desk has a cable. One USB-C into the controller's own port is power, flashing and console; {E['typ']:.0f} mA typical, {E['peak']:.0f} at the worst moment. No charger, no holder, no diode, no switch, and the tower stays Ø25. A cell version is drawn in the head only: it wants a Ø32 tower or a taller base."),
    ("One owned driver board does both jobs",
     f"The camera Pocket AI's spare MX1508 dual H-bridge: channel A is the shutter's motor with speed, brake and the parking move; channel B, with one input tied low, is a 1.5 A switch for the lamp through its resistors. Both loads get the 5 V rail, the controller's GPIOs see only logic, and there are no MOSFETs, gate resistors or flyback diodes to wire. Its header and screw terminals come off so it lies {D['mx_t']:.0f} mm flat on the coaster with the controller on top."),
    ("The coaster is the satellite's, weighted",
     f"The same 75 × 8 mm brass coaster the satellite stands on, so the two match on the desk. Alone it is 80 g under a {D['height']:.0f} mm tower and tips at {D['tip_deg']:.0f}°, a {D['push_n']:.1f} N push at the ball. About {D['ballast_g']:.0f} g of steel washers hot-glued into its hollow, under the pad, brings the centre of mass to {D['cg_b']:.0f} mm and the tip to {D['tip_deg_b']:.0f}°, {D['push_n_b']:.1f} N: a nudge, not a breath. Measure the hollow when it comes; it picks the washers."),
    ("A reference, not a copy",
     "Huy Vector's page is a parts list: 0.2 mm brass sheet, 4 mm brass tube, copper wire, a 3 V 30 rpm gear motor, a 39 mm Edison filament, a glass fuse, a Type-C charging module, a battery, a bamboo coaster. Ours keeps the idea (a small lighthouse on a coaster, a gear motor turning something in the lantern, a filament lamp, brass) and does the rest its own way: a fixed lamp and a turning brass shutter instead of whatever turns in theirs, a reed index so it parks, a live text plaque in the cube, USB power, lamp parts instead of rolled sheet. Side by side they share a silhouette and a motor."),
    ("How it sits with the family",
     f"Brass, ivory and warm white: the Pocket AIs' and Cyber Dawn's metal, the hologram's and the rover's ivory on brass, the satellite's coaster. At {D['height']:.0f} mm it is the tall one; the satellite is 159, Cyber Dawn 82, the hologram 72. Few lines: one tower, one astragal. Wires inside the tower and the astragal, boards inside the cube, the only black the screen's glass. Prototype, not product: the lid lifts, the motor pulls out, the firmware reflashes over the cable it runs on."),
]

FIRMWARE = [
    "ESP-IDF 6 for the esp32c3, a new small project beside the hologram's. Wi-Fi station for SNTP and the keeper's log; the console on USB Serial/JTAG.",
    f"LEDC: GPIO0 at 20 kHz for the motor (silent), GPIO3 at 5 kHz for the lamp. GPIO1 low for forward, high with GPIO0 high to brake. All three driven low first thing at boot.",
    f"The reed on GPIO6, interrupt on the falling edge, 5 ms debounce: period of the last revolution; a PI loop trims the motor duty to hold {E['period']:.1f} s; no pulse for twice that with the motor on = jammed, motor off, the screen says so.",
    f"Parking: on rotation off, run until the reed closes, then brake: the window faces front. On lamp off, run from the index for half a period, then brake: the shutter is closed. On lamp on, open again. Positions in NVS across a power cut are not needed: the first revolution finds the index.",
    "The button on GPIO10: short press rotation on/off; long press (1 s) lamp off, low, full. The screen shows the new state for two seconds.",
    f"The screen, SSD1306 over I²C at 0x3C (probe 0x3D), 128 × 64: one line at a time, 16 px tall, scrolling left at 24 px/s where it is too long; the time in 32 px digits on the hour and on demand; the characteristic from the measured period (Fl W {E['period']:.1f}s); the keeper's log line; the built-in list. Contrast down after 23:00.",
    "The keeper's log: a GET to the Pocket AI server (`pocket_ai_assistant/character/server`) once an hour for one line of at most 40 characters, written by Ollama's gpt-oss:20b with reasoning effort low; cached in NVS; the built-in list when the desktop is off.",
    f"First-power measurements the record wants: the 5 V rail's current in each mode (expected about {E['typ']:.0f} mA typical), the lamp's current at full (about {E['i_lamp_max']:.0f} mA) and the revolution period from the reed.",
]

CHECKS = [
    "The filament's polarity with the diode test (it lights faintly; the hole in the ceramic is +), and the screen's pin order read off its silkscreen, before any wire is soldered.",
    f"With the boards wired on the bench and the tower not yet fitted: 5 V on the driver's VCC pad, 3.3 V on the screen's VCC, and the lamp channel at full gives 2.9 to 3.1 V across the filament, about {E['i_lamp_max']:.0f} mA. Then the motor channel turns the bare motor and the brake stops it.",
    "Nothing bare against brass: tower to GND open, cube to GND open, with the motor's terminals, the reed's leads and the lamp joints in heat-shrink. The reed closes with the magnet 2 mm from its end and opens at 6. Everything else is a supplier spec and is not metered.",
]


# ----------------------------------------------------------------------------- drawing helpers
def esc(t):
    return str(t).replace("&", "&amp;").replace("<", "&lt;")


def T(x, y, s, cls="s", anchor="start", extra=""):
    return f'<text x="{x:.1f}" y="{y:.1f}" class="{cls}" text-anchor="{anchor}" {extra}>{esc(s)}</text>'


def dot(x, y, r=6):
    return f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{r}" class="joint"/>'


class Router(_Router):
    """The Pocket AI hop router plus a pin registry and the clearance check."""

    def __init__(self):
        super().__init__()
        self.pins = []

    def pin(self, x, y, net):
        self.pins.append((x, y, net))

    def check(self, min_pin=14, min_lane=14):
        bad = []
        for (x0, y0, x1, y1, n) in self.segs:
            for (px, py, pn) in self.pins:
                if pn == n:
                    continue
                if abs(x0 - x1) < 0.01 and min(y0, y1) - 2 <= py <= max(y0, y1) + 2 and abs(px - x0) < min_pin:
                    bad.append(f"vertical {n} at x={x0} passes {abs(px-x0):.0f}px from pin ({px},{py}) of {pn}")
                if abs(y0 - y1) < 0.01 and min(x0, x1) - 2 <= px <= max(x0, x1) + 2 and abs(py - y0) < min_pin:
                    bad.append(f"horizontal {n} at y={y0} passes {abs(py-y0):.0f}px from pin ({px},{py}) of {pn}")
        crossings = 0
        for i, (x0, y0, x1, y1, n) in enumerate(self.segs):
            for (a0, b0, a1, b1, m) in self.segs[:i]:
                if m == n:
                    continue
                v1, v2 = abs(x0 - x1) < 0.01, abs(a0 - a1) < 0.01
                if v1 and v2 and abs(x0 - a0) < min_lane and min(y0, y1) < max(b0, b1) and max(y0, y1) > min(b0, b1):
                    bad.append(f"verticals {n} x={x0} and {m} x={a0} run {abs(x0-a0):.0f}px apart")
                if (not v1) and (not v2) and abs(y0 - b0) < min_lane and min(x0, x1) < max(a0, a1) and max(x0, x1) > min(a0, a1):
                    bad.append(f"horizontals {n} y={y0} and {m} y={b0} run {abs(y0-b0):.0f}px apart")
                if v1 != v2:
                    vx, vy0, vy1, hx0, hx1, hy_ = (x0, y0, y1, a0, a1, b0) if v1 else (a0, b0, b1, x0, x1, y0)
                    if min(hx0, hx1) + 0.5 < vx < max(hx0, hx1) - 0.5 and min(vy0, vy1) + 0.5 < hy_ < max(vy0, vy1) - 0.5:
                        crossings += 1
        return bad, crossings


def block(x, y, w, h, title, sub=None, cls="part", ty=24):
    o = [f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="9" class="{cls}"/>', T(x + w / 2, y + ty, title, "title", "middle")]
    if sub:
        o.append(T(x + w / 2, y + ty + 18, sub, "sub", "middle"))
    return "".join(o)


def pin(rt, x, y, name, side, net, fn=None, fnx=None):
    rt.pin(x, y, net)
    o = [f'<circle cx="{x}" cy="{y}" r="4.5" class="pinend"/>']
    if side == "R":
        o.append(T(x - 10, y + 5, name, "pin", "end"))
        if fn:
            o.append(T(fnx, y + 5, fn, "fn", "end"))
    elif side == "L":
        o.append(T(x + 10, y + 5, name, "pin", "start"))
        if fn:
            o.append(T(fnx, y + 5, fn, "fn", "start"))
    elif side == "B":
        o.append(T(x + 4, y - 10, name, "pin", "start", f'transform="rotate(-90 {x + 4} {y - 10})"'))
    elif side == "T":
        o.append(T(x + 4, y + 10, name, "pin", "end", f'transform="rotate(-90 {x + 4} {y + 10})"'))
    return "".join(o)


def zigzag_h(rt, x0, x1, y, net):
    mid = (x0 + x1) / 2
    z = 7
    pts = [(x0, y), (mid - 14, y)]
    for i, dy in enumerate((z, -z, z, -z, z, -z)):
        pts.append((mid - 14 + (i + 0.5) * (28 / 6), y + dy))
    pts += [(mid + 14, y), (x1, y)]
    return rt.wire(pts, "thin", net)


def dim_h(x0, x1, y, label, above=True, cls="dim", lcls="dimlab"):
    o = [f'<path d="M{x0:.1f},{y-6} L{x0:.1f},{y+6} M{x1:.1f},{y-6} L{x1:.1f},{y+6} M{x0:.1f},{y} L{x1:.1f},{y}" class="{cls}"/>']
    o.append(T((x0 + x1) / 2, y - 5 if above else y + 15, label, lcls, "middle"))
    return "".join(o)


def dim_v(x, y0, y1, label, right=True, cls="dim"):
    o = [f'<path d="M{x-6},{y0:.1f} L{x+6},{y0:.1f} M{x-6},{y1:.1f} L{x+6},{y1:.1f} M{x},{y0:.1f} L{x},{y1:.1f}" class="{cls}"/>']
    ym = (y0 + y1) / 2
    o.append(T(x + 8 if right else x - 8, ym + 4, label, "dimlab", "start" if right else "end"))
    return "".join(o)


def leader(x0, y0, x1, y1):
    return f'<path d="M{x0:.1f},{y0:.1f} L{x1:.1f},{y1:.1f}" class="dim"/>'


def rect(x0, y0, x1, y1, cls, rx=0):
    xa, xb, ya, yb = min(x0, x1), max(x0, x1), min(y0, y1), max(y0, y1)
    return f'<rect x="{xa:.1f}" y="{ya:.1f}" width="{xb - xa:.1f}" height="{yb - ya:.1f}" rx="{rx}" class="{cls}"/>'


def poly(pts, cls, close=False):
    return '<path d="M' + " L".join(f"{x:.1f},{y:.1f}" for x, y in pts) + ('Z' if close else '') + f'" class="{cls}"/>'


def circ(x, y, r, cls):
    return f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{r:.1f}" class="{cls}"/>'


def arc_path(cx, cy, r, a0, a1, cls):
    """An arc from angle a0 to a1 (degrees, SVG sense: 0 = +x, 90 = down), the long way when the sweep passes 180."""
    x0, y0 = cx + r * math.cos(math.radians(a0)), cy + r * math.sin(math.radians(a0))
    x1, y1 = cx + r * math.cos(math.radians(a1)), cy + r * math.sin(math.radians(a1))
    large = 1 if (a1 - a0) % 360 > 180 else 0
    return f'<path d="M{x0:.1f},{y0:.1f} A{r:.1f},{r:.1f} 0 {large} 1 {x1:.1f},{y1:.1f}" class="{cls}"/>'


# The lighthouse's own palette: brass, ivory, glass and warm white (both themes; greys in print).
