    "oled": AMZ + "B09T6SJBV5",            # Hosyond 0.96 in 128 x 64 OLED, I2C, white (10 owned, 7 spare)
    "hbridge": AMZ + "B075S368Y2",         # Aideepen MX1508 dual H-bridge, 5-pack (5 owned, 4 spare)
