            "--lh-glass:#F4F8FA;--lh-glass-lo:#7F8A94;--lh-warm:#F6DE9E;--lh-warm-lo:#B78A2E;--lh-black:#1E1F22;--lh-black-lo:#55585E;"
            "--lh-steel:#C3C8CD;--lh-steel-lo:#6B7178;--lh-board:#2B3340;--lh-mag:#8A8F96")
