    "supermini_notes": "https://sigmdel.ca/michel/ha/esp8266/super_mini_esp32c3_en.html",
    "server": "../../pocket_ai_assistant/character/server",
}

# ----------------------------------------------------------------------------- the numbers (mm unless said)
D = {
    # base
    "disc_d": 75.0, "disc_t": 8.0, "disc_g": 80.0,          # the brass coaster: the listing's 2.82 oz; a thin top over a hollow with a pad
    "hollow_d": 71.0, "hollow_h": 6.5, "ballast_g": 150.0,   # steel washers hot-glued into the hollow (estimate; measure the hollow first)
    # the cube: 1.5 in square brass tube, 0.062 in wall, cut as long as it is wide
    "cube": 38.1, "cube_wall": 1.57, "lid_t": 0.81, "lid_inset": 0.8, "stop": 6.0,
    "win_w": 23.0, "win_h": 12.4, "win_cz": 11.0,            # the window in the front face; its centre above the coaster top (check against the lit module)
    "oled_w": 27.3, "oled_h": 27.8, "oled_t": 4.0, "aa_w": 21.7, "aa_h": 10.9,
    "usb_w": 9.5, "usb_h": 3.6, "usb_cz": 6.0,               # the controller's own USB-C through the back face
    "btn_x": 11.0, "btn_cz": 24.0, "btn_hole": 3.6,
    "pin_d": 1.5, "pin_z": 17.0, "tube_bot": 12.0,           # the tower's foot inside the cube and the brass pin through it, above the coaster top
    "mx_l": 25.0, "mx_w": 20.0, "mx_t": 3.0,                 # MX1508 board, screw terminals and header removed
    "c3_l": 22.5, "c3_w": 18.0, "c3_t": 4.5,                 # SuperMini with its USB-C
    # the tower
    "tower_od": 25.0, "tower_wall": 0.5, "tower_show": 130.0,
    # the gallery deck: a turned brass check ring
    "deck_d": 38.1, "deck_t": 3.0, "deck_hole": 11.1,
    # the lantern
    "glass_od": 25.0, "glass_wall": 2.0, "cap_rim": 34.5,    # the cap's rim above the deck: what shows of the glass
    "cap_d": 38.1, "cap_h": 12.5, "cap_t": 0.6, "cap_hole": 10.5,
    "nut_d": 14.3, "nut_h": 4.8, "nip_od": 10.3, "nip_l": 12.7, "ball_d": 15.9, "ball_tap": 6.4,
    "fil_l": 26.0, "fil_w": 1.8, "hanger": 6.1,              # the filament hangs from the nut by its own leads
    # the shutter: a 5/8 in brass tube on the motor's shaft, open 120 degrees
    "drum_od": 15.88, "drum_wall": 0.36, "drum_h": 34.0, "drum_z0": 2.0, "floor_t": 0.81,
    "win_deg": 120.0, "dwin_z0": 3.0, "dwin_h": 28.0,
    "hub_od": 4.0, "hub_id": 3.0, "hub_h": 9.0, "shaft_d": 3.0, "shaft_l": 9.0,
    "mag_d": 3.0, "mag_t": 1.0, "mag_r": 6.0,
    "reed_d": 2.0, "reed_hole": 3.0, "reed_l": 14.0, "reed_r": 7.5, "reed_down": 2.5,
    "ast_od": 4.0, "ast_r": 14.5, "notch": 2.0,
    "mot_w": 12.0, "mot_t": 10.0, "mot_l": 24.0, "gear_l": 9.0,
}

# the vase cap's profile: a cubic from the rim to the flat top (the usual spun shape), r and z' (above the deck top)
CAP_P = ((D["cap_d"] / 2, D["cap_rim"]), (D["cap_d"] / 2, D["cap_rim"] + 7.8), (13.0, D["cap_rim"] + D["cap_h"]), (D["cap_hole"] / 2, D["cap_rim"] + D["cap_h"]))


def cap_pt(t):
    (x0, y0), (x1, y1), (x2, y2), (x3, y3) = CAP_P
    u = 1 - t
    return (u**3 * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t**3 * x3,
            u**3 * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t**3 * y3)


def cap_inner_pt(t):
    """The inside surface: the outer point moved one sheet thickness along the inward normal."""
    (x, z), (xa, za) = cap_pt(t), cap_pt(min(1.0, t + 1e-3))
    tx, tz = xa - x, za - z
    n = math.hypot(tx, tz) or 1.0
    nx, nz = tz / n, -tx / n          # the outward normal points away from the axis and up
    if nx < 0:
        nx, nz = -nx, -nz
    return (x - nx * D["cap_t"], z - nz * D["cap_t"])


def cap_z_at_r(r, inner=True):
    lo, hi = 0.0, 1.0
    for _ in range(60):
        mid = (lo + hi) / 2
        if cap_pt(mid)[0] > r:
            lo = mid
        else:
            hi = mid
    return (cap_inner_pt if inner else cap_pt)((lo + hi) / 2)[1]


# derived heights, above the desk
D["z_cube_top"] = D["disc_t"] + D["cube"]
D["z_deck0"] = D["z_cube_top"] + D["tower_show"]
D["z_deck1"] = D["z_deck0"] + D["deck_t"]                              # the lantern datum (z' = 0)
D["glass_h"] = round(cap_z_at_r(D["glass_od"] / 2 - D["glass_wall"] / 2), 1)   # the glass runs up inside the cap to its inner surface
D["ast_top"] = round(cap_z_at_r(D["ast_r"]), 1)
D["z_cap_rim"] = D["z_deck1"] + D["cap_rim"]
D["z_cap_top"] = D["z_cap_rim"] + D["cap_h"]
D["nut_bot"] = D["cap_rim"] + D["cap_h"] - D["cap_t"] - D["nut_h"]    # z'
D["fil_top"] = D["nut_bot"] - D["hanger"]
D["fil_bot"] = D["fil_top"] - D["fil_l"]
D["nip_top"] = D["nut_bot"] + D["nip_l"]
D["ball_bot"] = D["nip_top"] - D["ball_tap"]
D["ball_c"] = D["ball_bot"] + D["ball_d"] / 2
D["height"] = round(D["z_deck1"] + D["ball_bot"] + D["ball_d"], 1)
D["drum_top"] = D["drum_z0"] + D["drum_h"]
D["floor_top"] = D["drum_z0"] + D["floor_t"]
D["shaft_tip"] = D["shaft_l"] - D["deck_t"]
D["tube_len"] = round(D["z_cube_top"] - (D["disc_t"] + D["tube_bot"]) + D["tower_show"], 1)
D["cube_in"] = D["cube"] - 2 * D["cube_wall"]
D["lid"] = round(D["cube_in"] - 0.15, 1)
D["win_arc"] = round(math.pi * D["drum_od"] * D["win_deg"] / 360, 1)
D["drum_circ"] = round(math.pi * D["drum_od"], 1)
D["pass_deg"] = D["win_deg"]

# masses (g) and where they sit (mm above the desk)
rho_br, rho_ac = 8.5e-3, 1.18e-3
MASS = [
    ("brass coaster", D["disc_g"], D["disc_t"] / 2),
    ("cube, 1.5 in square tube", 4 * D["cube"] * D["cube_wall"] * D["cube"] * rho_br, D["disc_t"] + D["cube"] / 2),
    ("lid plate and four stops", D["lid"] ** 2 * D["lid_t"] * rho_br + 1.0, D["z_cube_top"] - 1),
    ("screen, controller, driver, pin, wires", 4.5 + 3 + 3 + 1 + 3, D["disc_t"] + 14),
    ("tower, 25 x 0.5 brass", math.pi * (D["tower_od"] - D["tower_wall"]) * D["tower_wall"] * D["tube_len"] * rho_br, (D["disc_t"] + D["tube_bot"] + D["z_deck0"]) / 2),
    ("motor", 10.0, D["z_deck0"] - D["mot_l"] / 2),
    ("gallery, turned check ring", math.pi * ((D["deck_d"] / 2) ** 2 - (D["deck_hole"] / 2) ** 2) * D["deck_t"] * rho_br, D["z_deck0"] + D["deck_t"] / 2),
    ("lantern glass", math.pi * ((D["glass_od"] / 2) ** 2 - (D["glass_od"] / 2 - D["glass_wall"]) ** 2) * D["glass_h"] * rho_ac, D["z_deck1"] + D["glass_h"] / 2),
    ("shutter drum, floor, hub, magnet", math.pi * (D["drum_od"] - D["drum_wall"]) * D["drum_wall"] * D["drum_h"] * rho_br + math.pi * (D["drum_od"] / 2) ** 2 * D["floor_t"] * rho_br + 0.6, D["z_deck1"] + D["drum_top"] / 2),
    ("filament, reed, astragal, wires", 2.5, D["z_deck1"] + 20),
    ("vase cap", 1600 * D["cap_t"] * rho_br, D["z_cap_rim"] + D["cap_h"] * 0.6),
    ("nut and nipple", 7.0, D["z_deck1"] + D["nut_bot"] + 6),
    ("brass ball", 4 / 3 * math.pi * (D["ball_d"] / 2) ** 3 * rho_br, D["z_deck1"] + D["ball_c"]),
]
D["mass"] = sum(m for _, m, _ in MASS)
D["cg"] = sum(m * z for _, m, z in MASS) / D["mass"]
D["tip_deg"] = math.degrees(math.atan2(D["disc_d"] / 2, D["cg"]))
D["push_n"] = D["mass"] / 1000 * 9.81 * (D["disc_d"] / 2) / D["height"]
mb = D["mass"] + D["ballast_g"]
D["cg_b"] = (D["cg"] * D["mass"] + D["ballast_g"] * D["disc_t"] / 2) / mb
D["tip_deg_b"] = math.degrees(math.atan2(D["disc_d"] / 2, D["cg_b"]))
D["push_n_b"] = mb / 1000 * 9.81 * (D["disc_d"] / 2) / D["height"]

# ----------------------------------------------------------------------------- the electrical budget (mA at 5 V unless said)
E = {
    "v_usb": 5.0, "fil_vf": 3.0, "fil_rated": 100.0, "r_each": 47.0, "n_par": 2,
    "mot_v": 6.0, "mot_rpm": 30.0, "mot_ma": 35.0, "mot_stall": 400.0,
    "rpm_target": 8.0, "c3_avg": 25.0, "c3_peak": 300.0, "oled": 12.0, "mx_q": 1.0, "lamp_duty": 0.7,
}
E["r_lamp"] = E["r_each"] / E["n_par"]
E["i_lamp_max"] = (E["v_usb"] - 0.05 - E["fil_vf"]) / E["r_lamp"] * 1000
E["i_lamp"] = E["i_lamp_max"] * E["lamp_duty"]
E["p_res_each"] = (E["i_lamp_max"] / 1000 / E["n_par"]) ** 2 * E["r_each"]
E["rpm_5v"] = E["mot_rpm"] * E["v_usb"] / E["mot_v"]
E["duty_mot"] = E["rpm_target"] / E["rpm_5v"]
E["period"] = 60 / E["rpm_target"]
E["pass_s"] = E["period"] * D["win_deg"] / 360
E["typ"] = E["c3_avg"] + E["oled"] + E["mx_q"] + E["mot_ma"] * E["duty_mot"] + E["i_lamp"]
E["peak"] = E["c3_peak"] + E["oled"] + E["mx_q"] + E["mot_ma"] + E["i_lamp_max"]
E["lamp_w"] = E["i_lamp_max"] / 1000 * E["fil_vf"]

# ----------------------------------------------------------------------------- the contract: ESP32-C3 SuperMini pins
PINS = [
    ("5V", "the 5 V rail: USB VBUS straight through the board (no diode on the SuperMini)", "driver VCC pad", "V5"),
    ("GND", "one ground", "driver GND · screen GND · reed leg 2 · button leg 2", "GND"),
    ("3V3", "3.3 V from the board's regulator", "screen VCC", "V3"),
    ("GPIO4", "I²C data", "screen SDA", "SDA"),
    ("GPIO5", "I²C clock", "screen SCL", "SCL"),
    ("GPIO0", "shutter motor, LEDC PWM at 20 kHz (silent)", "driver IN1", "IN1"),
    ("GPIO1", "shutter direction and brake", "driver IN2", "IN2"),
    ("GPIO3", "lamp, LEDC PWM at 5 kHz", "driver IN3", "IN3"),
    ("GPIO6", "index: the reed switch, internal pull-up, closes once a turn", "reed leg 1; leg 2 to GND", "REED"),
    ("GPIO10", "the button, active low, internal pull-up (the family's pin)", "button leg 1; leg 2 to GND", "BTN"),
    ("GPIO2, 8, 9", "strapping pins: left alone (GPIO8 is the blue LED, held high)", "nothing", ""),
    ("GPIO7, 20, 21", "free", "nothing", ""),
    ("USB-C", "5 V in from any USB adapter or a computer; flashing and the console", "the cable, through the slot in the cube's back", "USB"),
]

NETS = [
    ("V5", "controller 5V pin", "driver VCC (+) pad", "30 AWG, 30 mm",
     "The 5 V rail for the motor and the lamp. On the SuperMini the 5V pin is USB VBUS with no diode between, so it can source the half-amp this build peaks at (the [board notes](" + L["supermini_notes"] + ")). Nothing on this rail is wired to a GPIO."),
    ("GND", "controller GND pin", "driver GND pad · screen GND · reed leg 2 · button leg 2", "30 AWG",
     "One ground. The driver's own GND pad takes IN4 as well (next row). Everything else returns to the controller's GND pins; the brass is never part of a circuit."),
    ("IN4", "driver IN4 pad", "driver GND pad", "30 AWG, 10 mm",
     "Holds channel B's second input low, so OUT4 is a steady ground and OUT3 does the switching. A floating input on this chip is undefined."),
    ("V3", "controller 3V3 pin", "screen VCC", "30 AWG, 40 mm",
     "The screen is a 3.3 V part and takes about 12 mA with half its pixels lit. The board's regulator has 500 mA; nothing else is on it."),
    ("SDA", "GPIO4", "screen SDA", "30 AWG, 40 mm",
     "I²C data at 400 kHz, address 0x3C (the firmware probes 0x3D too). The module has its own pull-ups. GPIO4 and 5, not the board's default 8 and 9, which are strapping pins."),
    ("SCL", "GPIO5", "screen SCL", "30 AWG, 40 mm", "I²C clock. Read the module's silkscreen before soldering: Hosyond ships GND-VCC-SCL-SDA and VCC-GND-SCL-SDA on identical boards."),
    ("IN1", "GPIO0", "driver IN1", "30 AWG, 30 mm",
     f"The shutter's speed: PWM at 20 kHz, above hearing. About {E['duty_mot'] * 100:.0f} % duty gives {E['rpm_target']:.0f} rpm from a 30 rpm (6 V) gearmotor on 5 V; the firmware trims the duty from the reed's period so a revolution takes {E['period']:.1f} s whatever the motor's batch. The pin floats for a moment at boot and the drum may twitch once; harmless."),
    ("IN2", "GPIO1", "driver IN2", "30 AWG, 30 mm",
     "Direction and brake. Low while IN1 runs: forward. Both high: the bridge shorts the motor and the drum stops within a degree or two of where the reed said it was. The reverse direction is there for the parking move and nothing else."),
    ("IN3", "GPIO3", "driver IN3", "30 AWG, 30 mm",
     f"The lamp's brightness: PWM at 5 kHz into channel B. {E['lamp_duty'] * 100:.0f} % by default, 100 % on a long press, 0 when the shutter closes. The driver's channel B is a plain switch here; it never sees a motor."),
    ("MOT", "driver OUT1, OUT2", "motor terminals", "2 x 30 AWG, 190 mm, down the tower",
     f"The gearmotor, about {E['mot_ma']:.0f} mA turning, {E['mot_stall']:.0f} mA if the drum ever jams; the driver is good for 1.5 A a channel and has its own flyback diodes. The two wires run inside the tower with the lamp's and the reed's: six in all. Terminals in heat-shrink so no bare metal can touch the brass."),
    ("LAMP", "driver OUT3", f"two 47 Ω in parallel ({E['r_lamp']:.1f} Ω), then the filament's + lead", "30 AWG, 230 mm, down the tower and up the astragal",
     f"A 3 V, 100 mA filament from a 5 V rail: {E['r_lamp']:.1f} Ω drops the other two volts and sets {E['i_lamp_max']:.0f} mA flat out, inside the rating; each resistor dissipates {E['p_res_each'] * 1000:.0f} mW of its 250. PWM takes it to {E['i_lamp']:.0f} mA for everyday. The + lead is the one at the hole in the ceramic; the diode test lights it faintly."),
    ("LAMP−", "filament − lead", "driver OUT4", "30 AWG, 230 mm, the same path",
     "The lamp's return, into the half-bridge that IN4 holds low. Both lamp wires climb the astragal tube on the lantern's back, cross the cap's underside and are soldered to the filament's leads under the nut; heat-shrink on the joints, because the nut is brass."),
    ("REED", "GPIO6", "reed leg 1", "30 AWG, 180 mm, down the tower",
     f"The index. A 3 × 1 mm magnet under the drum's floor passes over the reed's end once a revolution and closes it for about {E['period'] * 12 / 360:.2f} s. The firmware times revolutions from it, parks the window on it, and reads a jammed drum from its silence. The glass is 2 mm thick and 14 long: it stands in a 3 mm hole in the deck, 2.5 mm down, beside the motor."),
    ("REED−", "reed leg 2", "controller GND pin", "30 AWG, 180 mm", "The reed's return. Its top lead is bent down along the glass in heat-shrink; both wires join the motor's inside the tower."),
    ("BTN", "GPIO10", "button leg 1", "30 AWG, 30 mm", "Short press: rotation on or off (off parks the window facing you). Long press: lamp off, low, full; off also closes the shutter. Internal pull-up; no resistor."),
    ("BTN−", "button leg 2", "controller GND pin", "30 AWG, 30 mm", "The button's return. The 6 mm tactile sits glued inside the cube's back face with its cap through a 3.6 mm hole."),
    ("USB", "any USB-C adapter or a computer", "controller USB-C, through the slot in the back", "the cable",
     f"Power and flashing on one port. Typical draw {E['typ']:.0f} mA; the worst moment ({E['c3_peak']:.0f} mA radio burst, lamp full, motor turning) {E['peak']:.0f} mA, inside a 500 mA port. No cell: a lamp lives on a desk."),
]

