+    // Do not let a saved cloud OTA URL override the selected LAN bridge.
+    return CONFIG_OTA_URL;
+#else
     Settings settings("wifi", false);
     std::string url = settings.GetString("ota_url");
     if (url.empty()) {
         url = CONFIG_OTA_URL;
     }
     return url;
+#endif
