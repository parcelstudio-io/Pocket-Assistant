index a1bb6e3..2dfaa80 100644
--- a/main/Kconfig.projbuild
+++ b/main/Kconfig.projbuild
@@ -6,6 +6,55 @@ config OTA_URL
     help
         The application will access this URL to check for new firmwares and server address.
 
+menu "Pocket AI prototype"
+    depends on BOARD_TYPE_POCKET_WALL_E_C3
+
+    config POCKET_AI_BENCH_DIAGNOSTICS
+        bool "Offline button, OLED, and microphone diagnostics"
+        default y
+        help
+            Boot a serial diagnostic loop instead of the assistant. Never
+            initializes Wi-Fi or cloud services. GPIO10 toggles OLED pixels;
+            microphone statistics are logged once per second. The amplifier
+            stays muted. Disable only when ready to test the assistant.
+
+    config POCKET_AI_ENABLE_QUALIFIED_AMPLIFIER
+        bool "Enable amplifier on a measured, qualified GPIO5/TXU fixture"
+        depends on !POCKET_AI_BENCH_DIAGNOSTICS
+        default n
+        help
+            Leave disabled for the beginner USB prototype. Enable only after
+            the documented interface and power sequence have passed physical
+            tests, with the two delays below set from measurements. Software
+            defaults do not qualify hardware. GPIO5 controls TXU channel A4;
+            power-good independently gates OE.
+
+    config POCKET_AI_AMP_STARTUP_DELAY_MS
+        int "Measured rail/PG startup delay (ms)"
+        range 1 10000
+        default 100
+        help
+            Placeholder, not a hardware guarantee. Zero-data I2S clocks run
+            for at least this time before GPIO5 may rise. Set this to cover
+            measured worst-case rail and PG release, including margin.
+
+    config POCKET_AI_AMP_TURN_ON_DELAY_MS
+        int "Measured amplifier turn-on delay (ms)"
+        range 1 1000
+        default 20
+        help
+            Placeholder, not a hardware guarantee. Keep I2S data zero after
+            GPIO5 rises for this interval before sending nonzero samples.
+
+    config POCKET_AI_MAX_VOLUME
+        int "Prototype software volume cap (0-30)"
+        range 0 30
+        default 15
+        help
+            Caps both saved and requested volume. This limits software gain;
+            it does not establish a safe sound pressure or power level.
+endmenu
+
